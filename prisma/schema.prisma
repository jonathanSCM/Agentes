// Proshop - Plataforma de venta de Agentes de IA por WhatsApp
// Esquema de base de datos (PostgreSQL via Prisma).
//
// Decisiones de diseno:
//  - Multi-cliente (multi-tenant): cada negocio que contrata es una "Empresa".
//  - El consumo se lleva como LIBRO CONTABLE (RegistroUso): cada consumo o compra
//    queda registrado como un evento. Da historial auditable ante reclamos.
//  - Una "conversacion" agrupa varios mensajes dentro de una ventana de tiempo,
//    para cobrar por conversacion y no por mensaje (regla del PDF comercial).
//  - Las conversaciones incluidas se reinician cada periodo; el saldo de paquetes
//    adicionales NO caduca (se consume solo tras agotar las incluidas).

// Generador clasico (CommonJS): compatible con el resto del proyecto,
// que usa require() en lugar de import.
generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Tabla de sesiones de express-session (connect-pg-simple la crea y maneja
// sola). Se declara aca solo para que Prisma no la vea como "drift" y trate
// de borrarla en cada migracion nueva; el codigo de la app nunca la toca
// directamente via Prisma Client.
model Session {
  sid    String   @id
  sess   Json
  expire DateTime

  @@map("session")
}

// ============================ CATALOGO COMERCIAL ============================

// Planes disponibles (Gratis, Standard, Pro, Premium BI)
model Plan {
  id               Int      @id @default(autoincrement())
  codigo           String   @unique // GRATIS | STANDARD | PRO | PREMIUM
  nombre           String
  mensualidadBs    Decimal  @db.Decimal(10, 2)
  implementacionBs Decimal  @db.Decimal(10, 2)
  primerPagoBs     Decimal  @db.Decimal(10, 2) // implementacion + primera mensualidad
  // Default en dolares para paises sin precio propio configurado en
  // PlanPrecioPais (ver ese modelo). Nullable a proposito: mientras no se
  // carguen, el sistema sigue mostrando el precio en Bs a todo el mundo
  // (comportamiento actual, sin cambios hasta que el negocio los active).
  mensualidadUsd    Decimal? @db.Decimal(10, 2)
  implementacionUsd Decimal? @db.Decimal(10, 2)
  primerPagoUsd     Decimal? @db.Decimal(10, 2)
  convIncluidas    Int // conversaciones incluidas por periodo
  maxProductos     Int
  maxUsuarios      Int
  modeloIa         String   @default("claude-haiku-4-5") // modelo de IA segun el plan
  marcaBlanca      Boolean  @default(false)
  recomendado      Boolean  @default(false)
  activo           Boolean  @default(true)
  orden            Int      @default(0)
  features         String[]
  // Grupo comercial para la pagina publica de comparacion (/planes/:categoria):
  // los planes se comparan SOLO contra otros de su mismo grupo, nunca cruzado.
  categoria        PlanCategoria @default(PERSONAL)
  createdAt        DateTime @default(now())

  suscripciones Suscripcion[]
  preciosPais   PlanPrecioPais[]
  caracteristicas PlanCaracteristica[]

  @@map("planes")
}

enum PlanCategoria {
  PERSONAL
  EMPRESARIAL
}

// Catalogo compartido de caracteristicas comparables entre planes (ej.
// "Marca blanca", "Reportes de ventas"). Cada fila de este catalogo es una
// FILA de la tabla comparativa publica; PlanCaracteristica dice, para cada
// plan, si esa fila aplica o no (el tilde/cruz de la tabla).
model Caracteristica {
  id     Int    @id @default(autoincrement())
  nombre String @unique
  orden  Int    @default(0)

  planes PlanCaracteristica[]

  @@map("caracteristicas")
}

model PlanCaracteristica {
  id               Int            @id @default(autoincrement())
  planId           Int
  plan             Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  caracteristicaId Int
  caracteristica   Caracteristica @relation(fields: [caracteristicaId], references: [id], onDelete: Cascade)
  incluida         Boolean        @default(true)

  @@unique([planId, caracteristicaId])
  @@map("plan_caracteristicas")
}

// Precio propio de un plan para un pais especifico (ej. Peru con soles),
// detectado por IP del visitante. Si un pais no tiene fila aca, se usa el
// default en dolares del Plan (mensualidadUsd etc.) y si tampoco hay default
// en dolares, se usa el precio base en bolivianos (ver lib/services/precios.js).
model PlanPrecioPais {
  id             Int      @id @default(autoincrement())
  planId         Int
  plan           Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  pais           String // codigo ISO 3166-1 alpha-2, ej "BO", "PE" (libre, cada negocio agrega el que necesite)
  moneda         String // codigo ISO 4217, ej "BOB", "PEN"
  mensualidad    Decimal  @db.Decimal(10, 2)
  implementacion Decimal  @db.Decimal(10, 2)
  primerPago     Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([planId, pais])
  @@map("plan_precios_pais")
}

// Paquetes de conversaciones adicionales (se compran al agotar el plan)
model Paquete {
  id               Int     @id @default(autoincrement())
  cantidad         Int // 1000, 2500, 3500, 5000, 8000, 10000, 15000
  precioUsd        Decimal @db.Decimal(10, 2)
  costoUnitarioUsd Decimal @db.Decimal(10, 4)
  activo           Boolean @default(true)

  pagos       Pago[]
  compras     CompraPaquete[]
  preciosPais PaquetePrecioPais[]

  @@map("paquetes")
}

// Precio propio de un paquete de conversaciones para un pais especifico. Si
// un pais no tiene fila aca, se usa el default en dolares (precioUsd /
// costoUnitarioUsd) — ese default ya existia, siempre fue en USD.
model PaquetePrecioPais {
  id            Int      @id @default(autoincrement())
  paqueteId     Int
  paquete       Paquete  @relation(fields: [paqueteId], references: [id], onDelete: Cascade)
  pais          String
  moneda        String
  precio        Decimal  @db.Decimal(10, 2)
  costoUnitario Decimal  @db.Decimal(10, 4)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([paqueteId, pais])
  @@map("paquete_precios_pais")
}

// Registro de cada paquete comprado por una empresa.
// Guarda su propio saldo (cantidad - consumidas) y cuando debe renovarse.
// El consumo del saldo extra se descuenta en orden de compra (el mas antiguo primero).
model CompraPaquete {
  id              Int          @id @default(autoincrement())
  empresaId       Int
  empresa         Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  paqueteId       Int? // null si es una cantidad personalizada fuera del catalogo
  paquete         Paquete?     @relation(fields: [paqueteId], references: [id])
  cantidad        Int // conversaciones compradas
  consumidas      Int          @default(0)
  precioUsd       Decimal      @db.Decimal(10, 2)
  fechaCompra     DateTime     @default(now())
  fechaRenovacion DateTime // cuando debe renovar / vence
  estado          EstadoCompra @default(ACTIVA)
  nota            String?

  pagos Pago[]

  @@index([empresaId, estado])
  @@map("compras_paquete")
}

enum EstadoCompra {
  PENDIENTE  // comprada mientras se confirma el pago: TODAVIA NO da saldo usable
  ACTIVA     // pago confirmado, con saldo disponible
  AGOTADA    // se consumio todo
  VENCIDA    // paso la fecha de renovacion
  RECHAZADA  // el pago no se pudo confirmar, nunca dio saldo
}

// ============================ EMPRESAS Y USUARIOS ============================

// Empresa cliente (tenant): cada negocio que contrata el agente
model Empresa {
  id        Int      @id @default(autoincrement())
  nombre    String
  slug      String   @unique
  marca     String? // nombre para marca blanca (plan Premium)
  // Moneda REAL en la que estan cargados los precios del catalogo de este
  // negocio. Existe porque la IA no puede decidir la moneda por su cuenta:
  // antes la ficha mostraba "370.00" pelado y el modelo elegia si escribir
  // "Bs" o "$" segun le pareciera (ver docs/02, regla de moneda del backend).
  moneda    String   @default("BOB")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios       Usuario[]
  invitaciones   Invitacion[]
  agentes        Agente[]
  productos      Producto[]
  categorias     Categoria[]
  clientes       ClienteFinal[]
  pedidos        Pedido[]
  pagos          Pago[]
  comprasPaquete CompraPaquete[]
  notificaciones Notificacion[]
  suscripcion    Suscripcion?

  @@map("empresas")
}

model Usuario {
  id           Int      @id @default(autoincrement())
  empresaId    Int?
  empresa      Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  nombre       String
  rol          Rol      @default(OWNER)
  createdAt    DateTime @default(now())

  conversacionesTomadas Conversacion[]
  mensajes              Mensaje[]

  @@index([empresaId])
  @@map("usuarios")
}

// Invitacion pendiente a un miembro del equipo. No crea el Usuario hasta que
// la persona invitada acepta y define su propia contraseña (asi no hay que
// inventarle una contraseña ni chocar con el email unico de Usuario antes de
// tiempo). No hay servicio de email configurado todavia: el dueño comparte
// el link de la invitacion el mismo (WhatsApp, etc).
model Invitacion {
  id        Int      @id @default(autoincrement())
  empresaId Int
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  email     String
  rol       Rol      @default(STAFF)
  token     String   @unique
  aceptada  Boolean  @default(false)
  expiraEn  DateTime
  createdAt DateTime @default(now())

  @@index([empresaId])
  @@map("invitaciones")
}

enum Rol {
  PROSHOP_ADMIN // administrador de Proshop (super admin)
  OWNER         // dueno de la empresa cliente
  ADMIN         // administrador de la empresa
  STAFF         // colaborador
}

// ============================ SUSCRIPCION Y CONSUMO ============================

model Suscripcion {
  id             Int                @id @default(autoincrement())
  empresaId      Int                @unique
  empresa        Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  planId         Int
  plan           Plan               @relation(fields: [planId], references: [id])
  estado         EstadoSuscripcion  @default(PRUEBA)
  // Periodo de facturacion vigente: las conversaciones incluidas se reinician aqui.
  periodoInicio  DateTime           @default(now())
  periodoFin     DateTime
  // Referencias de la pasarela de pago (se llenan al integrar Stripe / pasarela local)
  refClientePago String?
  refSuscripPago String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  registrosUso RegistroUso[]

  @@index([planId])
  @@index([estado])
  @@map("suscripciones")
}

enum EstadoSuscripcion {
  PRUEBA    // periodo de prueba
  ACTIVA    // al dia
  MOROSA    // periodo vencido sin pago confirmado: el agente deja de atender
            // (ver ESTADOS_CON_SERVICIO en suscripciones.js) hasta reactivar
  CANCELADA // sin acceso
}

// LIBRO CONTABLE del consumo. Cada fila es un evento, nunca se edita.
// Saldo incluido = plan.convIncluidas - (CONSUMIDA con origen INCLUIDA en el periodo)
// Saldo extra    = SUM(COMPRA_EXTRA) - COUNT(CONSUMIDA con origen EXTRA)  [historico]
model RegistroUso {
  id            Int          @id @default(autoincrement())
  suscripcionId Int
  suscripcion   Suscripcion  @relation(fields: [suscripcionId], references: [id], onDelete: Cascade)
  tipo          TipoUso
  origen        OrigenUso? // solo para CONSUMIDA: de donde se descontó
  cantidad      Int // positivo siempre
  nota          String?
  createdAt     DateTime     @default(now())

  @@index([suscripcionId, tipo])
  @@index([suscripcionId, createdAt])
  @@map("registros_uso")
}

enum TipoUso {
  CONSUMIDA    // se consumio una conversacion
  COMPRA_EXTRA // se compro un paquete adicional
}

enum OrigenUso {
  INCLUIDA // descontada del cupo del plan
  EXTRA    // descontada del saldo de paquetes comprados
}

// ============================ AGENTE (BOT) ============================

model Agente {
  id             Int          @id @default(autoincrement())
  empresaId      Int
  empresa        Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre         String
  numeroWhatsapp String? // numero que el cliente usara para su agente (ej: 59171234567)
  estado         EstadoAgente @default(BORRADOR)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  config         AgenteConfig?
  conexion       ConexionWhatsApp?
  conversaciones Conversacion[]

  @@index([empresaId])
  @@map("agentes")
}

enum EstadoAgente {
  BORRADOR
  ACTIVO
  PAUSADO
}

model AgenteConfig {
  id                Int      @id @default(autoincrement())
  agenteId          Int      @unique
  agente            Agente   @relation(fields: [agenteId], references: [id], onDelete: Cascade)
  // null = la tienda no personalizo su saludo, el bot arma su propia
  // presentacion (nombre, tienda, que vende) en vez de repetir un saludo
  // generico. NUNCA poner un default generico aca: se termina usando como si
  // el negocio lo hubiese elegido a proposito (ver construirSystem, bug real).
  mensajeBienvenida String?
  tono              String   @default("cordial y profesional")
  instrucciones     String? // instrucciones adicionales para la IA
  derivarAHumano    Boolean  @default(true)
  // Formas de pago que esta tienda realmente acepta - el bot NUNCA ofrece una
  // que no este habilitada aca (ver construirSystem). El QR es una imagen
  // estatica que el negocio ya usa hoy (no una pasarela de pago real): no hay
  // confirmacion automatica de cobro, eso lo verifica un humano por fuera.
  aceptaQr          Boolean  @default(false)
  qrCobroUrl        String?
  aceptaEfectivo    Boolean  @default(true)
  aceptaTarjeta     Boolean  @default(false)
  // Ubicacion REAL del local, para los pedidos con retiro en tienda. El bot
  // nunca inventa una direccion: si esto esta vacio, dice que no la tiene
  // cargada en vez de improvisar una (ver crear_pedido).
  direccionTienda   String?
  tiendaLat         Float?
  tiendaLng         Float?
  // Datos que el bot pregunta ANTES de mostrar nada, ni siquiera el menu de
  // rubros: son filtros que aplican a TODO el catalogo (el caso tipico es el
  // genero en una tienda de ropa). Se preguntan de a uno y en este orden.
  // Vacio = el bot arranca mostrando el menu, como antes.
  // A diferencia de CategoriaAtributo, esto no depende de la categoria:
  // justamente se pregunta cuando todavia no hay ninguna elegida.
  preguntasIniciales String[] @default(["Genero"])
  // Personalizacion visual del catalogo web publico (/catalogo/:slug): sin
  // esto, todas las tiendas comparten el mismo tema oscuro fijo, que no
  // representa la marca de cada negocio. Vacio = se usan los colores por
  // defecto y se muestra el nombre de la tienda como texto en vez de logo.
  logoUrl           String?
  colorPrimario     String?
  colorSecundario   String?
  updatedAt         DateTime @updatedAt

  @@map("agente_config")
}

// Credenciales de WhatsApp. El token se guarda CIFRADO, nunca en texto plano.
model ConexionWhatsApp {
  id              Int       @id @default(autoincrement())
  agenteId        Int       @unique
  agente          Agente    @relation(fields: [agenteId], references: [id], onDelete: Cascade)
  estado          String    @default("EN_PROCESO") // EN_PROCESO | CONECTADO
  numeroVisible   String? // el numero que el cliente pidio conectar
  phoneNumberId   String?   @unique // lo llena Proshop al conectar
  wabaId          String? // WhatsApp Business Account ID (opcional)
  tokenCifrado    String? // token de acceso, cifrado con APP_ENCRYPTION_KEY
  ultimoMensajeAt DateTime? // ultimo mensaje recibido
  verificado      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt @default(now())

  @@map("conexiones_whatsapp")
}

// ============================ CONVERSACIONES ============================

// Una conversacion agrupa los mensajes de un mismo cliente dentro de una
// ventana de tiempo. Se cobra 1 conversacion, no 1 por mensaje.
model Conversacion {
  id              Int      @id @default(autoincrement())
  agenteId        Int
  agente          Agente   @relation(fields: [agenteId], references: [id], onDelete: Cascade)
  telefonoCliente String
  origen          OrigenUso @default(INCLUIDA) // de donde se cobro
  // Mientras un humano tiene el control, el agente de IA NO responde este
  // chat (se libera solo manualmente, ver /panel/conversaciones/:id/control).
  modo            ModoConversacion @default(IA)
  tomadaPorId     Int?
  tomadaPor       Usuario?  @relation(fields: [tomadaPorId], references: [id], onDelete: SetNull)
  ultimoMensajeAt DateTime  @default(now())
  createdAt       DateTime  @default(now())

  // Atribucion a anuncios de Meta (Click to WhatsApp): WhatsApp manda estos
  // datos solos, sin conectar nada, en el primer mensaje de una conversacion
  // que arranco desde un anuncio (objeto "referral" del webhook). Quedan en
  // null si el cliente escribio por su cuenta.
  anuncioId        String?
  anuncioTitulo    String?
  anuncioImagenUrl String?

  mensajes Mensaje[]
  pedidos  Pedido[]

  @@index([agenteId, telefonoCliente, ultimoMensajeAt])
  @@map("conversaciones")
}

enum ModoConversacion {
  IA
  HUMANO
}

model Mensaje {
  id             Int          @id @default(autoincrement())
  conversacionId Int
  conversacion   Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  rol            RolMensaje
  contenido      String
  // Cuando un miembro del equipo escribe manualmente (modo HUMANO), para
  // saber quien mando que en el historial.
  usuarioId      Int?
  usuario        Usuario?     @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  // Adjunto opcional (foto o audio) mandado por el cliente o por un humano
  // del equipo. mediaTipo: "imagen" | "audio".
  mediaUrl       String?
  mediaTipo      String?
  createdAt      DateTime     @default(now())

  @@index([conversacionId, createdAt])
  @@map("mensajes")
}

enum RolMensaje {
  CLIENTE
  AGENTE
  SISTEMA
}

// ============================ OPERACION / CATALOGO ============================

model Producto {
  id              Int        @id @default(autoincrement())
  empresaId       Int
  empresa         Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre          String
  // Codigo interno del negocio para este producto. Las variantes tienen el
  // suyo propio (Variante.sku); este es el del producto padre.
  sku             String?
  categoriaId     Int?
  categoria       Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  descripcion     String?
  precio          Decimal  @db.Decimal(10, 2)
  stock           Int      @default(0)
  activo          Boolean  @default(true)
  fotos           String[] @default([])
  caracteristicas String[] @default([])
  // Atributos libres clave:valor (ej. {"Marca":"Nike","Material":"Algodon"}
  // o {"Marca":"LG","Voltaje":"220V","Capacidad":"15kg"}). Igual criterio que
  // Variante.atributos: cada negocio define lo que le sirve a su rubro.
  atributos       Json     @default("{}")
  createdAt       DateTime @default(now())

  pedidoItems PedidoItem[]
  variantes   Variante[]

  @@index([empresaId])
  @@index([categoriaId])
  @@map("productos")
}

// Categoria real de un negocio (ej: "Zapatillas deportivas"), con una lista
// configurable de atributos donde cada uno se marca obligatorio u opcional.
// El formulario de productos valida los obligatorios de nivel producto al
// guardar, y el bot usa esto para saber que preguntarle al cliente antes de
// recomendar (ver CategoriaAtributo mas abajo).
// Dos niveles: un RUBRO (padreId null, ej "Calzado") agrupa SUBCATEGORIAS
// (ej "Zapatillas urbanas"). Los productos siempre cuelgan de la hoja: si un
// rubro tiene hijas, sus productos viven en las hijas; si no tiene, los tiene
// el mismo. Mas de dos niveles no aporta y complica el menu de WhatsApp.
model Categoria {
  id        Int                 @id @default(autoincrement())
  empresaId Int
  empresa   Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre    String
  // null = es un rubro de primer nivel (lo que el bot lista cuando le piden
  // "el catalogo"). Con valor = es una subcategoria de ese rubro.
  padreId   Int?
  padre     Categoria?          @relation("SubcategoriasDeCategoria", fields: [padreId], references: [id], onDelete: Cascade)
  hijas     Categoria[]         @relation("SubcategoriasDeCategoria")
  atributos CategoriaAtributo[]
  productos Producto[]
  orden     Int                 @default(0)
  createdAt DateTime            @default(now())

  @@unique([empresaId, nombre])
  @@index([empresaId, padreId])
  @@map("categorias")
}

model CategoriaAtributo {
  id          Int       @id @default(autoincrement())
  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  nombre      String // "Genero", "Talla", "Color", "Uso"...
  // Tres niveles, no un booleano: OBLIGATORIO bloquea de verdad (el bot no
  // muestra productos hasta saberlo), RECOMENDADO se pregunta pero no
  // bloquea, OPCIONAL ni se pregunta. Reemplazo del viejo campo
  // "obligatorio" (boolean), que no distinguia el caso del medio.
  nivel        NivelAtributo @default(OPCIONAL)
  // true = vive en Variante.atributos (ej: talla/color) - solo se usa como
  // guia (datalist, que preguntar), no bloquea guardar el producto. false =
  // vive en Producto.atributos - ese si se valida obligatorio al guardar.
  esDeVariante Boolean  @default(false)
  orden       Int       @default(0)

  @@unique([categoriaId, nombre])
  @@map("categoria_atributos")
}

enum NivelAtributo {
  OBLIGATORIO // el bot NO muestra productos hasta conocerlo
  RECOMENDADO // el bot lo pregunta si puede, pero no bloquea la busqueda
  OPCIONAL    // solo sirve para filtrar si el cliente lo menciona solo
}

// Una combinacion vendible de un producto (ej: talla 42 + color negro), con
// SU PROPIO stock y, opcionalmente, su propio precio. Si un producto no
// necesita variantes (la mayoria de los casos simples), simplemente no
// tiene ninguna fila aca y se sigue usando Producto.precio/stock como hoy.
model Variante {
  id         Int      @id @default(autoincrement())
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  // Ej: {"Talla": "42", "Color": "Negro"}. Libre a proposito: cada negocio
  // define sus propios atributos (talla, color, modelo, sabor, etc.).
  atributos  Json
  sku        String?
  // null = usa el precio del producto padre. Se sobreescribe solo si esa
  // combinacion puntual cuesta distinto.
  precio     Decimal? @db.Decimal(10, 2)
  stock      Int      @default(0)
  activa     Boolean  @default(true)
  createdAt  DateTime @default(now())
  // Fotos propias de esta variante (ej: la foto del color especifico). Si
  // esta vacio, se usa Producto.fotos (comportamiento de siempre). Variantes
  // que comparten color pero difieren en talla suelen compartir las mismas
  // URLs aca (ver /panel/productos/:id/variantes, carga por rango de tallas).
  fotos      String[] @default([])

  pedidoItems PedidoItem[]

  @@index([productoId])
  @@map("variantes")
}

model ClienteFinal {
  id        Int      @id @default(autoincrement())
  empresaId Int
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre    String?
  telefono  String
  createdAt DateTime @default(now())

  // Estado de la conversacion de ventas (equivalente al "lead" del bot):
  // se actualiza por codigo (extraccion determinista) y via la tool
  // actualizar_datos_lead del agente. Se reinicia solo si el cliente cambia
  // de opinion, nunca automaticamente.
  categoriaInteres String?
  // Categoria real (de esta empresa) a la que se resolvio categoriaInteres,
  // para saber sus atributos obligatorios (ver Categoria/CategoriaAtributo).
  // categoriaInteres se mantiene como el texto literal que dijo el cliente.
  categoriaId      Int?
  // Texto literal que dijo el cliente ("hasta 500 bs", "unos 300").
  presupuesto      String?
  // El mismo presupuesto ya interpretado a numero por el backend. El texto
  // solo sirve para repetirselo al cliente; el filtrado real usa estos dos,
  // asi la busqueda no depende de reparsear un string en cada consulta.
  presupuestoMin   Decimal? @db.Decimal(10, 2)
  presupuestoMax   Decimal? @db.Decimal(10, 2)
  cantidad         String?
  direccionEntrega String?
  // Domicilio o retiro en tienda. Sin esto no se puede crear el pedido: son
  // dos flujos distintos (uno necesita direccion del cliente, el otro manda
  // la ubicacion real del local).
  tipoEntrega      TipoEntrega?
  // Coordenadas reales cuando el cliente comparte su ubicacion de WhatsApp
  // (mucho mas confiable que una direccion escrita a mano para coordinar
  // la entrega). direccionEntrega igual queda con un texto legible/link.
  ubicacionLat     Float?
  ubicacionLng     Float?
  observaciones    String?
  // Preferencias puntuales de producto que el cliente fue mencionando.
  marca            String?
  talla            String?
  color            String?
  // Como va a pagar, elegida entre las formas de pago que esa tienda tiene
  // habilitadas (ver AgenteConfig.aceptaQr/aceptaEfectivo/aceptaTarjeta).
  // crear_pedido no deja crear el pedido sin esto (mismo criterio que
  // direccionEntrega).
  formaPago        FormaPago?
  nivelInteres     NivelInteres @default(FRIO)
  estadoLead       EstadoLead   @default(NUEVO)
  // Estado de la conversacion de venta (donde esta el cliente en el proceso
  // de decision). Lo actualiza la IA via actualizar_datos_lead; el codigo lo
  // usa para cambiar el comportamiento del prompt (ej: si ya eligio un
  // producto favorito, dejar de ofrecerle mas opciones y enfocarse en cerrar).
  estadoConversacion EstadoConversacion @default(EXPLORANDO)
  // IDs de productos ya mostrados (para no repetirlos) y descartados
  // explicitamente por el cliente (para no volver a sugerirlos), y el
  // producto que el cliente eligio como favorito (el motor deja de buscar
  // alternativas y se enfoca en cerrar la venta de ese producto).
  productosMostrados    Int[] @default([])
  productosDescartados  Int[] @default([])
  productoFavoritoId    Int?
  // La combinacion exacta (talla+color) que eligio, no solo el producto: el
  // pedido siempre termina apuntando a una variante real.
  varianteFavoritaId    Int?
  // Datos efimeros del bot (ej. que productos ya se les envio foto, para
  // no repetir el envio). Libre para que cualquier bot vertical lo use.
  contexto         Json         @default("{}")
  // Valores de atributos definidos por la categoria (ver CategoriaAtributo)
  // que no son ya un campo propio de este modelo (ej: {"Genero":"Hombre",
  // "Uso":"Running"}). Talla/color/marca siguen usando sus campos de siempre.
  atributosLead    Json         @default("{}")
  updatedAt        DateTime     @updatedAt

  pedidos Pedido[]

  @@unique([empresaId, telefono])
  @@map("clientes_finales")
}

enum FormaPago {
  QR
  EFECTIVO
  TARJETA
}

enum TipoEntrega {
  DOMICILIO
  RECOJO
}

enum NivelInteres {
  FRIO
  TIBIO
  CALIENTE
}

enum EstadoLead {
  NUEVO
  EN_CONVERSACION
  CALIFICADO
  PEDIDO_CREADO
  DERIVADO_A_ASESOR
  CERRADO
  NO_INTERESADO
}

// Estado de la conversacion de venta, mas granular que EstadoLead: refleja
// en que punto del proceso de decision de compra esta el cliente, para que
// el prompt cambie de comportamiento (ej: dejar de mostrar mas opciones
// cuando ya esta LISTO_PARA_COMPRAR).
enum EstadoConversacion {
  EXPLORANDO
  BUSCANDO_PRODUCTO
  COMPARANDO
  INTERESADO
  INTENCION_DE_COMPRA
  LISTO_PARA_COMPRAR
  // Etapas del cierre: ya decidio que compra y falta completar el pedido.
  DATOS_DE_PEDIDO
  ENTREGA
  PEDIDO_COMPLETADO
}

model Pedido {
  id               Int           @id @default(autoincrement())
  empresaId        Int
  empresa          Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  clienteId        Int?
  cliente          ClienteFinal? @relation(fields: [clienteId], references: [id])
  // De que conversacion salio este pedido (para saber si vino de un anuncio
  // de Meta, ver Conversacion.anuncioId). Null en pedidos viejos o creados
  // sin conversacion asociada.
  conversacionId   Int?
  conversacion     Conversacion? @relation(fields: [conversacionId], references: [id], onDelete: SetNull)
  total            Decimal       @default(0) @db.Decimal(10, 2)
  // Copiada de ClienteFinal al crear el pedido, igual que formaPago. En un
  // pedido con RECOJO la direccion queda vacia a proposito (retira el
  // cliente en el local).
  tipoEntrega      TipoEntrega?
  direccionEntrega String?
  entregaLat       Float?
  entregaLng       Float?
  notas            String?
  // Copiado de ClienteFinal.formaPago al momento de crear el pedido. Solo
  // registra que eligio el cliente - el cobro en si lo verifica un humano
  // por fuera del bot (ver /panel/pedidos/:id/estado).
  formaPago        FormaPago?
  estado           EstadoPedido  @default(NUEVO)
  createdAt        DateTime      @default(now())

  items PedidoItem[]

  @@index([empresaId, estado])
  @@map("pedidos")
}

// Linea de un pedido. Guarda nombre y precio al momento de la compra
// (denormalizado) para que el historial no cambie si el producto se edita
// o se borra despues.
model PedidoItem {
  id         Int       @id @default(autoincrement())
  pedidoId   Int
  pedido     Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoId Int?
  producto   Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)
  // Si el producto tenia variantes, cual combinacion exacta se vendio.
  varianteId Int?
  variante   Variante? @relation(fields: [varianteId], references: [id], onDelete: SetNull)
  nombre     String
  precio     Decimal   @db.Decimal(10, 2)
  cantidad   Int       @default(1)

  @@index([pedidoId])
  @@map("pedido_items")
}

enum EstadoPedido {
  NUEVO
  CONFIRMADO
  ENTREGADO
  CANCELADO
}

// ============================ PAGOS ============================

model Pago {
  id         Int        @id @default(autoincrement())
  empresaId  Int
  empresa    Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo       TipoPago
  monto      Decimal    @db.Decimal(10, 2)
  moneda     String     @default("BOB") // BOB (bolivianos) | USD
  estado     EstadoPago @default(PENDIENTE)
  referencia String? // id de la pasarela / comprobante
  paqueteId  Int?
  paquete    Paquete?       @relation(fields: [paqueteId], references: [id])
  // Vinculo exacto con la compra que este pago paga (solo tipo PAQUETE): al
  // confirmar/rechazar este pago, se activa/rechaza ESA compra puntual, sin
  // adivinar cual por fecha o cantidad.
  compraPaqueteId Int?
  compraPaquete   CompraPaquete? @relation(fields: [compraPaqueteId], references: [id])
  fecha      DateTime   @default(now())

  @@index([empresaId, estado])
  @@map("pagos")
}

enum TipoPago {
  PRIMER_PAGO // implementacion + primera mensualidad
  MENSUALIDAD
  PAQUETE     // conversaciones adicionales
}

enum EstadoPago {
  PENDIENTE
  CONFIRMADO
  FALLIDO
}

// ============================ NOTIFICACIONES ============================

// Avisos que aparecen en la campanita del panel del cliente.
model Notificacion {
  id         Int      @id @default(autoincrement())
  empresaId  Int
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  titulo     String
  mensaje    String
  tipo       String   @default("MANUAL") // MANUAL | PLAN_POR_ACABAR | SIN_SALDO
  conBotones Boolean  @default(false) // muestra "Comprar paquete" y "Mejorar plan"
  leida      Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([empresaId, leida])
  @@map("notificaciones")
}
