# Copia este archivo a ".env" y ajusta los valores.
PORT=3000

# Numero de WhatsApp en formato internacional SIN el signo "+"
# Ej: Peru 51 + numero => 51999888777
WHATSAPP_NUMBER=51999888777

CONTACT_EMAIL=contacto@proshop.com
CONTACT_PHONE=+51 999 888 777
CONTACT_LOCATION=Lima, Peru

# ----- Panel de administracion (/admin) -----
# CAMBIA estas credenciales por unas propias antes de publicar el sitio.
ADMIN_USER=admin
ADMIN_PASSWORD=proshop123
# Secreto para firmar la sesion (usa una cadena larga y aleatoria)
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-secreta

# ----- Agente de IA -----
# El agente usa el proveedor segun la clave que pongas (elige UNA):
#
#   OpenAI (recomendado por precio) -> https://platform.openai.com/api-keys
OPENAI_API_KEY=
#   Modelo de OpenAI (por defecto gpt-4o-mini, el mas barato)
OPENAI_MODEL=gpt-4o-mini
#
#   Anthropic / Claude (alternativa) -> https://console.anthropic.com
ANTHROPIC_API_KEY=
#
# Si NO pones ninguna, el agente funciona en "modo demostracion" (reglas simples).

# ----- WhatsApp (Meta) -----
# Token de verificacion del webhook: lo eliges tu y lo pegas en Meta.
WHATSAPP_VERIFY_TOKEN=proshop-verify-token
# Clave para cifrar los tokens de WhatsApp de los clientes en la base de datos.
# Usa una cadena larga y aleatoria. Si la cambias, los tokens ya guardados dejan de leerse.
APP_ENCRYPTION_KEY=cambia-esto-por-una-cadena-larga-y-secreta

# Ventana (horas) para agrupar mensajes en una misma conversacion cobrable.
CONVERSATION_WINDOW_HOURS=24
