# Copia este archivo a ".env" y ajusta los valores.
PORT=3000

# Numero de WhatsApp en formato internacional SIN el signo "+"
# Ej: Peru 51 + numero => 51999888777
WHATSAPP_NUMBER=51999888777

CONTACT_EMAIL=contacto@proshop.com
CONTACT_PHONE=+51 999 888 777
CONTACT_LOCATION=Lima, Peru

# ----- Panel de administracion (/admin) -----
# CAMBIA estas credenciales por unas propias antes de publicar el sitio.
ADMIN_USER=admin
ADMIN_PASSWORD=proshop123
# Secreto para firmar la sesion (usa una cadena larga y aleatoria)
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-secreta

# ----- Agente de IA -----
# El agente usa el proveedor segun la clave que pongas (elige UNA):
#
#   OpenAI (recomendado por precio) -> https://platform.openai.com/api-keys
OPENAI_API_KEY=
#   Modelo de OpenAI (por defecto gpt-4o-mini, el mas barato)
OPENAI_MODEL=gpt-4o-mini
#
#   Anthropic / Claude (alternativa) -> https://console.anthropic.com
ANTHROPIC_API_KEY=
#
# Si NO pones ninguna, el agente funciona en "modo demostracion" (reglas simples).

# ----- WhatsApp (Meta) -----
# Token de verificacion del webhook: lo eliges tu y lo pegas en Meta.
WHATSAPP_VERIFY_TOKEN=proshop-verify-token
# Clave para cifrar los tokens de WhatsApp de los clientes en la base de datos.
# OBLIGATORIA en produccion (sin ella el servidor no arranca, a proposito).
# Generar una asi:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# NO se cambia a mano una vez que hay tokens guardados: no es una contraseña que
# se verifica, es la llave con la que se cifro el dato. Cambiarla sin mas deja
# ilegibles los tokens existentes y desconecta a todos los agentes. Para
# cambiarla hay que re-cifrar primero:  node scripts/rotar-clave-cifrado.js
APP_ENCRYPTION_KEY=cambia-esto-por-una-cadena-larga-y-secreta

# URL publica del servidor (sin barra al final). El agente la usa para armar
# el link del catalogo web (/catalogo/:slug) que manda por WhatsApp.
APP_BASE_URL=http://localhost:3000

# Ventana (horas) para agrupar mensajes en una misma conversacion cobrable.
CONVERSATION_WINDOW_HOURS=6

# --- Conexion de WhatsApp por COEXISTENCE (Embedded Signup de Meta). Ver docs/12-coexistence.md ---
# App de Meta de Proshop (developers.facebook.com): su ID y su secreto, y el ID de la configuracion de Embedded Signup.
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=

# --- Solo texto y costos de IA ---
# Audios, fotos, videos y documentos entrantes NO se procesan (el agente pide que escriban). Poner 1 para reactivarlos.
MEDIA_ENTRANTE_ACTIVA=0
# El tipo de cambio (BCB, con respaldo de una API gratuita) se actualiza solo cada 6 horas; 0 lo desactiva.
TIPO_CAMBIO_JOB=1

# Creditos (reemplazan a las conversaciones). APAGADO (por defecto) | SOMBRA (anota sin cobrar) | ACTIVO (fuente de verdad).
# Antes de ACTIVO: correr `npm run creditos:convertir` (simula) y despues con --aplicar. Ver docs/03 punto 74.
CREDITOS_MODO=APAGADO
