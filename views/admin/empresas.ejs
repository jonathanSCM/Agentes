<%- include('partials/inicio') %>

<div class="page-head">
  <h2>Empresas cliente</h2>
  <p>Negocios que contrataron un agente de IA, con su plan y consumo.</p>
</div>

<% if (empresas.length === 0) { %>
  <div class="empty-state">
    <h3>Aún no hay empresas cliente</h3>
    <p>Cuando un negocio contrate un plan aparecerá aquí con su consumo de conversaciones.</p>
  </div>
<% } else { %>
  <div class="table-wrap">
    <table class="leads-table">
      <thead>
        <tr><th>Empresa</th><th>Plan</th><th>Estado</th><th>Consumo del periodo</th><th class="num">Saldo extra</th><th>Alta</th></tr>
      </thead>
      <tbody>
        <% empresas.forEach(function (e) { %>
          <tr>
            <td><strong><%= e.nombre %></strong><br /><span class="muted"><%= e.slug %></span></td>
            <td><%= e.suscripcion ? e.suscripcion.plan.nombre : '—' %></td>
            <td>
              <% if (e.suscripcion) { %>
                <span class="badge <%= e.suscripcion.estado === 'ACTIVA' ? 'badge-new' : 'badge-off' %>"><%= e.suscripcion.estado %></span>
              <% } else { %><span class="muted">Sin suscripción</span><% } %>
            </td>
            <td>
              <% if (e.consumo) { %>
                <%= e.consumo.incluidasUsadas %> / <%= e.consumo.incluidasTotal %>
                <span class="muted">(<%= e.consumo.porcentajeUsado %>%)</span>
              <% } else { %>—<% } %>
            </td>
            <td class="num"><%= e.consumo ? e.consumo.extraDisponible.toLocaleString('es-BO') : '—' %></td>
            <td class="nowrap muted"><%= new Date(e.createdAt).toLocaleDateString('es-BO') %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('partials/fin') %>
