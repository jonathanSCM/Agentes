<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../../partials/head') %>
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin">
<div class="admin-shell">

  <!-- ===== Menu lateral ===== -->
  <aside class="sidebar" id="sidebar">
    <a href="/admin" class="sidebar-brand">
      <img src="/img/logo-icon.png" alt="" class="brand-mark-icon" width="30" height="30" />
      <span class="sidebar-brand-text">Proshop <span class="admin-tag">Admin</span></span>
    </a>

    <nav class="sidebar-nav" aria-label="Menu de administracion">
      <span class="sidebar-section">General</span>
      <a href="/admin" class="<%= activo === 'resumen' ? 'is-active' : '' %>">
        <span class="si"><svg viewBox="0 0 24 24"><path d="M4 19h16M6 16V9m6 7V5m6 11v-4"/></svg></span> Resumen
      </a>
      <a href="/admin/mensajes" class="<%= activo === 'mensajes' ? 'is-active' : '' %>">
        <span class="si"><svg viewBox="0 0 24 24"><path d="M4 4h16v11H8l-4 4V4Z"/></svg></span> Mensajes
        <% if (typeof badgeMensajes !== 'undefined' && badgeMensajes > 0) { %>
          <span class="nav-badge"><%= badgeMensajes %></span>
        <% } %>
      </a>

      <span class="sidebar-section">Clientes</span>
      <a href="/admin/registrados" class="<%= activo === 'registrados' ? 'is-active' : '' %>">
        <span class="si"><svg viewBox="0 0 24 24"><path d="M4 21V6l6-3 6 3v15M4 21h16M10 21v-5h4v5"/></svg></span> Registrados
      </a>
      <a href="/admin/usuarios" class="<%= activo === 'usuarios' ? 'is-active' : '' %>">
        <span class="si"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2"/><path d="M2.5 19c.6-3.4 3.2-5.5 6.5-5.5s5.9 2.1 6.5 5.5"/><circle cx="17.5" cy="9" r="2.4"/><path d="M16 13.7c2.5.3 4.3 2.1 4.8 4.8"/></svg></span> Usuarios y planes
      </a>
      <a href="/admin/seguimiento" class="<%= activo === 'seguimiento' ? 'is-active' : '' %>">
        <span class="si"><svg viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-3.5-7.1M21 4v5h-5"/></svg></span> Seguimiento mensajes
      </a>
      <a href="/admin/activos" class="<%= activo === 'activos' ? 'is-active' : '' %>">
        <span class="si"><svg viewBox="0 0 24 24"><path d="M4 12.5 9 17l11-11"/></svg></span> Activos
      </a>
      <a href="/admin/agentes" class="<%= activo === 'agentes' ? 'is-active' : '' %>">
        <span class="si"><svg viewBox="0 0 24 24"><rect x="4" y="7" width="16" height="12" rx="3"/><path d="M12 7V3M9 12h.01M15 12h.01"/></svg></span> Agentes
      </a>
      <a href="/admin/conexiones" class="<%= activo === 'conexiones' ? 'is-active' : '' %>">
        <span class="si"><svg viewBox="0 0 24 24"><path d="M6.3 17.7 3 21l3.4-1a8.9 8.9 0 1 0-3.3-3.4Z"/><path d="M8.5 8.7c.2-.5.5-.5.8-.5h.6c.2 0 .4 0 .6.4.2.5.7 1.7.7 1.8.1.2.1.3 0 .5-.4.6-.9.9-.6 1.4.7 1.2 1.4 1.7 2.5 2.2.2.1.3.1.5-.1.2-.2.7-.8.9-1.1.2-.2.3-.2.6-.1.2.1 1.5.7 1.8.9.2.1.3.1.4.3 0 .2 0 1-.4 1.5-.4.5-1.3.9-2 .9-.6 0-2-.2-3.8-1.6-1.8-1.5-2.9-3.4-3-3.6-.2-.2-.9-1.2-.9-2.3 0-1.1.5-1.6.7-1.8Z"/></svg></span> Conexiones WhatsApp
      </a>

      <span class="sidebar-section">Comercial</span>
      <a href="/admin/compras" class="<%= activo === 'compras' ? 'is-active' : '' %>">
        <span class="si"><svg viewBox="0 0 24 24"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3Z"/><path d="M9 8h6M9 12h6"/></svg></span> Registro de paquetes
      </a>
      <a href="/admin/planes" class="<%= activo === 'planes' ? 'is-active' : '' %>">
        <span class="si"><svg viewBox="0 0 24 24"><path d="M3 8 12 4l9 4-9 4-9-4Z"/><path d="M3 8v8l9 4 9-4V8M12 12v8"/></svg></span> Planes
      </a>
      <a href="/admin/paquetes" class="<%= activo === 'paquetes' ? 'is-active' : '' %>">
        <span class="si"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></span> Paquetes
      </a>
      <a href="/admin/pagos" class="<%= activo === 'pagos' ? 'is-active' : '' %>">
        <span class="si"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M6 15h4"/></svg></span> Pagos
      </a>
    </nav>

    <div class="sidebar-foot">
      <a href="/" target="_blank" rel="noopener">Ver sitio ↗</a>
      <form method="POST" action="/admin/logout"><button type="submit">Cerrar sesión</button></form>
    </div>
  </aside>

  <div class="sidebar-overlay" id="sidebarOverlay" hidden></div>

  <!-- ===== Contenido ===== -->
  <div class="admin-body">
    <header class="admin-topbar">
      <button class="sidebar-toggle" id="sidebarToggle" aria-label="Abrir menú">
        <span></span><span></span><span></span>
      </button>
      <h1 class="topbar-title"><%= tituloPagina %></h1>
      <span class="topbar-user">Hola, <strong><%= usuario %></strong></span>
    </header>

    <main class="admin-main">
