<%- include('partials/inicio') %>
<%
  var ETQ = { CONVERSACION_NUEVA: 'Conversación nueva', TURNO_IA: 'Respuesta con IA (un turno)', PLANTILLA_SALIENTE: 'Plantilla saliente' };
  var ETQ_MODO = { APAGADO: 'Apagado: manda el sistema de conversaciones', SOMBRA: 'Modo sombra: se anota en créditos sin cobrar', ACTIVO: 'Activo: los créditos son la fuente de verdad' };
  var usd = function (n) { return 'US$ ' + Number(n).toFixed(4); };
  var vigentes = tarifario.filter(function (t) { return !t.vigenteHasta; });
%>

<div class="page-head">
  <h2>Créditos</h2>
  <p>Un crédito es la unidad interna de consumo. 1 conversación = <%= equivalencia %> créditos. Modo actual: <strong><%= ETQ_MODO[modo] %></strong>. Se cambia con la variable <code>CREDITOS_MODO</code> (APAGADO, SOMBRA o ACTIVO).</p>
</div>

<% if (mensaje) { %><div class="alert-ok"><%= mensaje %></div><% } %>
<% if (error) { %><div class="alert-err" role="alert"><%= error %></div><% } %>

<p><a class="btn btn-primary" href="/admin/creditos/historico">Ver lo que habría pasado con los datos históricos</a></p>

<div class="page-head"><h2 style="font-size:1.2rem">Tarifario (créditos por acción)</h2><p>Cambiar un precio cierra el vigente y abre uno nuevo: lo ya cobrado no se mueve.</p></div>
<div class="table-wrap"><table class="leads-table"><thead><tr><th>Acción</th><th class="num">Créditos</th><th>Desde</th></tr></thead><tbody>
  <% vigentes.forEach(function (t) { %>
    <tr><td><%= ETQ[t.accion] || t.accion %></td><td class="num"><%= t.creditos %></td><td class="nowrap muted"><%= t.vigenteDesde.getFullYear() <= 2000 ? 'desde siempre' : t.vigenteDesde.toLocaleDateString('es-BO') %></td></tr>
  <% }); %>
</tbody></table></div>
<% if (tarifario.length > vigentes.length) { %>
<details style="margin:.6rem 0"><summary style="cursor:pointer">Ver precios anteriores</summary>
<div class="table-wrap"><table class="leads-table"><tbody>
  <% tarifario.filter(function (t) { return t.vigenteHasta; }).forEach(function (t) { %><tr class="is-done"><td><%= ETQ[t.accion] || t.accion %></td><td class="num"><%= t.creditos %></td><td class="nowrap"><%= t.vigenteDesde.getFullYear() <= 2000 ? 'desde siempre' : 'desde ' + t.vigenteDesde.toLocaleDateString('es-BO') %> hasta <%= t.vigenteHasta.toLocaleDateString('es-BO') %></td><td class="muted"><%= t.nota || '' %></td></tr><% }); %>
</tbody></table></div></details>
<% } %>
<% if (costoRealTurno !== null) { %><p class="muted">Costo real medido: <strong><%= usd(costoRealTurno) %></strong> por llamada de chat (últimos 30 días). Con 1 crédito = US$ 0,01, un turno de IA cuesta 1 crédito (US$ 0,01) frente a ese costo. Revisá el margen en <a href="/admin/rentabilidad">Rentabilidad</a>.</p><% } %>
<details style="margin-top:.8rem"><summary style="cursor:pointer;font-weight:600">Cambiar un precio</summary>
<form method="POST" action="/admin/creditos/tarifario" class="card-form" style="margin-top:.6rem">
  <div class="field-row">
    <div class="field"><label for="tAcc">Acción</label><select id="tAcc" name="accion"><% Object.keys(ETQ).forEach(function (k) { %><option value="<%= k %>"><%= ETQ[k] %></option><% }); %></select></div>
    <div class="field"><label for="tCre">Créditos</label><input id="tCre" name="creditos" type="number" min="0" required /></div>
    <div class="field"><label for="tNota">Nota</label><input id="tNota" name="nota" maxlength="200" placeholder="ej. ajuste por costo real" /></div>
  </div>
  <div class="form-actions"><button class="btn btn-primary" type="submit">Guardar precio</button></div>
</form>
</details>

<div class="page-head"><h2 style="font-size:1.2rem">Modo sombra: lo que se habría cobrado</h2><p>Últimos <%= sombra.dias %> días. Sirve para comparar con las conversaciones reales y calibrar el tarifario antes de activar.</p></div>
<% if (!sombra.filas.length) { %><p class="muted">Todavía no hay consumo anotado en modo sombra (se anota con <code>CREDITOS_MODO=SOMBRA</code>).</p><% } else { %>
<div class="table-wrap"><table class="leads-table"><thead><tr><th>Empresa</th><th class="num">Conversaciones nuevas</th><th class="num">Turnos con IA</th><th class="num">Créditos</th><th></th></tr></thead><tbody>
  <% sombra.filas.forEach(function (f) { %><tr><td><%= f.nombre %></td><td class="num"><%= f.conversaciones %></td><td class="num"><%= f.turnosIA %></td><td class="num"><%= f.creditos %></td><td><a href="/admin/creditos/empresa/<%= f.empresaId %>">Ver</a></td></tr><% }); %>
</tbody></table></div>
<% } %>

<div class="page-head"><h2 style="font-size:1.2rem">Saldo y libro de una empresa</h2></div>
<form method="GET" action="" class="filtros-ventas" onsubmit="if(this.empresa.value){location.href='/admin/creditos/empresa/'+this.empresa.value;} return false;">
  <select name="empresa" aria-label="Empresa"><option value="">Elegí una empresa</option><% empresas.forEach(function (e) { %><option value="<%= e.id %>"><%= e.nombre %></option><% }); %></select>
  <button class="btn btn-primary" type="submit">Abrir</button>
</form>

<%- include('partials/fin') %>
