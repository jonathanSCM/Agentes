<%- include('partials/inicio') %>
<%
  var usd = function (n, dec) { return 'US$ ' + Number(n).toFixed(dec === undefined ? 4 : dec); };
  var nf = function (n) { return Math.round(Number(n)).toLocaleString('es-BO'); };
  var barra = function (p) { return '<span style="display:block;height:6px;border-radius:3px;background:var(--primary-2,#6c5ce7);width:' + Math.max(2, Math.min(100, p)) + '%"></span>'; };
%>

<div class="page-head">
  <h2>Costo de IA · <%= d.empresa.nombre %></h2>
  <p><a href="/admin/costo-ia">← Volver a costo de IA</a> · en qué se fue el costo estimado.</p>
</div>

<form method="GET" class="filtros-ventas" style="margin-bottom:1rem">
  <select name="dias" aria-label="Período" onchange="this.form.submit()"><% [[7, 'Últimos 7 días'], [30, 'Últimos 30 días'], [90, 'Últimos 90 días']].forEach(function (p) { %><option value="<%= p[0] %>" <%= d.dias === p[0] ? 'selected' : '' %>><%= p[1] %></option><% }); %></select>
</form>

<% if (d.sinTarifa > 0) { %><div class="alert-err" role="alert"><%= d.sinTarifa %> llamada(s) usaron un modelo sin tarifa cargada: no tienen costo y no se inventa (<a href="/admin/costo-ia/ajustes#tarifas">cargar la tarifa</a>).</div><% } %>

<div class="admin-stats">
  <div class="stat-card"><span class="stat-num"><%= usd(d.totalUsd) %></span><span class="stat-label">Costo estimado</span></div>
  <div class="stat-card"><span class="stat-num"><%= nf(d.llamadas) %></span><span class="stat-label">Llamadas a la IA</span></div>
  <div class="stat-card"><span class="stat-num"><%= d.conversaciones %></span><span class="stat-label">Conversaciones atendidas con IA</span></div>
  <div class="stat-card"><span class="stat-num"><%= d.costoPorConversacion === null ? '—' : usd(d.costoPorConversacion) %></span><span class="stat-label">Costo por conversación</span></div>
</div>

<div class="page-head"><h2 style="font-size:1.2rem">1. Qué tipo de texto se pagó</h2><p>Cada llamada cobra por separado lo que se le envía, lo que se reutiliza de memoria y lo que la IA escribe.</p></div>
<div class="table-wrap"><table class="leads-table"><thead><tr><th>Tipo</th><th class="num">Tokens</th><th class="num">Costo</th><th class="num">% del costo</th><th style="width:22%"></th></tr></thead><tbody>
  <% d.porToken.forEach(function (x) { %><tr><td><strong><%= x.nombre %></strong><br><span class="muted" style="font-size:.8rem"><%= x.ayuda %></span></td><td class="num"><%= nf(x.tokens) %></td><td class="num"><%= usd(x.usd) %></td><td class="num"><%= x.pct %>%</td><td><%- barra(x.pct) %></td></tr><% }); %>
</tbody></table></div>

<div class="page-head"><h2 style="font-size:1.2rem">2. Para qué se usó la IA</h2><p>Cada llamada responde a una necesidad distinta del turno.</p></div>
<div class="table-wrap"><table class="leads-table"><thead><tr><th>Uso</th><th class="num">Llamadas</th><th class="num">Enviado</th><th class="num">Caché</th><th class="num">Escrito</th><th class="num">Costo</th><th class="num">%</th><th style="width:16%"></th></tr></thead><tbody>
  <% d.porEtapa.forEach(function (x) { %><tr><td><strong><%= x.nombre %></strong><br><span class="muted" style="font-size:.8rem"><%= x.ayuda %></span></td><td class="num"><%= nf(x.llamadas) %></td><td class="num"><%= nf(x.entradaTok) %></td><td class="num"><%= nf(x.cacheTok) %></td><td class="num"><%= nf(x.salidaTok) %></td><td class="num"><%= usd(x.usd) %></td><td class="num"><%= x.pct %>%</td><td><%- barra(x.pct) %></td></tr><% }); %>
</tbody></table></div>

<div class="page-head"><h2 style="font-size:1.2rem">3. Por herramienta del agente</h2><p>Costo de los turnos en los que el agente usó cada herramienta. Un turno que usó dos herramientas aparece en ambas, así que las filas no suman el total.</p></div>
<% if (!d.herramientas.length) { %>
  <p class="muted"><%= d.hayHistorialTurnos ? 'No hubo turnos con herramientas en este período.' : 'Todavía no hay historial de turnos: este desglose se llena con los mensajes nuevos (el historial empezó a guardarse hace poco).' %></p>
<% } else { %>
<div class="table-wrap"><table class="leads-table"><thead><tr><th>Herramienta</th><th class="num">Turnos</th><th class="num">Tokens de esos turnos</th><th class="num">Costo de esos turnos</th><th class="num">Costo por turno</th></tr></thead><tbody>
  <% d.herramientas.forEach(function (h) { %><tr><td><%= h.nombre %></td><td class="num"><%= h.turnos %></td><td class="num"><%= nf(h.tokens) %></td><td class="num"><%= usd(h.usd) %></td><td class="num"><%= usd(h.usdPorTurno) %></td></tr><% }); %>
</tbody></table></div>
<% } %>

<div class="page-head"><h2 style="font-size:1.2rem">4. Los turnos más caros</h2><p>Para revisar qué pasó en los que más gastaron.</p></div>
<% if (!d.masCaros.length) { %>
  <p class="muted">Todavía no hay turnos con costo registrado en este período.</p>
<% } else { %>
<div class="table-wrap"><table class="leads-table"><thead><tr><th>Fecha</th><th>Herramientas usadas</th><th class="num">Llamadas</th><th class="num">Tokens</th><th class="num">Costo</th><th></th></tr></thead><tbody>
  <% d.masCaros.forEach(function (c) { %><tr><td class="nowrap"><%= new Date(c.createdAt).toLocaleString('es-BO') %></td><td class="muted"><%= c.herramientas || 'ninguna' %></td><td class="num"><%= c.llamadasIA %></td><td class="num"><%= nf(c.tokens) %></td><td class="num"><%= usd(c.usd) %></td><td><a href="/admin/ia/turnos/<%= c.id %>">Ver turno</a></td></tr><% }); %>
</tbody></table></div>
<% } %>

<div class="dash-grid">
  <div class="dash-card">
    <div class="dash-card-head"><h3>Por modelo</h3></div>
    <div class="table-wrap"><table class="leads-table"><thead><tr><th>Modelo</th><th class="num">Llamadas</th><th class="num">Costo</th><th class="num">%</th></tr></thead><tbody>
      <% d.modelos.forEach(function (m) { %><tr><td><%= m.modelo %></td><td class="num"><%= nf(m.llamadas) %></td><td class="num"><%= usd(m.usd) %></td><td class="num"><%= m.pct %>%</td></tr><% }); %>
    </tbody></table></div>
  </div>
  <div class="dash-card">
    <div class="dash-card-head"><h3>Por día</h3></div>
    <div class="table-wrap"><table class="leads-table"><thead><tr><th>Día</th><th class="num">Llamadas</th><th class="num">Costo</th></tr></thead><tbody>
      <% d.porDia.slice(0, 14).forEach(function (x) { %><tr><td><%= x.dia %></td><td class="num"><%= nf(x.llamadas) %></td><td class="num"><%= usd(x.usd) %></td></tr><% }); %>
    </tbody></table></div>
  </div>
</div>

<%- include('partials/fin') %>
