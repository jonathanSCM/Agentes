<%- include('partials/inicio') %>

<div class="page-head">
  <h2><%= compra ? 'Editar compra' : 'Registrar compra de paquete' %></h2>
  <p><%= compra ? 'Ajusta los datos de esta compra.' : 'Asigna un paquete de conversaciones a un cliente.' %></p>
</div>

<% if (error) { %><div class="alert-err"><%= error %></div><% } %>

<% if (empresas.length === 0 && !compra) { %>
  <div class="empty-state">
    <h3>Primero necesitas un cliente</h3>
    <p>Registra una empresa antes de asignarle un paquete.</p>
    <p style="margin-top:1rem"><a class="btn btn-primary" href="/admin/registrados/nuevo">+ Agregar empresa</a></p>
  </div>
<% } else { %>
<form method="POST" action="<%= compra ? '/admin/compras/' + compra.id : '/admin/compras' %>" class="form-card">
  <div class="field">
    <label for="empresaId">Cliente *</label>
    <select id="empresaId" name="empresaId" required>
      <% empresas.forEach(function (e) { %>
        <option value="<%= e.id %>" <%= compra && compra.empresaId === e.id ? 'selected' : '' %>><%= e.nombre %></option>
      <% }); %>
    </select>
  </div>

  <div class="field">
    <label for="paqueteId">Paquete del catálogo</label>
    <select id="paqueteId" name="paqueteId">
      <option value="">— Cantidad personalizada —</option>
      <% paquetes.forEach(function (p) { %>
        <option value="<%= p.id %>" data-cantidad="<%= p.cantidad %>" data-precio="<%= p.precioUsd %>"
          <%= compra && compra.paqueteId === p.id ? 'selected' : '' %>>
          <%= p.cantidad.toLocaleString('es-BO') %> conversaciones — US$ <%= Number(p.precioUsd).toFixed(2) %>
        </option>
      <% }); %>
    </select>
  </div>

  <div class="field-row">
    <div class="field">
      <label for="cantidad">Conversaciones *</label>
      <input id="cantidad" name="cantidad" type="number" min="1" required
             value="<%= compra ? compra.cantidad : '' %>" placeholder="1000" />
    </div>
    <div class="field">
      <label for="precioUsd">Precio (US$)</label>
      <input id="precioUsd" name="precioUsd" type="number" min="0" step="0.01"
             value="<%= compra ? Number(compra.precioUsd).toFixed(2) : '' %>" placeholder="66.00" />
    </div>
  </div>

  <div class="field-row">
    <div class="field">
      <label for="fechaRenovacion">Fecha de renovación *</label>
      <input id="fechaRenovacion" name="fechaRenovacion" type="date" required value="<%= fechaRenovacionValor %>" />
    </div>
    <% if (compra) { %>
      <div class="field">
        <label for="consumidas">Consumidas</label>
        <input id="consumidas" name="consumidas" type="number" min="0" value="<%= compra.consumidas %>" />
      </div>
    <% } %>
  </div>

  <div class="field">
    <label for="nota">Nota (opcional)</label>
    <input id="nota" name="nota" type="text" maxlength="200"
           value="<%= compra && compra.nota ? compra.nota : '' %>" placeholder="Ej: pago por transferencia" />
  </div>

  <div class="form-actions">
    <a class="btn btn-ghost" href="/admin/compras">Cancelar</a>
    <button class="btn btn-primary" type="submit"><%= compra ? 'Guardar cambios' : 'Registrar compra' %></button>
  </div>
</form>

<script>
  // Al elegir un paquete del catalogo, rellena cantidad y precio automaticamente
  document.getElementById('paqueteId').addEventListener('change', function (e) {
    var op = e.target.selectedOptions[0];
    if (op && op.dataset.cantidad) {
      document.getElementById('cantidad').value = op.dataset.cantidad;
      document.getElementById('precioUsd').value = Number(op.dataset.precio).toFixed(2);
    }
  });
</script>
<% } %>

<%- include('partials/fin') %>
