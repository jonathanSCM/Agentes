<%- include('partials/inicio') %>

<div class="page-head">
  <h2><%= plan ? 'Editar plan' : 'Nuevo plan' %></h2>
  <p><%= plan ? 'Modifica los datos comerciales de este plan.' : 'Crea un nuevo plan para el catálogo comercial.' %></p>
</div>

<% if (error) { %><div class="alert-err"><%= error %></div><% } %>

<form method="POST" action="<%= plan && plan.id ? '/admin/planes/' + plan.id : '/admin/planes' %>" class="form-card">
  <div class="field-row">
    <div class="field">
      <label for="codigo">Código *</label>
      <input id="codigo" name="codigo" type="text" required maxlength="30" style="text-transform:uppercase"
             value="<%= plan ? plan.codigo : '' %>" placeholder="Ej: STANDARD" <%= plan && plan.id ? 'readonly' : '' %> />
    </div>
    <div class="field">
      <label for="nombre">Nombre *</label>
      <input id="nombre" name="nombre" type="text" required maxlength="80"
             value="<%= plan ? plan.nombre : '' %>" placeholder="Ej: Standard" />
    </div>
  </div>

  <div class="field-row">
    <div class="field">
      <label for="mensualidadBs">Mensualidad (Bs)</label>
      <input id="mensualidadBs" name="mensualidadBs" type="number" min="0" step="0.01"
             value="<%= plan ? Number(plan.mensualidadBs) : 0 %>" />
    </div>
    <div class="field">
      <label for="implementacionBs">Implementación (Bs)</label>
      <input id="implementacionBs" name="implementacionBs" type="number" min="0" step="0.01"
             value="<%= plan ? Number(plan.implementacionBs) : 0 %>" />
    </div>
    <div class="field">
      <label for="primerPagoBs">Primer pago (Bs)</label>
      <input id="primerPagoBs" name="primerPagoBs" type="number" min="0" step="0.01"
             value="<%= plan ? Number(plan.primerPagoBs) : 0 %>" />
      <p class="muted" style="font-size:.78rem;margin:.3rem 0 0">Normalmente implementación + primera mensualidad.</p>
    </div>
  </div>

  <div class="field-row">
    <div class="field">
      <label for="mensualidadUsd">Mensualidad (US$)</label>
      <input id="mensualidadUsd" name="mensualidadUsd" type="number" min="0" step="0.01"
             value="<%= plan && plan.mensualidadUsd != null ? Number(plan.mensualidadUsd) : '' %>" placeholder="Opcional" />
    </div>
    <div class="field">
      <label for="implementacionUsd">Implementación (US$)</label>
      <input id="implementacionUsd" name="implementacionUsd" type="number" min="0" step="0.01"
             value="<%= plan && plan.implementacionUsd != null ? Number(plan.implementacionUsd) : '' %>" placeholder="Opcional" />
    </div>
    <div class="field">
      <label for="primerPagoUsd">Primer pago (US$)</label>
      <input id="primerPagoUsd" name="primerPagoUsd" type="number" min="0" step="0.01"
             value="<%= plan && plan.primerPagoUsd != null ? Number(plan.primerPagoUsd) : '' %>" placeholder="Opcional" />
      <p class="muted" style="font-size:.78rem;margin:.3rem 0 0">Precio para visitantes de países sin precio propio configurado abajo. Si se deja vacío, esos países ven el precio en Bs.</p>
    </div>
  </div>

  <div class="field-row">
    <div class="field">
      <label for="convIncluidas">Conversaciones incluidas / mes</label>
      <input id="convIncluidas" name="convIncluidas" type="number" min="0"
             value="<%= plan ? plan.convIncluidas : 100 %>" />
    </div>
    <div class="field">
      <label for="maxProductos">Máximo de productos</label>
      <input id="maxProductos" name="maxProductos" type="number" min="0"
             value="<%= plan ? plan.maxProductos : 10 %>" />
    </div>
    <div class="field">
      <label for="maxUsuarios">Máximo de usuarios</label>
      <input id="maxUsuarios" name="maxUsuarios" type="number" min="1"
             value="<%= plan ? plan.maxUsuarios : 1 %>" />
    </div>
  </div>

  <div class="field-row">
    <div class="field">
      <label for="modeloIa">Modelo de IA</label>
      <input id="modeloIa" name="modeloIa" type="text" maxlength="60"
             value="<%= plan ? plan.modeloIa : 'claude-haiku-4-5' %>" placeholder="Ej: gpt-4o-mini, claude-sonnet-5" />
    </div>
    <div class="field">
      <label for="orden">Orden en la vitrina</label>
      <input id="orden" name="orden" type="number" min="0"
             value="<%= plan ? plan.orden : 0 %>" />
    </div>
  </div>

  <div class="field">
    <label for="features">Características (una por línea)</label>
    <textarea id="features" name="features" rows="6" placeholder="Hasta 100 productos
Agente de ventas con IA
..."><%= plan && plan.features ? (Array.isArray(plan.features) ? plan.features.join('\n') : plan.features) : '' %></textarea>
  </div>

  <div class="field-row">
    <label style="display:flex;align-items:center;gap:.5rem"><input type="checkbox" name="marcaBlanca" value="1" style="width:auto" <%= plan && plan.marcaBlanca ? 'checked' : '' %> /> Marca blanca</label>
    <label style="display:flex;align-items:center;gap:.5rem"><input type="checkbox" name="recomendado" value="1" style="width:auto" <%= plan && plan.recomendado ? 'checked' : '' %> /> Marcar como recomendado</label>
  </div>

  <div class="form-actions">
    <a class="btn btn-ghost" href="/admin/planes">Cancelar</a>
    <button class="btn btn-primary" type="submit"><%= plan && plan.id ? 'Guardar cambios' : 'Crear plan' %></button>
  </div>
</form>

<% if (plan && plan.id) { %>
  <div class="page-head" style="margin-top:2rem">
    <h2 style="font-size:1.1rem">Precios por país</h2>
    <p class="muted" style="font-size:.85rem">Se detecta el país del visitante por IP. Si no hay un precio propio acá, se usa el default en US$ de arriba (o Bs si tampoco hay US$ cargado).</p>
  </div>

  <% if (errorPrecioPais) { %><div class="alert-err"><%= errorPrecioPais %></div><% } %>

  <% if (plan.preciosPais.length) { %>
    <div class="table-wrap">
      <table class="leads-table">
        <thead><tr><th>País</th><th>Moneda</th><th class="num">Mensualidad</th><th class="num">Implementación</th><th class="num">Primer pago</th><th>Acciones</th></tr></thead>
        <tbody>
          <% plan.preciosPais.forEach(function (pp) { %>
            <tr>
              <td><%= pp.pais %></td>
              <td><%= pp.moneda %></td>
              <td class="num"><%= Number(pp.mensualidad).toFixed(2) %></td>
              <td class="num"><%= Number(pp.implementacion).toFixed(2) %></td>
              <td class="num"><%= Number(pp.primerPago).toFixed(2) %></td>
              <td class="actions-cell">
                <form method="POST" action="/admin/planes/<%= plan.id %>/precios-pais/<%= pp.id %>/eliminar" class="inline-form"
                      onsubmit="return confirm('¿Eliminar el precio de ' + '<%= pp.pais %>' + '?');">
                  <button class="btn btn-ghost" style="padding:.4rem .8rem;font-size:.85rem" type="submit">Eliminar</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>

  <form method="POST" action="/admin/planes/<%= plan.id %>/precios-pais" class="form-card" style="max-width:700px;margin-top:1rem">
    <h3 style="margin:0 0 1rem;font-size:.95rem">Agregar / actualizar precio de un país</h3>
    <div class="field-row">
      <div class="field">
        <label for="pp-pais">País (código de 2 letras) *</label>
        <input id="pp-pais" name="pais" type="text" required maxlength="2" style="text-transform:uppercase" list="paises-sugeridos" placeholder="Ej: PE" />
        <datalist id="paises-sugeridos">
          <option value="BO">Bolivia</option><option value="PE">Perú</option><option value="AR">Argentina</option>
          <option value="CL">Chile</option><option value="CO">Colombia</option><option value="MX">México</option>
          <option value="EC">Ecuador</option><option value="PY">Paraguay</option><option value="UY">Uruguay</option>
          <option value="VE">Venezuela</option><option value="BR">Brasil</option><option value="US">Estados Unidos</option>
        </datalist>
      </div>
      <div class="field">
        <label for="pp-moneda">Moneda (código de 3 letras) *</label>
        <input id="pp-moneda" name="moneda" type="text" required maxlength="3" style="text-transform:uppercase" placeholder="Ej: PEN" />
      </div>
    </div>
    <div class="field-row">
      <div class="field">
        <label for="pp-mensualidad">Mensualidad *</label>
        <input id="pp-mensualidad" name="mensualidad" type="number" min="0" step="0.01" required />
      </div>
      <div class="field">
        <label for="pp-implementacion">Implementación *</label>
        <input id="pp-implementacion" name="implementacion" type="number" min="0" step="0.01" required />
      </div>
      <div class="field">
        <label for="pp-primerpago">Primer pago *</label>
        <input id="pp-primerpago" name="primerPago" type="number" min="0" step="0.01" required />
      </div>
    </div>
    <div class="form-actions">
      <button class="btn btn-primary" type="submit">Guardar precio de país</button>
    </div>
  </form>
<% } %>

<%- include('partials/fin') %>
