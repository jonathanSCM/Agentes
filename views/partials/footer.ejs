<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="brand">
        <img src="/img/logo.png" alt="<%= site.name %>" class="brand-logo" />
      </div>
      <p class="footer-desc">Construimos software a medida: web apps, aplicaciones moviles y paneles administrativos que hacen crecer tu negocio.</p>
    </div>

    <div class="footer-col">
      <h4>Servicios</h4>
      <a href="#servicios">Aplicaciones web</a>
      <a href="#servicios">Apps moviles</a>
      <a href="#servicios">Paneles administrativos</a>
      <a href="#servicios">Integraciones / APIs</a>
    </div>

    <div class="footer-col">
      <h4>Empresa</h4>
      <a href="#proceso">Nuestro proceso</a>
      <a href="#portafolio">Portafolio</a>
      <a href="#contacto">Contacto</a>
      <a href="/admin">🔒 Panel de administración</a>
    </div>

    <div class="footer-col">
      <h4>Contacto</h4>
      <a href="mailto:<%= site.email %>"><%= site.email %></a>
      <a href="<%= site.whatsappUrl %>" target="_blank" rel="noopener"><%= site.phone %></a>
      <span class="footer-muted"><%= site.location %></span>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>&copy; <%= site.year %> <%= site.name %>. Todos los derechos reservados.</span>
    <span class="footer-muted">Hecho con Node.js &middot; <a href="/admin" style="color:inherit">Panel</a></span>
  </div>
</footer>

