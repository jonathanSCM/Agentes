<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<meta property="og:type" content="product" />
<meta property="og:title" content="<%= ogTitle %>" />
<meta property="og:description" content="<%= ogDescripcion %>" />
<% if (ogImagen) { %><meta property="og:image" content="<%= ogImagen %>" /><% } %>
<meta property="og:url" content="<%= ogUrl %>" />
<meta property="product:price:amount" content="<%= Number(producto.precio).toFixed(2) %>" />
<meta property="product:price:currency" content="<%= empresa.moneda %>" />
<meta name="twitter:card" content="<%= ogImagen ? 'summary_large_image' : 'summary' %>" />
<link rel="icon" type="image/png" href="/img/logo-icon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{--fondo:#0f1117;--panel:#181b24;--panel-2:#1f2330;--tinta:#eef0f6;--tenue:#9aa1b5;--acento:<%= (config && config.colorPrimario) || '#22c58b' %>;--acento-2:<%= (config && config.colorSecundario) || '#22c58b' %>;--borde:#262b38;}
  *{margin:0;padding:0;box-sizing:border-box;}
  body{background:var(--fondo);color:var(--tinta);font-family:'Inter',system-ui,sans-serif;min-height:100vh;}
  header{display:flex;align-items:center;gap:.7rem;padding:20px 24px;max-width:1080px;margin:0 auto;}
  header img{width:34px;height:34px;border-radius:50%;object-fit:cover;}
  header strong{font-size:1.12rem;letter-spacing:-.01em;}
  main{max-width:1080px;margin:0 auto;padding:4px 24px 70px;}
  .volver{color:var(--tenue);text-decoration:none;font-size:.85rem;display:inline-flex;align-items:center;gap:5px;margin-bottom:22px;transition:color .15s;}
  .volver:hover{color:var(--tinta);}

  .layout{display:grid;grid-template-columns:1.15fr 1fr;gap:44px;align-items:start;}
  @media (max-width:860px){.layout{grid-template-columns:1fr;gap:28px;}}

  /* ---------- Galeria ---------- */
  .galeria{position:sticky;top:24px;}
  @media (max-width:860px){.galeria{position:static;}}
  /* Fondo tipo "backdrop" claro y con relieve: la mayoria de las fotos de
     catalogo tienen fondo blanco/gris de estudio - mostrarlas recortadas
     borde a borde contra el tema oscuro se ve como un rectangulo roto.
     Con este marco con relieve y la foto en "contain" (nunca recortada),
     se ve como una foto de producto bien presentada, tenga el fondo que
     tenga. */
  .galeria-principal{position:relative;border-radius:22px;overflow:hidden;background:radial-gradient(120% 120% at 30% 15%,#f6f6f8,#e3e4e8);box-shadow:0 24px 55px -22px rgba(0,0,0,.6);padding:26px;cursor:zoom-in;}
  .galeria-principal img{width:100%;display:block;aspect-ratio:1/1;object-fit:contain;transition:opacity .2s;}
  .galeria .ph{width:100%;aspect-ratio:1/1;border-radius:22px;display:flex;align-items:center;justify-content:center;color:var(--tenue);background:linear-gradient(135deg,#141722,#1b1f2c);box-shadow:0 24px 55px -22px rgba(0,0,0,.6);}
  .contador-fotos{position:absolute;right:16px;bottom:16px;background:rgba(10,12,18,.78);backdrop-filter:blur(6px);color:var(--tinta);font-size:.76rem;font-weight:600;padding:5px 11px;border-radius:999px;}
  .zoom-hint{position:absolute;left:16px;bottom:16px;background:rgba(10,12,18,.78);backdrop-filter:blur(6px);color:var(--tinta);font-size:.72rem;font-weight:600;padding:5px 11px;border-radius:999px;display:flex;align-items:center;gap:5px;}

  /* ---------- Lightbox de zoom ---------- */
  .lightbox{position:fixed;inset:0;background:rgba(6,7,11,.92);display:none;align-items:center;justify-content:center;z-index:50;padding:24px;}
  .lightbox.abierto{display:flex;}
  .lightbox img{max-width:100%;max-height:100%;object-fit:contain;touch-action:pinch-zoom;border-radius:8px;}
  .lightbox-cerrar{position:absolute;top:18px;right:20px;width:42px;height:42px;border-radius:50%;border:none;background:rgba(255,255,255,.1);color:#fff;font-size:1.3rem;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .15s;}
  .lightbox-cerrar:hover{background:rgba(255,255,255,.2);}
  .miniaturas{display:flex;gap:10px;margin-top:14px;overflow-x:auto;padding-bottom:2px;}
  .miniaturas button{padding:8px;border-radius:13px;border:2px solid transparent;background:linear-gradient(160deg,#f6f6f8,#e3e4e8);cursor:pointer;flex:0 0 auto;opacity:.6;transition:opacity .15s,border-color .15s,transform .15s;}
  .miniaturas button img{width:52px;height:52px;border-radius:8px;object-fit:contain;display:block;}
  .miniaturas button:hover{opacity:1;transform:translateY(-1px);}
  .miniaturas button.activa{border-color:var(--acento);opacity:1;}


  /* ---------- Info del producto ---------- */
  .marca-badge{display:inline-block;font-size:.76rem;font-weight:700;letter-spacing:.03em;text-transform:uppercase;color:var(--tenue);background:var(--panel);border:1px solid var(--borde);padding:4px 11px;border-radius:999px;margin-bottom:12px;}
  h1{font-size:1.9rem;font-weight:800;letter-spacing:-.02em;line-height:1.15;margin-bottom:14px;}
  .stock{font-size:.8rem;padding:4px 12px;border-radius:999px;background:rgba(255,255,255,.06);color:var(--tenue);display:inline-block;width:fit-content;font-weight:600;}
  .stock.bajo{background:rgba(255,180,60,.16);color:#ffc36b;}
  .stock.agotado{background:rgba(255,90,90,.16);color:#ff9a9a;}

  .seccion-descripcion{margin-top:22px;}
  .seccion-descripcion h3{font-size:.82rem;font-weight:700;color:var(--tenue);text-transform:uppercase;letter-spacing:.03em;margin-bottom:8px;}
  .descripcion{color:var(--tinta);opacity:.85;line-height:1.65;font-size:.94rem;}

  /* ---------- Tarjeta de compra ---------- */
  .compra-card{margin-top:26px;background:var(--panel);border:1px solid var(--borde);border-radius:18px;padding:22px;box-shadow:0 16px 40px -22px rgba(0,0,0,.6);}
  .precio{color:var(--acento);font-weight:800;font-size:1.9rem;letter-spacing:-.02em;margin-bottom:16px;}

  .campo{margin-bottom:18px;}
  .campo label{display:block;font-size:.82rem;color:var(--tenue);margin-bottom:9px;font-weight:600;}

  /* ---------- Swatches de color y pills de talla (reemplazan el combo box) ---------- */
  .swatches{display:flex;gap:10px;flex-wrap:wrap;}
  .swatch{width:46px;height:46px;border-radius:50%;padding:2px;border:2px solid transparent;background:var(--panel-2);cursor:pointer;transition:border-color .15s,transform .15s;position:relative;flex:0 0 auto;}
  .swatch:hover{transform:translateY(-1px);}
  .swatch.activo{border-color:var(--acento);}
  .swatch img{width:100%;height:100%;border-radius:50%;object-fit:cover;display:block;}
  .swatch-sin-foto{display:block;width:100%;height:100%;border-radius:50%;background:linear-gradient(135deg,#2a2f3d,#1b1f2c);}
  .swatch.agotado{opacity:.35;cursor:not-allowed;}
  .swatch.agotado::after{content:'';position:absolute;left:6px;right:6px;top:50%;height:2px;background:var(--tenue);transform:rotate(-40deg);}

  .pills{display:flex;gap:9px;flex-wrap:wrap;}
  .pill{background:var(--panel-2);border:1px solid var(--borde);color:var(--tinta);border-radius:10px;padding:9px 15px;font-size:.86rem;font-weight:600;cursor:pointer;transition:border-color .15s,background .15s,transform .15s;font-family:inherit;}
  .pill:hover:not(:disabled){transform:translateY(-1px);border-color:var(--acento);}
  .pill.activo{background:var(--acento);border-color:var(--acento);color:#08251a;}
  .pill:disabled{opacity:.4;cursor:not-allowed;text-decoration:line-through;}

  .btn{display:block;width:100%;text-align:center;border:none;border-radius:13px;padding:15px;font-size:.95rem;font-weight:700;cursor:pointer;text-decoration:none;transition:transform .15s,box-shadow .15s,opacity .15s;}
  .btn-primario{background:var(--acento);color:#08251a;box-shadow:0 10px 24px -10px color-mix(in srgb, var(--acento) 70%, transparent);}
  .btn-primario:hover:not(:disabled){transform:translateY(-1px);}
  .btn-primario:disabled{opacity:.5;cursor:not-allowed;box-shadow:none;}
  .btn-whatsapp{background:#25d366;color:#fff;margin-top:10px;box-shadow:0 10px 24px -10px rgba(37,211,102,.55);}
  .btn-whatsapp:hover{transform:translateY(-1px);}

  .aviso-sesion{background:rgba(255,180,60,.12);border:1px solid rgba(255,180,60,.35);color:#ffc36b;border-radius:11px;padding:13px 15px;font-size:.85rem;margin-bottom:16px;line-height:1.5;}

  /* ---------- Tambien te puede interesar ---------- */
  .relacionados{margin-top:56px;}
  .relacionados h2{font-size:1.2rem;font-weight:800;letter-spacing:-.01em;margin-bottom:18px;}
  .relacionados-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:16px;}
  .rel-card{background:var(--panel);border:1px solid var(--borde);border-radius:16px;overflow:hidden;text-decoration:none;color:inherit;display:block;transition:transform .15s,border-color .15s;}
  .rel-card:hover{transform:translateY(-2px);border-color:#343b4d;}
  .rel-card .rel-foto{width:100%;aspect-ratio:1/1;background:linear-gradient(160deg,#f6f6f8,#e3e4e8);display:flex;align-items:center;justify-content:center;padding:14px;}
  .rel-card img{max-width:100%;max-height:100%;object-fit:contain;display:block;}
  .rel-card .rel-ph{width:100%;aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;color:var(--tenue);background:linear-gradient(135deg,#141722,#1b1f2c);font-size:.8rem;}
  .rel-card-body{padding:12px 14px;}
  .rel-card-nombre{font-size:.86rem;font-weight:650;margin-bottom:5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .rel-card-precio{color:var(--acento);font-weight:700;font-size:.92rem;}
</style>
</head>
<body>
  <header>
    <% if (config && config.logoUrl) { %>
      <img src="<%= config.logoUrl %>" alt="" />
    <% } %>
    <strong><%= empresa.marca || empresa.nombre %></strong>
  </header>

  <main>
    <a class="volver" href="/catalogo/<%= empresa.slug %><%= tokenSesion ? '?s=' + encodeURIComponent(tokenSesion) : '' %>">← Volver al catálogo</a>

    <div class="layout">
      <div class="galeria">
        <% var fotos = (producto.fotos && producto.fotos.length) ? producto.fotos : []; %>
        <% if (fotos.length) { %>
          <div class="galeria-principal" onclick="abrirZoom()">
            <img id="foto-principal" src="<%= fotos[0] %>" alt="<%= producto.nombre %>" />
            <span class="zoom-hint">🔍 Ampliar</span>
            <% if (fotos.length > 1) { %><span class="contador-fotos" id="contador-fotos">1/<%= fotos.length %></span><% } %>
          </div>
          <% if (fotos.length > 1) { %>
            <div class="miniaturas">
              <% fotos.forEach(function (f, i) { %>
                <button type="button" class="<%= i === 0 ? 'activa' : '' %>"
                     onclick="document.getElementById('foto-principal').src='<%= f %>'; document.querySelectorAll('.miniaturas button').forEach(function(m){m.classList.remove('activa')}); this.classList.add('activa'); var c=document.getElementById('contador-fotos'); if(c) c.textContent='<%= i + 1 %>/<%= fotos.length %>';">
                  <img src="<%= f %>" alt="" />
                </button>
              <% }); %>
            </div>
          <% } %>
        <% } else { %>
          <div class="ph">Sin foto</div>
        <% } %>
      </div>

      <div>
        <% var marca = producto.atributos && producto.atributos.Marca ? producto.atributos.Marca : ''; %>
        <% if (marca) { %><span class="marca-badge"><%= marca %></span><% } %>
        <h1><%= producto.nombre %></h1>

        <% var variantes = producto.variantes || []; %>
        <% var stockBase = variantes.length ? variantes.reduce(function(s,v){return s+v.stock}, 0) : producto.stock; %>
        <span class="stock <%= stockBase === 0 ? 'agotado' : (stockBase <= 5 ? 'bajo' : '') %>">
          <%= stockBase === 0 ? 'Agotado' : (stockBase <= 5 ? 'Últimas unidades' : 'Disponible') %>
        </span>

        <% if (producto.descripcion) { %>
          <div class="seccion-descripcion">
            <h3>Descripción</h3>
            <p class="descripcion"><%= producto.descripcion %></p>
          </div>
        <% } %>

        <div class="compra-card">
          <p class="precio" id="precio-mostrado"><%= simboloCatalogo %> <%= Number(producto.precio).toFixed(2) %></p>

          <% if (variantes.length > 1 && colores && colores.length > 1) { %>
            <div class="campo">
              <label id="label-color">Color</label>
              <div class="swatches" id="swatches-color"></div>
            </div>
          <% } %>
          <% if (variantes.length > 1) { %>
            <div class="campo" id="campo-opciones">
              <label id="label-opciones">Talla</label>
              <div class="pills" id="pills-opciones"></div>
            </div>
          <% } %>

          <% if (!tokenSesion) { %>
            <div class="aviso-sesion">Para agregar al carrito, pedile este producto a tu asesor por WhatsApp — te va a mandar un link que ya te reconoce.</div>
            <% if (numeroWhatsapp) { %>
              <a class="btn btn-whatsapp" href="https://wa.me/<%= numeroWhatsapp %>?text=<%= encodeURIComponent(mensajeWhatsapp) %>" target="_blank" rel="noopener">Consultar por WhatsApp</a>
            <% } %>
          <% } else { %>
            <form method="POST" action="/catalogo/<%= empresa.slug %>/producto/<%= producto.id %>/carrito">
              <input type="hidden" name="s" value="<%= tokenSesion %>" />
              <% if (variantes.length) { %><input type="hidden" name="idVariante" id="idVariante-input" value="<%= variantes.length === 1 ? variantes[0].id : '' %>" /><% } %>
              <button class="btn btn-primario" type="submit" id="btn-agregar" <%= (variantes.length > 1 || stockBase === 0) ? 'disabled' : '' %>>
                <%= variantes.length > 1 ? 'Elegí una opción' : (stockBase === 0 ? 'Sin stock' : 'Agregar al carrito') %>
              </button>
            </form>
            <% if (numeroWhatsapp) { %>
              <a class="btn btn-whatsapp" href="https://wa.me/<%= numeroWhatsapp %>?text=<%= encodeURIComponent(mensajeWhatsapp) %>" target="_blank" rel="noopener">Volver a WhatsApp</a>
            <% } %>
          <% } %>
        </div>
      </div>
    </div>

    <% if (relacionados && relacionados.length) { %>
      <div class="relacionados">
        <h2>También te puede interesar</h2>
        <div class="relacionados-grid">
          <% relacionados.forEach(function (r) { %>
            <a class="rel-card" href="/catalogo/<%= empresa.slug %>/producto/<%= r.id %><%= tokenSesion ? '?s=' + encodeURIComponent(tokenSesion) : '' %>">
              <% if (r.fotos && r.fotos.length) { %>
                <div class="rel-foto"><img src="<%= r.fotos[0] %>" alt="<%= r.nombre %>" /></div>
              <% } else { %>
                <div class="rel-ph">Sin foto</div>
              <% } %>
              <div class="rel-card-body">
                <div class="rel-card-nombre"><%= r.nombre %></div>
                <div class="rel-card-precio"><%= simboloCatalogo %> <%= Number(r.precio).toFixed(2) %></div>
              </div>
            </a>
          <% }); %>
        </div>
      </div>
    <% } %>
  </main>

  <div class="lightbox" id="lightbox" onclick="cerrarZoom(event)">
    <button type="button" class="lightbox-cerrar" onclick="cerrarZoom(event)" aria-label="Cerrar">✕</button>
    <img id="lightbox-img" src="" alt="<%= producto.nombre %>" />
  </div>

  <script>
    function abrirZoom() {
      var principal = document.getElementById('foto-principal');
      if (!principal || !principal.src) return;
      document.getElementById('lightbox-img').src = principal.src;
      document.getElementById('lightbox').classList.add('abierto');
    }
    function cerrarZoom(e) {
      if (e && e.target && e.target.id === 'lightbox-img') return;
      document.getElementById('lightbox').classList.remove('abierto');
    }
  </script>

  <% if (variantes.length > 1) { %>
  <script>
    // Selector de color (swatches con foto real) + talla (pills), en vez del
    // combo box de siempre. Todo el armado corre del lado del cliente con lo
    // que ya trajo el servidor (variantes reales) - nunca inventa una
    // combinacion que no exista, y el hidden idVariante siempre queda con un
    // ID real o vacio (el boton se deshabilita hasta que hay uno valido).
    // Con una sola variante no hace falta nada de esto: el servidor ya dejo
    // el hidden precargado con su ID.
    (function () {
      var variantes = <%- JSON.stringify(variantes.map(function (v) {
        return {
          id: v.id,
          color: (v.atributos && v.atributos.Color) || null,
          talla: (v.atributos && v.atributos.Talla) || null,
          etiqueta: Object.entries(v.atributos || {}).map(function (e) { return e[0] + ': ' + e[1]; }).join(' · '),
          stock: v.stock,
          precio: v.precio != null ? Number(v.precio) : null,
        };
      })) %>;
      var colores = <%- JSON.stringify((colores || []).map(function (c) { return { color: c.color, foto: c.foto }; })) %>;
      var precioBase = <%= Number(producto.precio) %>;
      var simbolo = '<%= simboloCatalogo %>';

      var tieneColor = variantes.some(function (v) { return v.color; });
      var tieneTalla = variantes.some(function (v) { return v.talla; });

      var swatchesEl = document.getElementById('swatches-color');
      var pillsEl = document.getElementById('pills-opciones');
      var labelOpciones = document.getElementById('label-opciones');
      var inputIdVariante = document.getElementById('idVariante-input');
      var btnAgregar = document.getElementById('btn-agregar');
      var precioEl = document.getElementById('precio-mostrado');

      var colorSeleccionado = colores.length === 1 ? colores[0].color : null;
      var tallaSeleccionada = null;

      function capitalizar(t) { return t ? t.charAt(0).toUpperCase() + t.slice(1).toLowerCase() : t; }
      function formatearPrecio(n) { return simbolo + ' ' + Number(n).toFixed(2); }
      function variantesDeColor(color) { return variantes.filter(function (v) { return !color || v.color === color; }); }

      function pintarSwatches() {
        if (!swatchesEl) return;
        swatchesEl.innerHTML = '';
        colores.forEach(function (c) {
          var stockColor = variantesDeColor(c.color).reduce(function (s, v) { return s + v.stock; }, 0);
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'swatch' + (c.color === colorSeleccionado ? ' activo' : '') + (stockColor <= 0 ? ' agotado' : '');
          btn.title = capitalizar(c.color) + (stockColor <= 0 ? ' (sin stock)' : '');
          btn.innerHTML = c.foto ? '<img src="' + c.foto + '" alt="' + c.color + '" />' : '<span class="swatch-sin-foto"></span>';
          btn.addEventListener('click', function () { elegirColor(c.color, c.foto); });
          swatchesEl.appendChild(btn);
        });
      }

      function pintarPills() {
        if (!pillsEl) return;
        pillsEl.innerHTML = '';
        var candidatos = tieneColor ? variantesDeColor(colorSeleccionado) : variantes;

        if (!tieneTalla) {
          // Variantes con atributos que no son Color/Talla (u otra
          // categoria): un pill directo por cada combinacion real.
          if (labelOpciones) labelOpciones.textContent = 'Opciones';
          candidatos.forEach(function (v) {
            var pill = document.createElement('button');
            pill.type = 'button';
            pill.className = 'pill' + (inputIdVariante && Number(inputIdVariante.value) === v.id ? ' activo' : '');
            pill.textContent = (v.etiqueta || 'Única opción') + (v.stock <= 0 ? ' (sin stock)' : '');
            pill.disabled = v.stock <= 0;
            pill.addEventListener('click', function () { elegirVariante(v); });
            pillsEl.appendChild(pill);
          });
          return;
        }

        if (labelOpciones) labelOpciones.textContent = 'Talla';
        var tallas = [];
        candidatos.forEach(function (v) { if (v.talla && tallas.indexOf(v.talla) === -1) tallas.push(v.talla); });
        tallas.forEach(function (talla) {
          var v = candidatos.filter(function (x) { return x.talla === talla; }).sort(function (a, b) { return b.stock - a.stock; })[0];
          var pill = document.createElement('button');
          pill.type = 'button';
          pill.className = 'pill' + (talla === tallaSeleccionada ? ' activo' : '');
          pill.textContent = talla + (v.stock <= 0 ? ' (sin stock)' : '');
          pill.disabled = v.stock <= 0;
          pill.addEventListener('click', function () { elegirTalla(talla); });
          pillsEl.appendChild(pill);
        });
      }

      function aplicarVariante(v) {
        if (inputIdVariante) inputIdVariante.value = v ? v.id : '';
        if (btnAgregar) {
          if (!v) { btnAgregar.disabled = true; btnAgregar.textContent = 'Elegí una opción'; }
          else if (v.stock <= 0) { btnAgregar.disabled = true; btnAgregar.textContent = 'Sin stock en esa combinación'; }
          else { btnAgregar.disabled = false; btnAgregar.textContent = 'Agregar al carrito'; }
        }
        if (precioEl) precioEl.textContent = formatearPrecio(v && v.precio != null ? v.precio : precioBase);
      }

      function resolverVariante() {
        if (tieneColor && tieneTalla) {
          return (colorSeleccionado && tallaSeleccionada)
            ? variantes.find(function (v) { return v.color === colorSeleccionado && v.talla === tallaSeleccionada; })
            : null;
        }
        if (tieneColor) return colorSeleccionado ? variantes.find(function (v) { return v.color === colorSeleccionado; }) : null;
        if (tieneTalla) return tallaSeleccionada ? variantes.find(function (v) { return v.talla === tallaSeleccionada; }) : null;
        return null; // sin Color/Talla: se resuelve directo con elegirVariante()
      }

      function elegirColor(color, foto) {
        colorSeleccionado = color;
        tallaSeleccionada = null;
        if (foto) {
          var principal = document.getElementById('foto-principal');
          if (principal) principal.src = foto;
          document.querySelectorAll('.miniaturas button').forEach(function (m) { m.classList.remove('activa'); });
        }
        pintarSwatches();
        pintarPills();
        aplicarVariante(resolverVariante());
      }

      function elegirTalla(talla) {
        tallaSeleccionada = talla;
        pintarPills();
        aplicarVariante(resolverVariante());
      }

      function elegirVariante(v) {
        pintarPills();
        aplicarVariante(v);
      }

      pintarSwatches();
      pintarPills();
      aplicarVariante(tieneColor || tieneTalla ? resolverVariante() : null);
    })();
  </script>
  <% } %>
</body>
</html>
