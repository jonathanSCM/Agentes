<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <main>
    <section class="section" style="padding-top:2.5rem">
      <div class="container">
        <header class="section-head reveal">
          <span class="eyebrow">Planes <%= categoria === 'PERSONAL' ? 'personales' : 'empresariales' %></span>
          <h2>Compará y elegí el plan que te queda mejor</h2>
          <p>Todos incluyen el agente de ventas por WhatsApp. La diferencia está en cuánto podés escalar.</p>
        </header>

        <div class="planes-switch reveal">
          <a href="/planes/personal" class="<%= categoria === 'PERSONAL' ? 'is-active' : '' %>">Planes personales</a>
          <a href="/planes/empresarial" class="<%= categoria === 'EMPRESARIAL' ? 'is-active' : '' %>">Planes empresariales</a>
        </div>

        <% if (!planes.length) { %>
          <p class="muted-text" style="margin-top:2rem">Todavía no hay planes activos en esta categoría.</p>
        <% } else { %>
          <div class="tabla-comparativa-wrap reveal">
            <table class="tabla-comparativa">
              <thead>
                <tr>
                  <th class="col-fila"></th>
                  <% planes.forEach(function (p) { %>
                    <th class="<%= p.recomendado ? 'col-reco' : '' %>">
                      <% if (p.recomendado) { %><span class="reco-tag">Recomendado</span><% } %>
                      <div class="tc-nombre"><%= p.nombre %></div>
                      <div class="tc-precio">
                        <span class="tc-cur"><%= simboloMoneda(p.precio.moneda) %></span>
                        <span class="tc-num"><%= p.precio.mensualidad.toLocaleString('es-BO') %></span>
                        <span class="tc-per">/mes</span>
                      </div>
                      <a class="btn <%= p.recomendado ? 'btn-primary' : 'btn-ghost' %>" href="/registro?plan=<%= p.id %>">
                        <%= p.precio.mensualidad === 0 ? 'Probar gratis' : 'Elegir plan' %>
                      </a>
                    </th>
                  <% }); %>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="col-fila">Conversaciones incluidas / mes</td>
                  <% planes.forEach(function (p) { %><td class="<%= p.recomendado ? 'col-reco' : '' %>"><%= p.convIncluidas.toLocaleString('es-BO') %></td><% }); %>
                </tr>
                <tr>
                  <td class="col-fila">Productos en el catálogo</td>
                  <% planes.forEach(function (p) { %><td class="<%= p.recomendado ? 'col-reco' : '' %>">Hasta <%= p.maxProductos.toLocaleString('es-BO') %></td><% }); %>
                </tr>
                <tr>
                  <td class="col-fila">Usuarios del panel</td>
                  <% planes.forEach(function (p) { %><td class="<%= p.recomendado ? 'col-reco' : '' %>"><%= p.maxUsuarios %></td><% }); %>
                </tr>
                <% todasCaracteristicas.forEach(function (c) { %>
                  <tr>
                    <td class="col-fila"><%= c.nombre %></td>
                    <% planes.forEach(function (p) { %>
                      <td class="<%= p.recomendado ? 'col-reco' : '' %> tc-check">
                        <% if (p.incluye.has(c.id)) { %>
                          <span class="tc-si" title="Incluido">✓</span>
                        <% } else { %>
                          <span class="tc-no" title="No incluido">✗</span>
                        <% } %>
                      </td>
                    <% }); %>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>

        <p class="muted-text" style="margin-top:1.5rem;font-size:.85rem">Los precios se muestran según tu país. ¿Tenés dudas sobre cuál elegir? <a href="<%= site.whatsappUrl %>" target="_blank" rel="noopener" style="color:var(--primary-2)">Escribinos por WhatsApp</a>.</p>
      </div>
    </section>
  </main>

  <style>
    .planes-switch { display: flex; gap: .6rem; margin: 1.2rem 0 2rem; flex-wrap: wrap; }
    .planes-switch a {
      padding: .55rem 1.1rem; border-radius: 999px; border: 1px solid var(--border);
      color: var(--muted); font-weight: 600; font-size: .9rem; background: var(--surface);
    }
    .planes-switch a.is-active { background: var(--primary); color: #fff; border-color: var(--primary); }
    .tabla-comparativa-wrap { overflow-x: auto; border-radius: var(--radius); border: 1px solid var(--border); }
    .tabla-comparativa { width: 100%; border-collapse: collapse; min-width: 560px; background: var(--surface); }
    .tabla-comparativa th, .tabla-comparativa td { padding: .9rem 1.1rem; border-bottom: 1px solid var(--border); text-align: center; vertical-align: middle; }
    .tabla-comparativa .col-fila { text-align: left; color: var(--muted); font-size: .88rem; white-space: nowrap; }
    .tabla-comparativa thead th { vertical-align: top; }
    .tabla-comparativa .col-reco { background: rgba(47, 227, 166, .07); }
    .tabla-comparativa .reco-tag {
      display: inline-block; background: var(--primary-2); color: #06231a; font-size: .68rem; font-weight: 700;
      padding: .15rem .55rem; border-radius: 999px; margin-bottom: .5rem;
    }
    .tc-nombre { font-family: var(--display); font-weight: 700; font-size: 1.05rem; margin-bottom: .4rem; }
    .tc-precio { margin-bottom: .8rem; }
    .tc-cur { font-size: .8rem; color: var(--muted); vertical-align: top; }
    .tc-num { font-family: var(--display); font-size: 1.4rem; font-weight: 700; }
    .tc-per { font-size: .78rem; color: var(--muted); }
    .tc-check { font-size: 1.1rem; }
    .tc-si { color: var(--primary-2); }
    .tc-no { color: var(--muted); opacity: .45; }
    @media (max-width: 640px) {
      .tabla-comparativa th, .tabla-comparativa td { padding: .7rem .8rem; font-size: .85rem; }
    }
  </style>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
