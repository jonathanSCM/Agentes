<%- include('partials/inicio') %>

<div class="page-head">
  <h2>Pedidos</h2>
  <p>Pedidos que registran tus clientes a través del agente.</p>
</div>

<% if (mensaje) { %><div class="alert-ok"><%= mensaje %></div><% } %>
<% if (errorEstado) { %><div class="alert-err"><%= errorEstado %></div><% } %>

<div class="admin-stats">
  <div class="stat-card"><span class="stat-num"><%= stats.total %></span><span class="stat-label">Pedidos</span></div>
  <div class="stat-card stat-new"><span class="stat-num"><%= stats.nuevos %></span><span class="stat-label">Nuevos</span></div>
  <div class="stat-card stat-done"><span class="stat-num"><%= simboloCatalogo %> <%= stats.total_bs.toLocaleString('es-BO') %></span><span class="stat-label">Total vendido</span></div>
</div>

<% if (pedidos.length === 0) { %>
  <div class="empty-state">
    <h3>Aún no hay pedidos</h3>
    <p>Cuando el agente cierre una venta con un cliente, el pedido aparecerá aquí para que lo gestiones.</p>
  </div>
<% } else { %>
  <div class="table-wrap">
    <table class="leads-table">
      <thead>
        <tr><th>Fecha</th><th>Cliente</th><th>Productos</th><th>Entrega</th><th class="num">Total</th><th>Estado</th><th>Acciones</th></tr>
      </thead>
      <tbody>
        <% pedidos.forEach(function (p) { %>
          <tr>
            <td class="nowrap muted"><%= new Date(p.createdAt).toLocaleDateString('es-BO') %></td>
            <td><%= p.cliente ? (p.cliente.nombre || p.cliente.telefono) : '—' %></td>
            <td><%= p.items.map(function(i){ return i.cantidad + 'x ' + i.nombre; }).join(', ') %></td>
            <td class="muted">
              <% if (p.tipoEntrega === 'RECOJO') { %>
                <span class="badge badge-done">Retira en tienda</span>
              <% } else { %>
                <%= p.direccionEntrega || '-' %>
                <% if (p.entregaLat && p.entregaLng) { %>
                  <a href="https://www.google.com/maps?q=<%= p.entregaLat %>,<%= p.entregaLng %>" target="_blank" rel="noopener" style="color:var(--primary-2)">Ver mapa</a>
                <% } %>
              <% } %>
            </td>
            <td class="num"><%= simboloCatalogo %> <%= Number(p.total).toFixed(2) %></td>
            <td><span class="badge <%= p.estado === 'ENTREGADO' ? 'badge-new' : (p.estado === 'CANCELADO' ? 'badge-off' : 'badge-done') %>"><%= p.estado %></span></td>
            <td class="actions-cell">
              <% if (p.estado === 'NUEVO') { %>
                <form method="POST" action="/panel/pedidos/<%= p.id %>/estado" class="inline-form">
                  <input type="hidden" name="estado" value="CONFIRMADO" />
                  <button class="btn btn-ghost" style="padding:.35rem .7rem;font-size:.82rem" type="submit">Confirmar</button>
                </form>
                <form method="POST" action="/panel/pedidos/<%= p.id %>/estado" class="inline-form"
                      onsubmit="return confirm('¿Cancelar este pedido? Se devolverá el stock descontado.');">
                  <input type="hidden" name="estado" value="CANCELADO" />
                  <button class="btn btn-ghost" style="padding:.35rem .7rem;font-size:.82rem" type="submit">Cancelar</button>
                </form>
              <% } else if (p.estado === 'CONFIRMADO') { %>
                <form method="POST" action="/panel/pedidos/<%= p.id %>/estado" class="inline-form">
                  <input type="hidden" name="estado" value="ENTREGADO" />
                  <button class="btn btn-ghost" style="padding:.35rem .7rem;font-size:.82rem" type="submit">Marcar entregado</button>
                </form>
                <form method="POST" action="/panel/pedidos/<%= p.id %>/estado" class="inline-form"
                      onsubmit="return confirm('¿Cancelar este pedido? Se devolverá el stock descontado.');">
                  <input type="hidden" name="estado" value="CANCELADO" />
                  <button class="btn btn-ghost" style="padding:.35rem .7rem;font-size:.82rem" type="submit">Cancelar</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('partials/fin') %>
