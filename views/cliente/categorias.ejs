<%- include('partials/inicio') %>

<div class="page-head">
  <h2>Categorías</h2>
  <p>Ordená tus productos en categorías, por ejemplo <strong>Calzado</strong>. Cada una puede tener tipos (Botas, Zapatillas…) para que tu cliente elija paso a paso y no reciba todo de golpe.</p>
</div>

<% if (mensaje) { %><div class="alert-ok"><%= mensaje %></div><% } %>
<% if (error) { %><div class="alert-err" role="alert"><%= error %></div><% } %>

<% if (!categorias.length) { %>
  <!-- Primer uso: dos caminos claros en vez de un formulario vacio -->
  <div class="cat-inicio">
    <form method="POST" action="/panel/categorias/plantilla" class="pf-card cat-camino">
      <input type="hidden" name="plantilla" value="ropa" />
      <h3>Vendo ropa o calzado</h3>
      <p class="muted">Te dejamos armado lo típico: Calzado (zapatillas, botas, zapatos…), Prendas de arriba, Prendas de abajo, Abrigos, Vestidos, Ropa deportiva, Ropa de baño y Accesorios. Después los ajustás a tu gusto.</p>
      <button class="btn btn-primary" type="submit">Cargar estas categorías</button>
    </form>

    <form method="POST" action="/panel/categorias" class="pf-card cat-camino">
      <h3>Prefiero armarlas yo</h3>
      <p class="muted">Empezá con la primera. Después le agregás tipos si hace falta.</p>
      <div class="field">
        <label for="nombre-inicial">Nombre de tu primera categoría</label>
        <input id="nombre-inicial" name="nombre" type="text" required maxlength="120" placeholder="Ej: Calzado" autocomplete="off" />
      </div>
      <button class="btn btn-ghost" type="submit">Crear categoría</button>
    </form>
  </div>
<% } else { %>
  <div class="table-wrap">
    <table class="leads-table">
      <thead><tr><th>Categoría</th><th>Tipos</th><th class="num">Productos</th><th>Acciones</th></tr></thead>
      <tbody>
        <% categorias.forEach(function (cat) { %>
          <tr>
            <td><a href="/panel/categorias/<%= cat.id %>" class="cat-nombre"><%= cat.nombre %></a></td>
            <td class="muted cat-tipos">
              <% if (cat.hijas.length) { %>
                <%= cat.hijas.map(function (h) { return h.nombre + ' (' + h._count.productos + ')'; }).join(' · ') %>
              <% } else { %>
                <span class="cat-sin-tipos">Sin tipos</span>
              <% } %>
            </td>
            <td class="num"><%= cat._count.productos + cat.hijas.reduce(function (n, h) { return n + h._count.productos; }, 0) %></td>
            <td class="actions-cell">
              <a class="btn btn-ghost btn-chico" href="/panel/categorias/<%= cat.id %>">Editar</a>
              <form method="POST" action="/panel/categorias/<%= cat.id %>/eliminar" class="inline-form"
                    onsubmit="return confirm('¿Eliminar esta categoría? También se eliminan sus tipos, y los productos que estaban en ella quedan sin categoría.');">
                <button class="btn btn-ghost btn-chico" type="submit">Eliminar</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <form method="POST" action="/panel/categorias" class="pf-card cat-nueva">
    <h3 class="pf-titulo">Agregar otra categoría</h3>
    <div class="field-row">
      <div class="field">
        <label for="nombre">Nombre</label>
        <input id="nombre" name="nombre" type="text" required maxlength="120" placeholder="Ej: Abrigos" autocomplete="off" />
      </div>
      <div class="field">
        <label for="padreId">¿Dónde va?</label>
        <select id="padreId" name="padreId">
          <option value="">Es una categoría nueva</option>
          <% categorias.forEach(function (cat) { %>
            <option value="<%= cat.id %>">Es un tipo dentro de “<%= cat.nombre %>”</option>
          <% }); %>
        </select>
      </div>
    </div>
    <p class="pf-ayuda">Si es un tipo (por ejemplo Botas dentro de Calzado), elegilo arriba. Si no, quedaría como una categoría más en el menú.</p>
    <div class="form-actions"><button class="btn btn-primary" type="submit">Agregar</button></div>
  </form>

  <details class="pf-mas cat-mas">
    <summary>Cargar las categorías típicas de una tienda de ropa</summary>
    <div class="pf-mas-cuerpo">
      <form method="POST" action="/panel/categorias/plantilla">
        <input type="hidden" name="plantilla" value="ropa" />
        <p class="muted">Agrega Calzado, Prendas de arriba, Abrigos y otras con sus tipos. <strong>No toca lo que ya tenés</strong> ni crea productos.</p>
        <button class="btn btn-ghost" type="submit">Cargar categorías sugeridas</button>
      </form>
    </div>
  </details>
<% } %>

<%- include('partials/fin') %>
