<%- include('partials/inicio') %>

<div class="page-head">
  <h2>Categorías</h2>
  <p>Cada categoría puede tener atributos obligatorios (el agente se los pregunta al cliente antes de recomendar, ej: Género, Talla). Entrá a una categoría para configurar los suyos.</p>
</div>

<% if (mensaje) { %><div class="alert-ok"><%= mensaje %></div><% } %>
<% if (error) { %><div class="alert-err"><%= error %></div><% } %>

<% if (!categorias.length) { %>
  <div class="empty-state">
    <h3>Todavía no hay categorías cargadas</h3>
    <p>Agregá la primera abajo. Después la vas a poder elegir al crear o editar un producto.</p>
  </div>
<% } else { %>
  <div class="table-wrap">
    <table class="leads-table">
      <thead><tr><th>Categoría</th><th class="num">Productos</th><th class="num">Atributos configurados</th><th>Acciones</th></tr></thead>
      <tbody>
        <% categorias.forEach(function (cat) { %>
          <tr>
            <td><a href="/panel/categorias/<%= cat.id %>" style="color:inherit;font-weight:600"><%= cat.nombre %></a></td>
            <td class="num"><%= cat._count.productos %></td>
            <td class="num"><%= cat._count.atributos %></td>
            <td class="actions-cell">
              <a class="btn btn-ghost" style="padding:.4rem .8rem;font-size:.85rem" href="/panel/categorias/<%= cat.id %>">Configurar</a>
              <form method="POST" action="/panel/categorias/<%= cat.id %>/eliminar" class="inline-form"
                    onsubmit="return confirm('¿Eliminar esta categoría? Los productos que la usan quedan sin categoría.');">
                <button class="btn btn-ghost" style="padding:.4rem .8rem;font-size:.85rem" type="submit">Eliminar</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<form method="POST" action="/panel/categorias" class="form-card" style="max-width:500px;margin-top:1.4rem">
  <h3 style="margin:0 0 1rem;font-size:.95rem">+ Agregar categoría nueva</h3>
  <div class="field">
    <label for="nombre">Nombre *</label>
    <input id="nombre" name="nombre" type="text" required maxlength="120" placeholder="Ej: Zapatillas deportivas" />
  </div>
  <div class="form-actions">
    <button class="btn btn-primary" type="submit">Agregar y configurar</button>
  </div>
</form>

<%- include('partials/fin') %>
