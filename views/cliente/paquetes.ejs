<%- include('partials/inicio') %>

<div class="page-head">
  <h2>Pedir más conversaciones</h2>
  <p>Sumá conversaciones a tu cuenta. Se usan cuando agotás las incluidas en tu plan. Hacés el pedido, nuestro equipo lo confirma y se cargan a tu saldo.</p>
</div>

<% if (mensaje) { %><div class="alert-ok"><%= mensaje %></div><% } %>
<% if (error) { %><div class="alert-err" role="alert"><%= error %></div><% } %>

<div class="gauge">
  <div class="gauge-top">
    <div>
      <span class="gauge-num"><%= consumo.ilimitado ? '∞' : consumo.totalDisponible.toLocaleString('es-BO') %></span>
      <span class="gauge-sub">conversaciones disponibles ahora</span>
    </div>
  </div>
</div>

<form method="POST" action="/panel/paquetes/pedir" class="form-card" id="formPedido">
  <h3>Tu pedido</h3>

  <% if (paquetes.length) { %>
    <div class="field">
      <label>Elegí una cantidad o escribí la tuya</label>
      <div class="buy-grid" style="grid-template-columns:repeat(auto-fill,minmax(150px,1fr))">
        <% paquetes.forEach(function (p) { %>
          <button type="button" class="buy-card" data-cantidad="<%= p.cantidad %>" style="text-align:left;cursor:pointer">
            <span class="buy-qty"><%= p.cantidad.toLocaleString('es-BO') %></span>
            <span class="buy-lbl">conversaciones</span>
            <span class="buy-unit">≈ <%= simboloMoneda(p.precio.moneda) %> <%= p.precio.precio.toFixed(2) %></span>
          </button>
        <% }); %>
      </div>
      <p class="muted" style="font-size:.8rem;margin:.4rem 0 0">Los precios son una referencia: el monto final lo confirma nuestro equipo.</p>
    </div>
  <% } %>

  <div class="field">
    <label for="cantidad">Cantidad de conversaciones *</label>
    <input id="cantidad" name="cantidad" type="number" required min="<%= minimo %>" max="1000000" step="1" value="<%= (datos && datos.cantidad) || '' %>" placeholder="Ej: 1000" />
  </div>
  <div class="field">
    <label for="nota">Nota para nuestro equipo *</label>
    <textarea id="nota" name="nota" rows="3" required minlength="5" maxlength="500" placeholder="Ej: Voy a pagar por transferencia hoy a las 15:00. Te mando el comprobante por WhatsApp."><%= (datos && datos.nota) || '' %></textarea>
    <p class="muted" style="font-size:.8rem;margin:.3rem 0 0">Contanos cómo vas a pagar. Las conversaciones se cargan apenas confirmemos tu pago.</p>
  </div>
  <div class="form-actions"><button class="btn btn-primary" type="submit">Enviar pedido</button></div>
</form>

<div class="page-head"><h2 style="font-size:1.2rem" id="historial">Mis pedidos</h2></div>
<% if (!solicitudes.length) { %>
  <p class="muted">Todavía no hiciste pedidos.</p>
<% } else { %>
  <div class="table-wrap">
    <table class="leads-table">
      <thead><tr><th>Fecha</th><th class="num">Pedido</th><th>Estado</th><th>Respuesta</th></tr></thead>
      <tbody>
        <% solicitudes.forEach(function (s) { %>
          <tr>
            <td class="nowrap muted"><%= new Date(s.createdAt).toLocaleDateString('es-BO') %></td>
            <td class="num"><%= s.cantidad.toLocaleString('es-BO') %><%= s.estado === 'APROBADA' && s.cantidadAprobada !== s.cantidad ? ' (cargadas ' + s.cantidadAprobada.toLocaleString('es-BO') + ')' : '' %></td>
            <td><span class="badge <%= s.estado === 'APROBADA' ? 'badge-new' : (s.estado === 'RECHAZADA' ? 'badge-off' : 'badge-done') %>"><%= s.estado === 'PENDIENTE' ? 'Esperando confirmación' : (s.estado === 'APROBADA' ? 'Cargado' : 'Rechazado') %></span></td>
            <td class="muted"><%= s.respuesta || '' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<p class="muted" style="margin-top:1.4rem;font-size:.88rem">
  Las conversaciones extra se consumen solo después de agotar las incluidas en tu plan.
</p>

<script>
  (function () {
    var entrada = document.getElementById('cantidad');
    Array.prototype.slice.call(document.querySelectorAll('[data-cantidad]')).forEach(function (b) {
      b.addEventListener('click', function () { entrada.value = b.getAttribute('data-cantidad'); entrada.focus(); });
    });
  })();
</script>

<%- include('partials/fin') %>
