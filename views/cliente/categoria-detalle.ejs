<%- include('partials/inicio') %>
<%
  var inputStyle = 'background:transparent;border:1px solid rgba(255,255,255,.15);border-radius:8px;padding:.35rem .5rem;color:inherit;font:inherit;font-size:.85rem';
  var rubrosDisp = typeof rubrosDisponibles !== 'undefined' ? rubrosDisponibles : [];
  var esTipo = Boolean(categoria.padre);
%>

<div class="page-head">
  <p class="cat-volver">
    <% if (esTipo) { %>
      <a href="/panel/categorias/<%= categoria.padre.id %>">← <%= categoria.padre.nombre %></a>
    <% } else { %>
      <a href="/panel/categorias">← Todas las categorías</a>
    <% } %>
  </p>
  <h2><%= categoria.nombre %>
    <span class="badge badge-off"><%= esTipo ? 'Tipo de ' + categoria.padre.nombre : 'Categoría' %></span>
  </h2>
</div>

<% if (mensaje) { %><div class="alert-ok"><%= mensaje %></div><% } %>
<% if (error) { %><div class="alert-err" role="alert"><%= error %></div><% } %>

<!-- Nombre y foto -->
<form method="POST" action="/panel/categorias/<%= categoria.id %>" id="editar-categoria" class="pf-card cat-form" enctype="multipart/form-data">
  <div class="field">
    <label for="nombre">Nombre</label>
    <input id="nombre" name="nombre" type="text" value="<%= categoria.nombre %>" maxlength="120" />
  </div>
  <div class="field">
    <label for="imagen">Foto (opcional)</label>
    <p class="pf-ayuda">Se la mostramos al cliente cuando pregunta por “<%= categoria.nombre %>”, junto con cuántos modelos hay y desde qué precio. Sin foto, recibe el mismo mensaje sin imagen.</p>
    <% if (categoria.imagenUrl) { %>
      <div class="pf-fotos"><img src="<%= categoria.imagenUrl %>" alt="Foto actual de la categoría" style="width:120px;height:80px" /></div>
      <label class="pf-check"><input type="checkbox" name="quitarImagen" value="1" /> Quitar la foto actual</label>
    <% } %>
    <input id="imagen" name="imagen" type="file" accept="image/*" />
  </div>
  <div class="form-actions">
    <button class="btn btn-primary" type="submit">Guardar cambios</button>
  </div>
</form>

<% if (!esTipo) { %>
  <!-- Tipos -->
  <section class="pf-card cat-seccion">
    <h3 class="pf-titulo">Tipos dentro de “<%= categoria.nombre %>”</h3>
    <p class="pf-ayuda">
      Cuando el cliente elige esta categoría, le ofrecemos esta lista y recién después le mostramos productos.
      Si no agregás tipos, pasa directo a los productos.
    </p>

    <% if (categoria.hijas && categoria.hijas.length) { %>
      <div class="table-wrap">
        <table class="leads-table">
          <thead><tr><th>Tipo</th><th class="num">Productos</th><th>Acciones</th></tr></thead>
          <tbody>
            <% categoria.hijas.forEach(function (h) { %>
              <tr>
                <td><a href="/panel/categorias/<%= h.id %>" class="cat-nombre"><%= h.nombre %></a></td>
                <td class="num"><%= h._count.productos %></td>
                <td class="actions-cell">
                  <a class="btn btn-ghost btn-chico" href="/panel/categorias/<%= h.id %>">Editar</a>
                  <form method="POST" action="/panel/categorias/<%= h.id %>/eliminar" class="inline-form"
                        onsubmit="return confirm('¿Eliminar este tipo? Sus productos quedan sin categoría.');">
                    <button class="btn btn-ghost btn-chico" type="submit">Eliminar</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>

    <form method="POST" action="/panel/categorias/<%= categoria.id %>/subcategorias" class="cat-agregar-tipo">
      <div class="field">
        <label for="nuevo-tipo">Agregar un tipo</label>
        <input id="nuevo-tipo" name="nombre" type="text" maxlength="120" required placeholder="Ej: Botas" autocomplete="off" />
      </div>
      <button class="btn btn-ghost" type="submit">+ Agregar</button>
    </form>
  </section>
<% } %>

<!-- Datos que le pregunta el agente al cliente (avanzado) -->
<details class="pf-mas cat-mas">
  <summary>Qué le pregunta el agente al cliente <em>(avanzado<%= categoria.atributos.length ? ' · ' + categoria.atributos.length + ' configurado' + (categoria.atributos.length === 1 ? '' : 's') : '' %>)</em></summary>
  <div class="pf-mas-cuerpo">
    <p class="pf-ayuda">
      Podés pedirle al agente que averigüe un dato antes de recomendar productos de esta categoría (por ejemplo el género en una tienda de ropa).
      Elegí qué tan importante es cada uno:
    </p>
    <ul class="cat-niveles">
      <li><strong>Obligatorio</strong>: no muestra ningún producto hasta saberlo.</li>
      <li><strong>Recomendado</strong>: lo pregunta si la charla da pie, pero no frena la búsqueda.</li>
      <li><strong>Opcional</strong>: solo lo usa si el cliente lo menciona.</li>
    </ul>
    <p class="pf-ayuda">Los datos que marques “de opciones” (talla, color) nunca frenan la venta, ni siquiera en Obligatorio: el cliente los elige en la tarjeta del producto. Si un dato tiene que frenar la venta (ej. género), no lo marques así.</p>

    <% if (categoria.atributos.length) { %>
      <div class="table-wrap">
        <table class="leads-table">
          <thead><tr><th>Orden</th><th>Dato</th><th>Importancia</th><th>De opciones (talla/color)</th><th>¿Frena la venta?</th><th>Acciones</th></tr></thead>
          <tbody>
            <% categoria.atributos.forEach(function (a) { %>
              <% var formAtr = 'editar-atributo-' + a.id; %>
              <tr>
                <td><input form="<%= formAtr %>" name="orden" type="number" value="<%= a.orden %>" style="width:60px;<%= inputStyle %>" aria-label="Orden" /></td>
                <td><input form="<%= formAtr %>" name="nombre" type="text" value="<%= a.nombre %>" style="width:100%;min-width:160px;<%= inputStyle %>" aria-label="Nombre del dato" /></td>
                <td>
                  <select form="<%= formAtr %>" name="nivel" class="js-nivel-bloqueo" data-badge="bloqueo-<%= a.id %>" style="<%= inputStyle %>" aria-label="Importancia">
                    <% ['OBLIGATORIO','RECOMENDADO','OPCIONAL'].forEach(function (n) { %>
                      <option value="<%= n %>" <%= a.nivel === n ? 'selected' : '' %>><%= n.charAt(0) + n.slice(1).toLowerCase() %></option>
                    <% }); %>
                  </select>
                </td>
                <td><input form="<%= formAtr %>" name="esDeVariante" type="checkbox" value="1" class="js-variante-bloqueo" data-badge="bloqueo-<%= a.id %>" <%= a.esDeVariante ? 'checked' : '' %> aria-label="Es de opciones" /></td>
                <td><span id="bloqueo-<%= a.id %>" class="badge"></span></td>
                <td class="actions-cell">
                  <button form="<%= formAtr %>" class="btn btn-ghost btn-chico" type="submit">Guardar</button>
                  <form method="POST" action="/panel/categorias/<%= categoria.id %>/atributos/<%= a.id %>/eliminar" class="inline-form"
                        onsubmit="return confirm('¿Quitar este dato de la categoría?');">
                    <button class="btn btn-ghost btn-chico" type="submit">Quitar</button>
                  </form>
                </td>
              </tr>
              <form id="<%= formAtr %>" method="POST" action="/panel/categorias/<%= categoria.id %>/atributos/<%= a.id %>"></form>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="muted">Todavía no configuraste ninguno. No hace falta: el agente funciona igual.</p>
    <% } %>

    <datalist id="atributos-sugeridos">
      <option value="Genero"></option><option value="Talla"></option><option value="Color"></option>
      <option value="Marca"></option><option value="Material"></option><option value="Uso"></option><option value="Estilo"></option>
    </datalist>

    <form method="POST" action="/panel/categorias/<%= categoria.id %>/atributos" class="field-row cat-nuevo-dato">
      <div class="field">
        <label for="nuevo-dato">Nuevo dato</label>
        <input id="nuevo-dato" list="atributos-sugeridos" name="nombre" type="text" maxlength="60" required placeholder="Ej: Genero" />
      </div>
      <div class="field">
        <label for="nuevo-nivel">Importancia</label>
        <select id="nuevo-nivel" name="nivel" class="js-nivel-bloqueo" data-badge="bloqueo-nuevo">
          <option value="OPCIONAL">Opcional</option>
          <option value="RECOMENDADO">Recomendado</option>
          <option value="OBLIGATORIO">Obligatorio</option>
        </select>
      </div>
      <input type="hidden" name="orden" value="0" />
      <label class="pf-check"><input type="checkbox" name="esDeVariante" value="1" class="js-variante-bloqueo" data-badge="bloqueo-nuevo" /> De opciones (talla/color)</label>
      <span id="bloqueo-nuevo" class="badge"></span>
      <button class="btn btn-ghost" type="submit">+ Agregar dato</button>
    </form>
  </div>
</details>

<!-- Cambiar de lugar -->
<details class="pf-mas cat-mas">
  <summary>Cambiar de lugar <em>(opcional)</em></summary>
  <div class="pf-mas-cuerpo">
    <form method="POST" action="/panel/categorias/<%= categoria.id %>/mover">
      <div class="field">
        <label for="padreId">Esta <%= esTipo ? 'está dentro de' : 'categoría puede ir dentro de' %></label>
        <select id="padreId" name="padreId">
          <option value="">Ninguna: es una categoría principal</option>
          <% rubrosDisp.forEach(function (r) { %>
            <option value="<%= r.id %>" <%= categoria.padreId === r.id ? 'selected' : '' %>><%= r.nombre %></option>
          <% }); %>
        </select>
        <p class="pf-ayuda">Si queda como categoría principal, aparece en el primer menú que ve el cliente.</p>
      </div>
      <button class="btn btn-ghost" type="submit">Mover</button>
    </form>
  </div>
</details>

<script>
  // Mismo criterio que usa el motor (agente.js: atributosFaltantes) y el
  // backend al guardar un producto (server.js: atributosObligatoriosFaltantes):
  // un atributo "de variante" NUNCA bloquea, ni siquiera en Obligatorio. Esto
  // solo hace visible esa regla en el momento de configurarla - antes no
  // habia ninguna señal y por eso un negocio real marco "Genero" como
  // variante pensando que igual iba a frenar la venta.
  (function () {
    function actualizar(badgeId) {
      var badge = document.getElementById(badgeId);
      if (!badge) return;
      var nivelSel = document.querySelector('.js-nivel-bloqueo[data-badge="' + badgeId + '"]');
      var varianteChk = document.querySelector('.js-variante-bloqueo[data-badge="' + badgeId + '"]');
      var esObligatorio = nivelSel && nivelSel.value === 'OBLIGATORIO';
      var esVariante = varianteChk && varianteChk.checked;
      badge.className = 'badge';
      if (esObligatorio && !esVariante) {
        badge.classList.add('badge-new');
        badge.textContent = '🔒 Frena hasta saberlo';
      } else if (esObligatorio && esVariante) {
        badge.classList.add('badge-alerta');
        badge.textContent = '⚠️ No frena (es de opciones)';
      } else {
        badge.classList.add('badge-off');
        badge.textContent = 'No frena';
      }
    }
    var badgeIds = new Set();
    document.querySelectorAll('[data-badge]').forEach(function (el) { badgeIds.add(el.getAttribute('data-badge')); });
    badgeIds.forEach(function (id) {
      actualizar(id);
      document.querySelectorAll('[data-badge="' + id + '"]').forEach(function (el) {
        el.addEventListener('change', function () { actualizar(id); });
      });
    });
  })();
</script>

<%- include('partials/fin') %>
