<%- include('partials/inicio') %>

<div class="page-head">
  <h2>Hola, <%= empresaNombre %></h2>
  <p>Resumen de hoy · <%= new Date().toLocaleDateString('es-BO', { weekday: 'long', day: 'numeric', month: 'long' }) %></p>
</div>

<% if (avisoSaldo) { %>
  <div class="alert-err">
    <%= avisoSaldo %> <a href="/panel/paquetes" style="color:var(--primary-2)">Pedir conversaciones</a>
  </div>
<% } %>

<%# Menu principal por modulos: lo que incluye el plan y lo que se puede sumar %>
<%
  var hubModulos = [
    { clave: 'AGENTE', nombre: 'Agente de ventas', texto: 'Atiende a tus clientes por WhatsApp, toma pedidos y reserva citas.', href: '/panel/conversaciones', boton: 'Abrir conversaciones',
      icono: '<rect x="4" y="7" width="16" height="12" rx="3"/><path d="M12 7V3M9 12h.01M15 12h.01"/>' },
    { clave: 'POS', nombre: 'Punto de venta', texto: 'Caja, ventas, recibos, impresora térmica y lector de códigos en el mostrador.', href: '/panel/pos', boton: 'Abrir el punto de venta',
      icono: '<path d="M4 5h16l-1.5 9h-13L4 5Z"/><path d="M4 5 3 2H1"/><circle cx="9" cy="19" r="1.4"/><circle cx="17" cy="19" r="1.4"/>' }
  ];
  if (modeloNegocio !== 'CITAS') hubModulos.push({ clave: 'PANEL', nombre: 'Panel comercial', texto: 'Ventas, utilidad y margen, canal WhatsApp vs mostrador, reportes con Excel.', href: '/panel/reportes', boton: 'Abrir reportes',
    icono: '<path d="M4 19h16M6 16V9m6 7V5m6 11v-4"/>' });
%>
<section class="modulos-hub" aria-label="Módulos de tu plan">
  <% hubModulos.forEach(function (m) { var incluido = modulos.indexOf(m.clave) !== -1; %>
    <article class="modulo-card <%= incluido ? 'es-activo' : 'es-bloqueado' %>">
      <span class="modulo-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><%- incluido || m.clave === 'POS' ? m.icono : '<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>' %></svg></span>
      <div class="modulo-texto">
        <strong><%= m.nombre %></strong>
        <p><%= m.texto %></p>
      </div>
      <% if (incluido && m.href) { %>
        <a class="btn btn-ghost" href="<%= m.href %>"><%= m.boton %></a>
      <% } else if (incluido) { %>
        <span class="badge badge-done">Próximamente</span>
      <% } else { %>
        <a class="btn btn-ghost" href="<%= m.href || '/panel/consumo' %>">No está en tu plan</a>
      <% } %>
    </article>
  <% }); %>
</section>

<% if (!primerosPasos.completo) { %>
  <!-- Primeros pasos: solo mientras falte alguno. El siguiente pendiente es el
       unico con boton principal, para que sea obvio por donde seguir. -->
  <section class="pasos-card" aria-labelledby="pasos-titulo">
    <div class="pasos-head">
      <div>
        <h3 id="pasos-titulo">Pongamos tu agente a vender</h3>
        <p class="muted">Te faltan <%= primerosPasos.total - primerosPasos.hechos %> paso<%= primerosPasos.total - primerosPasos.hechos === 1 ? '' : 's' %>. Llevan unos minutos.</p>
      </div>
      <span class="pasos-contador"><%= primerosPasos.hechos %> de <%= primerosPasos.total %></span>
    </div>
    <div class="bar-lg"><span style="width:<%= Math.round(primerosPasos.hechos / primerosPasos.total * 100) %>%"></span></div>
    <ol class="pasos-lista">
      <% primerosPasos.pasos.forEach(function (p) { %>
        <li class="paso <%= p.hecho ? 'paso-hecho' : (primerosPasos.siguiente && primerosPasos.siguiente.clave === p.clave ? 'paso-actual' : '') %>">
          <span class="paso-marca" aria-hidden="true"><%= p.hecho ? '✓' : '' %></span>
          <div class="paso-texto">
            <strong><%= p.titulo %></strong>
            <% if (!p.hecho) { %><span class="muted"><%= p.detalle %></span><% } %>
          </div>
          <% if (!p.hecho) { %>
            <a class="btn <%= primerosPasos.siguiente && primerosPasos.siguiente.clave === p.clave ? 'btn-primary' : 'btn-ghost' %>" href="<%= p.href %>"><%= p.boton %></a>
          <% } %>
        </li>
      <% }); %>
    </ol>
    <p class="pasos-recorrido">¿Preferís un paseo por el panel? <button type="button" class="pf-link" id="btn-recorrido">Ver el recorrido</button></p>
  </section>
  <script>
    (function () {
      var b = document.getElementById('btn-recorrido');
      var ayuda = document.getElementById('tourAyudaBtn');
      if (b && ayuda) b.addEventListener('click', function () { ayuda.click(); });
    })();
  </script>
<% } %>

<!-- KPIs del día -->
<div class="admin-stats">
  <div class="stat-card">
    <span class="stat-num"><%= kpi.clientesHoy %></span>
    <span class="stat-label">Clientes que escribieron hoy</span>
  </div>
  <div class="stat-card stat-new">
    <span class="stat-num"><%= kpi.pedidosHoy %></span>
    <span class="stat-label">Pedidos de hoy</span>
  </div>
  <div class="stat-card stat-done">
    <span class="stat-num"><%= simboloCatalogo %> <%= kpi.ventasHoy.toLocaleString('es-BO') %></span>
    <span class="stat-label">Vendido hoy</span>
  </div>
  <div class="stat-card">
    <span class="stat-num"><%= kpi.resueltasIA %>%</span>
    <span class="stat-label">Resuelto por la IA</span>
  </div>
</div>

<div class="dash-grid">
  <!-- Atención humana -->
  <div class="dash-card">
    <div class="dash-card-head">
      <h3>Necesitan atención humana</h3>
      <a href="/panel/conversaciones">Ver todas</a>
    </div>
    <% if (atencion.length === 0) { %>
      <p class="dash-empty">Todo bajo control. La IA está respondiendo.</p>
    <% } else { %>
      <ul class="dash-list">
        <% atencion.forEach(function (c) { %>
          <li>
            <span><%= c.telefonoCliente %></span>
            <span class="muted"><%= new Date(c.ultimoMensajeAt).toLocaleString('es-BO', { hour:'2-digit', minute:'2-digit' }) %></span>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </div>

  <!-- Stock bajo -->
  <div class="dash-card">
    <div class="dash-card-head">
      <h3>Productos con poco stock</h3>
      <a href="/panel/inventario">Ver inventario</a>
    </div>
    <% if (stockBajo.length === 0) { %>
      <p class="dash-empty">Ningún producto en riesgo de agotarse.</p>
    <% } else { %>
      <ul class="dash-list">
        <% stockBajo.forEach(function (p) { %>
          <li>
            <span><%= p.nombre %></span>
            <span class="badge <%= p.stockMostrado === 0 ? 'badge-off' : 'badge-star' %>"><%= p.stockMostrado %> unid.</span>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </div>

  <!-- Consumo rápido -->
  <div class="dash-card">
    <div class="dash-card-head">
      <h3>Tu saldo</h3>
      <a href="/panel/consumo">Ver detalle</a>
    </div>
    <div style="text-align:center;padding:.5rem 0">
      <div class="gauge-num" style="font-size:2.2rem"><%= consumo.ilimitado ? 'Ilimitadas' : consumo.totalDisponible.toLocaleString('es-BO') %></div>
      <span class="gauge-sub">conversaciones disponibles</span>
      <div class="bar-lg" style="margin-top:.8rem">
        <span class="<%= consumo.porcentajeUsado >= 100 ? 'bar-full' : (consumo.porcentajeUsado >= 80 ? 'bar-alert' : '') %>"
              style="width:<%= consumo.porcentajeUsado %>%"></span>
      </div>
      <span class="muted" style="font-size:.82rem"><%= consumo.ilimitado ? 'Tu plan no tiene tope de conversaciones' : 'Usaste ' + consumo.porcentajeUsado + '% de tu plan' %></span>
    </div>
  </div>

  <!-- Ventas por anuncios: atribucion automatica via Click to WhatsApp de Meta -->
  <div class="dash-card">
    <div class="dash-card-head">
      <h3>Ventas desde anuncios</h3>
      <a href="/panel/reportes">Ver detalle</a>
    </div>
    <% if (ventasAnuncios.cantidad === 0) { %>
      <p class="dash-empty">Todavía no detectamos ventas desde un anuncio. En cuanto un cliente te escriba desde un anuncio de Meta (Click to WhatsApp), aparecerán acá solas.</p>
    <% } else { %>
      <div style="text-align:center;padding:.5rem 0">
        <div class="gauge-num" style="font-size:2.2rem"><%= ventasAnuncios.cantidad %></div>
        <span class="gauge-sub">ventas desde un anuncio en los últimos 30 días</span>
        <p class="muted" style="font-size:.82rem;margin-top:.4rem"><%= simboloCatalogo %> <%= ventasAnuncios.total.toFixed(2) %> en total</p>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/fin') %>
