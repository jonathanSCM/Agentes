<%- include('partials/inicio') %>

<%
  const EXPLICACION_ESTADO = {
    PRUEBA: 'Estás usando el agente sin haber pagado todavía. Podés probarlo con tu catálogo real, pero para que quede activo de forma permanente falta confirmar el primer pago.',
    ACTIVA: 'Tu plan está al día: el agente atiende con normalidad.',
    MOROSA: 'Tu período venció y el pago aún no se confirmó: el agente dejó de responder hasta que se regularice.',
    CANCELADA: 'Tu suscripción está cancelada: el agente no atiende.',
  };
%>
<div class="page-head">
  <h2>Mi consumo</h2>
  <p>Plan <strong><%= valores.planNombre %></strong> · estado
    <span class="badge <%= suscripcion.estado === 'ACTIVA' ? 'badge-new' : (suscripcion.estado === 'PRUEBA' ? 'badge-done' : 'badge-off') %>"><%= suscripcion.estado %></span>
  </p>
  <p class="muted" style="font-size:.88rem;max-width:60ch"><%= EXPLICACION_ESTADO[suscripcion.estado] || '' %></p>
</div>

<% if (mensaje) { %><div class="alert-ok"><%= mensaje %></div><% } %>

<% if (valores.vigencia.estado === 'POR_VENCER') { %>
  <div class="alert-err">
    <%= suscripcion.estado === 'PRUEBA' ? 'Tu prueba gratis' : 'Tu plan' %> vence el <strong><%= new Date(valores.planFin).toLocaleDateString('es-BO') %></strong>
    (faltan <%= valores.vigencia.diasRestantes %> días). Pedí la renovación a tiempo para que tu agente no deje de atender.
  </div>
<% } else if (valores.vigencia.estado === 'GRACIA') { %>
  <div class="alert-err">
    Tu plan venció el <strong><%= new Date(valores.planFin).toLocaleDateString('es-BO') %></strong>. Tenés hasta el
    <strong><%= new Date(valores.vigencia.graciaHasta).toLocaleDateString('es-BO') %></strong> con todo funcionando; después tu agente deja de atender hasta que se renueve.
  </div>
<% } %>
<% if (suscripcion.estado === 'MOROSA') { %>
  <div class="alert-err">
    Tu período venció y tu agente <strong>dejó de responder</strong>. Coordina el pago de la mensualidad con nuestro equipo para reactivarlo.
  </div>
<% } %>

<!-- Medidor principal -->
<div class="gauge">
  <div class="gauge-top">
    <div>
      <span class="gauge-num"><%= consumo.totalDisponible.toLocaleString('es-BO') %></span>
      <span class="gauge-sub">conversaciones disponibles</span>
    </div>
    <span class="gauge-sub">
      Del plan: <strong><%= consumo.incluidasUsadas.toLocaleString('es-BO') %></strong> de
      <strong><%= consumo.ilimitado ? 'Ilimitado' : consumo.incluidasTotal.toLocaleString('es-BO') %></strong> usadas<% if (!consumo.ilimitado) { %> (<%= consumo.porcentajeUsado %>%)<% } %>
    </span>
  </div>
  <div class="bar-lg">
    <span class="<%= consumo.porcentajeUsado >= 100 ? 'bar-full' : (consumo.porcentajeUsado >= 80 ? 'bar-alert' : '') %>"
          style="width:<%= consumo.porcentajeUsado %>%"></span>
  </div>
</div>

<% if (consumo.incluidasDisponibles === 0 && consumo.extraDisponible === 0) { %>
  <div class="alert-err">
    <strong>Te quedaste sin conversaciones.</strong> Tu agente dejó de atender.
    <a href="/panel/paquetes" style="color:var(--primary-2)">Compra un paquete</a> para reactivarlo.
  </div>
<% } else if (consumo.porcentajeUsado >= 80 && consumo.extraDisponible === 0) { %>
  <div class="alert-err">
    Ya usaste el <%= consumo.porcentajeUsado %>% de tu plan.
    <a href="/panel/paquetes" style="color:var(--primary-2)">Compra un paquete</a> para no quedarte sin servicio.
  </div>
<% } %>

<div class="admin-stats">
  <div class="stat-card"><span class="stat-num"><%= consumo.ilimitado ? 'Sin tope' : consumo.incluidasDisponibles.toLocaleString('es-BO') %></span><span class="stat-label">Del plan (este mes)</span></div>
  <div class="stat-card stat-new"><span class="stat-num"><%= consumo.extraDisponible.toLocaleString('es-BO') %></span><span class="stat-label">Saldo de paquetes (de <%= consumo.extraComprado.toLocaleString('es-BO') %> comprados)</span></div>
  <div class="stat-card stat-done"><span class="stat-num"><%= consumo.paquetesVigentes %></span><span class="stat-label">Paquetes vigentes</span></div>
  <div class="stat-card"><span class="stat-num"><%= valores.planFin ? new Date(valores.planFin).toLocaleDateString('es-BO') : 'Sin fecha' %></span><span class="stat-label">Vence el</span></div>
</div>

<div class="page-head"><h2 style="font-size:1.2rem">Mi plan</h2></div>
<div class="table-wrap">
  <table class="leads-table">
    <tbody>
      <tr><td>Plan</td><td><strong><%= valores.planNombre %></strong></td></tr>
      <tr><td>Módulos</td><td><%= valores.modulos.map(function (m) { return nombresModulo[m] || m; }).join(' + ') %></td></tr>
      <tr><td>Vigencia</td><td><%= valores.planInicio ? new Date(valores.planInicio).toLocaleDateString('es-BO') : '—' %> → <%= valores.planFin ? new Date(valores.planFin).toLocaleDateString('es-BO') : 'sin vencimiento' %></td></tr>
      <tr><td>Conversaciones incluidas</td><td><%= valores.limites.convIncluidas === null ? 'Ilimitadas' : valores.limites.convIncluidas.toLocaleString('es-BO') + ' por mes' %></td></tr>
      <tr><td>Productos permitidos</td><td><%= topeTexto(valores.limites.maxProductos) %></td></tr>
      <tr><td>Usuarios permitidos</td><td><%= topeTexto(valores.limites.maxUsuarios) %></td></tr>
    </tbody>
  </table>
</div>

<p style="margin-top:1.2rem;display:flex;gap:.6rem;flex-wrap:wrap"><a class="btn btn-primary" href="/panel/plan">Cambiar de plan</a> <a class="btn btn-ghost" href="/panel/paquetes">Pedir más conversaciones</a></p>

<%- include('partials/fin') %>
