<%- include('partials/inicio') %>

<%
  const EXPLICACION_ESTADO = {
    PRUEBA: 'Estás usando el agente sin haber pagado todavía. Podés probarlo con tu catálogo real, pero para que quede activo de forma permanente falta confirmar el primer pago.',
    ACTIVA: 'Tu plan está al día: el agente atiende con normalidad.',
    MOROSA: 'Tu período venció y el pago aún no se confirmó: el agente dejó de responder hasta que se regularice.',
    CANCELADA: 'Tu suscripción está cancelada: el agente no atiende.',
  };
%>
<div class="page-head">
  <h2>Mi consumo</h2>
  <p>Plan <strong><%= plan.nombre %></strong> · estado
    <span class="badge <%= suscripcion.estado === 'ACTIVA' ? 'badge-new' : (suscripcion.estado === 'PRUEBA' ? 'badge-done' : 'badge-off') %>"><%= suscripcion.estado %></span>
  </p>
  <p class="muted" style="font-size:.88rem;max-width:60ch"><%= EXPLICACION_ESTADO[suscripcion.estado] || '' %></p>
</div>

<% if (mensaje) { %><div class="alert-ok"><%= mensaje %></div><% } %>

<% if (suscripcion.estado === 'PRUEBA' && Number(plan.mensualidadBs) > 0) { %>
  <div class="alert-err">
    Tu cuenta está en <strong>prueba</strong>. Para activarla, coordina el primer pago de
    <strong>Bs <%= Number(plan.primerPagoBs).toLocaleString('es-BO') %></strong>
    (implementación + primera mensualidad) con nuestro equipo.
  </div>
<% } %>
<% if (suscripcion.estado === 'MOROSA') { %>
  <div class="alert-err">
    Tu período venció y tu agente <strong>dejó de responder</strong>. Coordina el pago de la mensualidad con nuestro equipo para reactivarlo.
  </div>
<% } %>

<!-- Medidor principal -->
<div class="gauge">
  <div class="gauge-top">
    <div>
      <span class="gauge-num"><%= consumo.totalDisponible.toLocaleString('es-BO') %></span>
      <span class="gauge-sub">conversaciones disponibles</span>
    </div>
    <span class="gauge-sub">
      Del plan: <strong><%= consumo.incluidasUsadas.toLocaleString('es-BO') %></strong> de
      <strong><%= consumo.incluidasTotal.toLocaleString('es-BO') %></strong> usadas (<%= consumo.porcentajeUsado %>%)
    </span>
  </div>
  <div class="bar-lg">
    <span class="<%= consumo.porcentajeUsado >= 100 ? 'bar-full' : (consumo.porcentajeUsado >= 80 ? 'bar-alert' : '') %>"
          style="width:<%= consumo.porcentajeUsado %>%"></span>
  </div>
</div>

<% if (consumo.incluidasDisponibles === 0 && consumo.extraDisponible === 0) { %>
  <div class="alert-err">
    <strong>Te quedaste sin conversaciones.</strong> Tu agente dejó de atender.
    <a href="/panel/paquetes" style="color:var(--primary-2)">Compra un paquete</a> para reactivarlo.
  </div>
<% } else if (consumo.porcentajeUsado >= 80 && consumo.extraDisponible === 0) { %>
  <div class="alert-err">
    Ya usaste el <%= consumo.porcentajeUsado %>% de tu plan.
    <a href="/panel/paquetes" style="color:var(--primary-2)">Compra un paquete</a> para no quedarte sin servicio.
  </div>
<% } %>

<div class="admin-stats">
  <div class="stat-card"><span class="stat-num"><%= consumo.incluidasDisponibles.toLocaleString('es-BO') %></span><span class="stat-label">Del plan (este mes)</span></div>
  <div class="stat-card stat-new"><span class="stat-num"><%= consumo.extraDisponible.toLocaleString('es-BO') %></span><span class="stat-label">Saldo de paquetes (de <%= consumo.extraComprado.toLocaleString('es-BO') %> comprados)</span></div>
  <div class="stat-card stat-done"><span class="stat-num"><%= consumo.paquetesVigentes %></span><span class="stat-label">Paquetes vigentes</span></div>
  <div class="stat-card"><span class="stat-num"><%= new Date(suscripcion.periodoFin).toLocaleDateString('es-BO') %></span><span class="stat-label">Renueva el</span></div>
</div>

<div class="page-head"><h2 style="font-size:1.2rem">Mi plan</h2></div>
<div class="table-wrap">
  <table class="leads-table">
    <tbody>
      <tr><td>Plan</td><td><strong><%= plan.nombre %></strong></td></tr>
      <tr><td>Mensualidad</td><td>Bs <%= Number(plan.mensualidadBs).toLocaleString('es-BO') %></td></tr>
      <tr><td>Conversaciones incluidas</td><td><%= plan.convIncluidas.toLocaleString('es-BO') %> por mes</td></tr>
      <tr><td>Productos permitidos</td><td><%= plan.maxProductos.toLocaleString('es-BO') %></td></tr>
      <tr><td>Usuarios permitidos</td><td><%= plan.maxUsuarios %></td></tr>
    </tbody>
  </table>
</div>

<%- include('partials/fin') %>
