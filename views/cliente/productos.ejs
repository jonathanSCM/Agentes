<%- include('partials/inicio') %>
<% var porCitas = typeof modeloNegocio !== 'undefined' && modeloNegocio === 'CITAS'; %>

<div class="page-head page-head-row">
  <div>
    <h2>Mis productos</h2>
    <p><%= porCitas ? 'Lo que vendés en el local (shampoo, bebidas, accesorios…): se suma a la cuenta del cliente junto con su servicio.' : 'El catálogo que tu agente usa para responder y vender.' %> Límite de tu plan: <strong><%= topeTexto(maxProductos) %></strong>.</p>
  </div>
  <% if (productos.length < maxProductos) { %>
    <a class="btn btn-primary" href="/panel/productos/nuevo">+ Agregar producto</a>
  <% } %>
</div>

<% if (mensaje) { %><div class="alert-ok"><%= mensaje %></div><% } %>
<% if (productos.length >= maxProductos) { %>
  <div class="alert-err">Alcanzaste el límite de productos de tu plan (<%= topeTexto(maxProductos) %>). Mejora tu plan para agregar más.</div>
<% } %>

<div class="admin-stats">
  <div class="stat-card"><span class="stat-num"><%= productos.length %></span><span class="stat-label">Productos</span></div>
  <div class="stat-card stat-new"><span class="stat-num"><%= productos.filter(p=>p.activo).length %></span><span class="stat-label">Activos</span></div>
  <div class="stat-card stat-done"><span class="stat-num"><%= productos.filter(p=>p.stockMostrado<=5).length %></span><span class="stat-label">Stock bajo (≤5)</span></div>
  <% if (!porCitas) { %><div class="stat-card <%= productos.filter(p=>p.motivoOculto).length ? 'stat-off' : '' %>"><span class="stat-num"><%= productos.filter(p=>p.motivoOculto).length %></span><span class="stat-label">Que el agente NO muestra</span></div><% } %>
</div>

<% if (productos.length === 0) { %>
  <div class="empty-state">
    <h3>Aún no tienes productos</h3>
    <p><%= porCitas ? 'Agregá lo que vendés en el local para sumarlo a la cuenta de tus clientes.' : 'Agrega tus productos para que el agente pueda ofrecerlos a tus clientes.' %></p>
    <p style="margin-top:1rem"><a class="btn btn-primary" href="/panel/productos/nuevo">+ Agregar producto</a></p>
  </div>
<% } else { %>
  <%
    var categoriasLista = [];
    productos.forEach(function (p) { var n = p.categoria ? p.categoria.nombre : ''; if (n && categoriasLista.indexOf(n) === -1) categoriasLista.push(n); });
    categoriasLista.sort();
    var tagsDe = function (p) {
      var t = [p.activo ? 'activo' : 'inactivo'];
      if (p.stockMostrado <= 0) t.push('agotado'); else if (p.stockMostrado <= 5) t.push('bajo');
      if (!porCitas && p.motivoOculto) t.push('oculto');
      return t.join(' ');
    };
  %>
  <div class="filtros-barra" data-objetivo="#prodTabla" data-vacio="#prodVacio" data-etiqueta="productos" data-pagina="24">
    <label class="f-buscar"><span style="position:absolute;left:-9999px">Buscar producto</span><input type="search" data-filtro-q placeholder="Buscar por nombre, código o categoría…" autocomplete="off" /></label>
    <% if (categoriasLista.length) { %>
      <select data-filtro-cat aria-label="Categoría">
        <option value="">Todas las categorías</option>
        <% categoriasLista.forEach(function (c) { %><option value="<%= c %>"><%= c %></option><% }); %>
      </select>
    <% } %>
    <div class="f-chips" role="group" aria-label="Estado">
      <button type="button" class="f-chip activo" data-filtro-chip="" aria-pressed="true">Todos</button>
      <button type="button" class="f-chip" data-filtro-chip="activo" aria-pressed="false">Activos</button>
      <button type="button" class="f-chip" data-filtro-chip="inactivo" aria-pressed="false">Desactivados</button>
      <button type="button" class="f-chip" data-filtro-chip="bajo" aria-pressed="false">Stock bajo</button>
      <button type="button" class="f-chip" data-filtro-chip="agotado" aria-pressed="false">Agotados</button>
      <% if (!porCitas) { %><button type="button" class="f-chip" data-filtro-chip="oculto" aria-pressed="false">El agente no los muestra</button><% } %>
    </div>
    <span class="f-cuenta" data-filtro-cuenta aria-live="polite"></span>
  </div>
  <div class="cat-grid" id="prodTabla">
    <% productos.forEach(function (p) { var est = p.stockMostrado <= 0 ? 'agotado' : (p.stockMostrado <= 5 ? 'bajo' : 'ok'); %>
      <article class="cat-card s-<%= est %>" style="<%= p.activo ? '' : 'opacity:.6' %>" data-item data-texto="<%= p.nombre %> <%= p.sku || '' %> <%= p.categoria ? p.categoria.nombre : '' %>" data-categoria="<%= p.categoria ? p.categoria.nombre : '' %>" data-tags="<%= tagsDe(p) %>">
        <div class="cat-foto">
          <% if (p.fotos && p.fotos.length) { %><img src="<%= p.fotos[0] %>" alt="" loading="lazy" /><% } else { %><span class="cat-inicial" aria-hidden="true"><%= p.nombre.charAt(0).toUpperCase() %></span><% } %>
          <% if (!p.activo) { %><span class="cat-estado badge badge-off">Desactivado</span><% } else if (est !== 'ok') { %><span class="cat-estado badge <%= est === 'agotado' ? 'badge-alerta' : 'badge-star' %>"><%= est === 'agotado' ? 'Agotado' : 'Stock bajo' %></span><% } %>
        </div>
        <div class="cat-cuerpo">
          <h3><%= p.nombre %></h3>
          <span class="cat-cat"><%= p.categoria ? p.categoria.nombre : 'Sin categoría' %></span>
          <span class="cat-precio"><%= simboloCatalogo %> <%= Number(p.precio).toFixed(2) %></span>
          <div class="cat-stock"><strong><%= p.stockMostrado %></strong><span>en stock<%= p.tieneVariantes ? ' · con opciones' : '' %></span></div>
          <% if (!porCitas) { %>
            <% if (p.motivoOculto) { %><span class="badge badge-off" title="<%= p.motivoOculto %>" style="align-self:flex-start">El agente no lo ofrece</span><span class="cat-agente"><%= p.motivoOculto %></span>
            <% } else { %><span class="badge badge-new" style="align-self:flex-start">Lo ofrece el agente</span><% } %>
          <% } %>
          <div class="cat-acciones">
            <a class="icon-btn" title="Editar" href="/panel/productos/<%= p.id %>/editar"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m16.5 3.5 4 4L7 21l-4.5 1L3.5 17.5 16.5 3.5Z"/></svg></a>
            <form method="POST" action="/panel/productos/<%= p.id %>/eliminar" class="inline-form"
                    onsubmit="return confirm('¿Eliminar «<%= p.nombre %>»?');">
                <button class="icon-btn del" type="submit" title="Eliminar"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M9 7V4h6v3m-9 0 1 13h10l1-13"/></svg></button>
              </form>
          </div>
        </div>
      </article>
    <% }); %>
  </div>
  <div class="f-vacio" id="prodVacio" hidden>No hay productos con esos filtros.</div>
  <script src="/js/filtros-lista.js"></script>
<% } %>

<details class="pf-mas cat-mas">
  <summary>¿Tenés muchos productos? Cargalos desde Excel</summary>
  <div class="pf-mas-cuerpo">
    <p class="pf-ayuda">
      1. Descargá la plantilla. 2. Llenala con tus productos (y sus tallas o colores). 3. Subila acá.
      Si un producto ya existe (mismo nombre y categoría) se actualiza en vez de duplicarse, así que podés corregir y volver a subir las veces que quieras.
    </p>
    <p><a class="btn btn-ghost btn-chico" href="/panel/productos/importar/plantilla">Descargar plantilla</a></p>
    <form method="POST" action="/panel/productos/importar" enctype="multipart/form-data">
      <div class="field">
        <label for="archivo">Archivo Excel (.xlsx)</label>
        <input id="archivo" name="archivo" type="file" accept=".xlsx" required />
      </div>
      <button class="btn btn-primary" type="submit">Importar</button>
    </form>
  </div>
</details>

<%- include('partials/fin') %>
