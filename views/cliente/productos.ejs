<%- include('partials/inicio') %>

<div class="page-head page-head-row">
  <div>
    <h2>Mis productos</h2>
    <p>El catálogo que tu agente usa para responder y vender. Límite de tu plan: <strong><%= maxProductos.toLocaleString('es-BO') %></strong>.</p>
  </div>
  <% if (productos.length < maxProductos) { %>
    <a class="btn btn-primary" href="/panel/productos/nuevo">+ Agregar producto</a>
  <% } %>
</div>

<% if (mensaje) { %><div class="alert-ok"><%= mensaje %></div><% } %>
<% if (productos.length >= maxProductos) { %>
  <div class="alert-err">Alcanzaste el límite de productos de tu plan (<%= maxProductos %>). Mejora tu plan para agregar más.</div>
<% } %>

<div class="admin-stats">
  <div class="stat-card"><span class="stat-num"><%= productos.length %></span><span class="stat-label">Productos</span></div>
  <div class="stat-card stat-new"><span class="stat-num"><%= productos.filter(p=>p.activo).length %></span><span class="stat-label">Activos</span></div>
  <div class="stat-card stat-done"><span class="stat-num"><%= productos.filter(p=>p.stockMostrado<=5).length %></span><span class="stat-label">Stock bajo (≤5)</span></div>
  <div class="stat-card <%= productos.filter(p=>p.motivoOculto).length ? 'stat-off' : '' %>"><span class="stat-num"><%= productos.filter(p=>p.motivoOculto).length %></span><span class="stat-label">Que el agente NO muestra</span></div>
</div>

<% if (productos.length === 0) { %>
  <div class="empty-state">
    <h3>Aún no tienes productos</h3>
    <p>Agrega tus productos para que el agente pueda ofrecerlos a tus clientes.</p>
    <p style="margin-top:1rem"><a class="btn btn-primary" href="/panel/productos/nuevo">+ Agregar producto</a></p>
  </div>
<% } else { %>
  <div class="table-wrap">
    <table class="leads-table">
      <thead>
        <tr><th></th><th>Producto</th><th>Categoría</th><th class="num">Precio</th><th class="num">Stock</th><th>¿El agente lo muestra?</th><th>Acciones</th></tr>
      </thead>
      <tbody>
        <% productos.forEach(function (p) { %>
          <tr class="<%= p.activo ? '' : 'is-done' %>">
            <td>
              <% if (p.fotos && p.fotos.length) { %>
                <img src="<%= p.fotos[0] %>" alt="" class="prod-thumb" />
              <% } else { %>
                <div class="prod-thumb prod-thumb-vacio">Sin foto</div>
              <% } %>
            </td>
            <td>
              <strong><%= p.nombre %></strong>
              <% if (p.descripcion) { %><br /><span class="muted"><%= p.descripcion %></span><% } %>
            </td>
            <td><%= p.categoria ? p.categoria.nombre : '-' %></td>
            <td class="num"><%= simboloCatalogo %> <%= Number(p.precio).toFixed(2) %></td>
            <td class="num <%= p.stockMostrado <= 5 ? 'saldo-ok' : '' %>">
              <%= p.stockMostrado %><% if (p.tieneVariantes) { %> <span class="muted" style="font-size:.75rem">(variantes)</span><% } %>
            </td>
            <td>
              <% if (p.motivoOculto) { %>
                <span class="badge badge-off" title="<%= p.motivoOculto %>">No lo ofrece</span>
                <div class="muted" style="font-size:.75rem;margin-top:.25rem;max-width:230px"><%= p.motivoOculto %></div>
              <% } else { %>
                <span class="badge badge-new">Lo ofrece</span>
              <% } %>
            </td>
            <td class="actions-cell">
              <a class="icon-btn" title="Editar" href="/panel/productos/<%= p.id %>/editar"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m16.5 3.5 4 4L7 21l-4.5 1L3.5 17.5 16.5 3.5Z"/></svg></a>
              <form method="POST" action="/panel/productos/<%= p.id %>/eliminar" class="inline-form"
                    onsubmit="return confirm('¿Eliminar «<%= p.nombre %>»?');">
                <button class="icon-btn del" type="submit" title="Eliminar"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M9 7V4h6v3m-9 0 1 13h10l1-13"/></svg></button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<div class="form-card" style="max-width:560px;margin-top:1.4rem">
  <h3 style="margin:0 0 .6rem;font-size:.95rem">Importar catálogo desde Excel</h3>
  <p class="muted" style="font-size:.85rem;margin:0 0 .9rem">
    Descargá la plantilla, llenala con tus productos (y sus tallas/colores si tienen) y volvé a subirla.
    Si un producto ya existe (mismo nombre y categoría), se actualiza en vez de duplicarse - podés corregir y volver a subir las veces que necesites.
  </p>
  <div class="form-actions" style="margin-bottom:1rem">
    <a class="btn btn-ghost" href="/panel/productos/importar/plantilla">Descargar plantilla</a>
  </div>
  <form method="POST" action="/panel/productos/importar" enctype="multipart/form-data">
    <div class="field">
      <label for="archivo">Archivo Excel (.xlsx)</label>
      <input id="archivo" name="archivo" type="file" accept=".xlsx" required />
    </div>
    <div class="form-actions">
      <button class="btn btn-primary" type="submit">Importar</button>
    </div>
  </form>
</div>

<%- include('partials/fin') %>
