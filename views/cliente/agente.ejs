<%- include('partials/inicio') %>

<div class="page-head">
  <h2>Probar mi agente</h2>
  <p>Simula una conversación de WhatsApp para ver cómo responde tu agente con tu catálogo. <strong>Cada conversación nueva consume 1 de tu saldo.</strong></p>
</div>

<% if (productos === 0) { %>
  <div class="alert-err">Tu catálogo está vacío. <a href="/panel/productos" style="color:var(--primary-2)">Agrega productos</a> para que el agente tenga qué ofrecer.</div>
<% } %>
<% if (!iaActiva) { %>
  <div class="alert-ok">Modo demostración: el agente responde con reglas simples. Para activar la IA real (Claude), configura <code>ANTHROPIC_API_KEY</code> en el servidor.</div>
<% } %>

<div class="chat-window" style="max-width:560px">
  <div class="chat-head">
    <span class="chat-avatar"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="7" width="16" height="12" rx="3"/><path d="M12 7V3M9 12h.01M15 12h.01"/></svg></span>
    <div>
      <strong><%= empresaNombre %></strong>
      <span class="chat-status">agente en línea</span>
    </div>
  </div>
  <div class="chat-body" id="chatBody" style="min-height:320px; max-height:50vh; overflow-y:auto">
    <div class="msg out">¡Hola! Soy el agente de <%= empresaNombre %>. Escríbeme como si fueras un cliente.</div>
  </div>
  <form id="chatForm" style="display:flex; gap:.5rem; padding:.8rem; border-top:1px solid var(--border)">
    <input id="chatInput" type="text" autocomplete="off" placeholder="Escribe un mensaje..."
           style="flex:1; padding:.6rem .8rem; border-radius:10px; border:1px solid var(--border); background:var(--bg-2); color:var(--text); font:inherit" />
    <button class="btn btn-primary" type="submit">Enviar</button>
  </form>
</div>
<p class="muted" style="margin-top:1rem;font-size:.85rem">El saldo se descuenta igual que con WhatsApp real. Consulta tu consumo en <a href="/panel" style="color:var(--primary-2)">Mi consumo</a>.</p>

<script>
  (function () {
    var form = document.getElementById('chatForm');
    var input = document.getElementById('chatInput');
    var body = document.getElementById('chatBody');
    // Telefono simulado fijo por sesion de prueba, para agrupar en 1 conversacion
    var telefono = 'demo-' + Math.floor(Math.random() * 1e6);

    function burbuja(texto, tipo) {
      var d = document.createElement('div');
      d.className = 'msg ' + tipo;
      d.textContent = texto;
      body.appendChild(d);
      body.scrollTop = body.scrollHeight;
      return d;
    }

    // Tarjeta de producto: foto real + ficha (precio, stock, caracteristicas),
    // igual que llegaria por WhatsApp real cuando el agente llama a
    // mostrar_productos / enviar_fotos_producto.
    function burbujaFoto(foto) {
      var d = document.createElement('div');
      d.className = 'msg out msg-foto';
      var img = document.createElement('img');
      img.src = foto.url;
      img.alt = 'Foto del producto';
      var cap = document.createElement('div');
      cap.className = 'msg-foto-caption';
      cap.textContent = foto.caption || '';
      d.appendChild(img);
      d.appendChild(cap);
      body.appendChild(d);
      body.scrollTop = body.scrollHeight;
      return d;
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var texto = input.value.trim();
      if (!texto) return;
      input.value = '';
      burbuja(texto, 'in');
      var cargando = burbuja('...', 'out');

      try {
        var res = await fetch('/panel/agente/mensaje', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ telefono: telefono, mensaje: texto }),
        });
        var data = await res.json();
        cargando.remove();
        if (data.ok) {
          (data.fotos || []).forEach(function (foto) { burbujaFoto(foto); });
          burbuja(data.respuesta, 'out');
        } else {
          burbuja((data.error || 'No se pudo responder.'), 'out');
        }
      } catch (err) {
        cargando.remove();
        burbuja('Error de conexión.', 'out');
      }
    });
  })();
</script>

<%- include('partials/fin') %>
