<%- include('partials/inicio') %>

<div class="page-head page-head-row">
  <div>
    <h2>Conversación con <%= cliente && cliente.nombre ? cliente.nombre : conversacion.telefonoCliente %></h2>
    <p>
      <%= conversacion.telefonoCliente %>
      <a href="https://wa.me/<%= conversacion.telefonoCliente.replace(/\D/g,'') %>" target="_blank" rel="noopener" style="color:var(--primary-2);margin-left:.6rem">Hablar por WhatsApp</a>
    </p>
  </div>
  <div>
    <% if (conversacion.modo === 'HUMANO') { %>
      <span class="badge badge-done" style="margin-right:.6rem">Tomada por <%= conversacion.tomadaPor ? conversacion.tomadaPor.nombre : 'un humano' %></span>
      <form method="POST" action="/panel/conversaciones/<%= conversacion.id %>/liberar" class="inline-form">
        <button class="btn btn-ghost" type="submit">Devolver al agente IA</button>
      </form>
    <% } else { %>
      <span class="badge badge-new" style="margin-right:.6rem">Atendida por IA</span>
      <form method="POST" action="/panel/conversaciones/<%= conversacion.id %>/control" class="inline-form">
        <button class="btn btn-primary" type="submit">Tomar control</button>
      </form>
    <% } %>
    <form method="POST" action="/panel/conversaciones/<%= conversacion.id %>/reiniciar" class="inline-form" style="margin-left:.4rem"
          onsubmit="return confirm('¿Reiniciar la memoria de este cliente? El agente olvidará categoría, presupuesto, favorito y productos ya mostrados, y lo tratará como una charla nueva desde el próximo mensaje. El historial de mensajes NO se borra.');">
      <button class="btn btn-ghost" type="submit" title="Borra lo que el agente recuerda de este cliente (categoría, presupuesto, productos ya mostrados, etc.), sin borrar el historial ni afectar tu consumo">↺ Reiniciar cliente</button>
    </form>
    <form method="POST" action="/panel/conversaciones/<%= conversacion.id %>/eliminar" class="inline-form" style="margin-left:.4rem"
          onsubmit="return confirm('¿Borrar POR COMPLETO esta conversación? Se eliminan todos los mensajes, toda la memoria del cliente (categoría, carrito, favoritos) y el registro del cliente en la base. Los pedidos ya creados no se borran, pero quedan sin cliente asociado. Esto NO se puede deshacer.');">
      <button class="btn btn-danger" type="submit" title="Borra por completo la conversación y los datos de este cliente de la base, sin dejar rastro">🗑 Borrar todo</button>
    </form>
  </div>
</div>

<p style="margin:0 0 1rem"><a href="/panel/conversaciones" style="color:var(--primary-2)">← Volver a conversaciones</a></p>

<% if (mensaje) { %><div class="alert-ok"><%= mensaje %></div><% } %>
<% if (error) { %><div class="alert-err"><%= error %></div><% } %>

<div class="conv-layout">
  <div class="conv-shell" data-conversacion-id="<%= conversacion.id %>">
    <div class="conv-head">
      <span class="conv-avatar"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="7" width="16" height="12" rx="3"/><path d="M12 7V3M9 12h.01M15 12h.01"/></svg></span>
      <div>
        <strong><%= conversacion.agente.nombre %></strong>
        <span id="chatStatus"><%= conversacion.mensajes.length %> mensajes</span>
      </div>
    </div>
    <div class="conv-body" id="chatMensajes">
      <% if (conversacion.mensajes.length === 0) { %>
        <p class="dash-empty" id="chatVacio">Todavía no hay mensajes en esta conversación.</p>
      <% } %>
      <%
        function claseDe(m) {
          if (m.rol === 'CLIENTE') return 'cliente';
          return m.usuario ? 'humano' : 'bot';
        }
        function quienDe(m) {
          if (m.rol === 'CLIENTE') return null;
          return m.usuario ? ('✋ ' + m.usuario.nombre) : '🤖 Agente IA';
        }
      %>
      <% conversacion.mensajes.forEach(function (m) { %>
        <% var clase = claseDe(m); var quien = quienDe(m); %>
        <% if (m.mediaTipo === 'imagen' && m.mediaUrl) { %>
          <div class="conv-msg foto <%= clase %>">
            <img src="<%= m.mediaUrl %>" alt="" />
            <% if (quien || m.contenido) { %>
              <div class="conv-msg-foto-caption">
                <% if (quien) { %><div class="conv-msg-quien"><%= quien %></div><% } %>
                <%= m.contenido %>
              </div>
            <% } %>
          </div>
        <% } else if (m.mediaTipo === 'audio' && m.mediaUrl) { %>
          <div class="conv-msg <%= clase %>">
            <% if (quien) { %><div class="conv-msg-quien"><%= quien %></div><% } %>
            <audio controls src="<%= m.mediaUrl %>"></audio>
            <% if (m.contenido) { %><div style="margin-top:.4rem;font-size:.82rem"><%= m.contenido %></div><% } %>
          </div>
        <% } else { %>
          <div class="conv-msg <%= clase %>">
            <% if (quien) { %><div class="conv-msg-quien"><%= quien %></div><% } %>
            <%= m.contenido %>
          </div>
        <% } %>
        <div class="conv-msg-hora <%= clase %>">
          <%= new Date(m.createdAt).toLocaleString('es-BO', { dateStyle: 'short', timeStyle: 'short' }) %>
        </div>
      <% }); %>
    </div>

    <% if (conversacion.modo === 'HUMANO') { %>
      <form method="POST" action="/panel/conversaciones/<%= conversacion.id %>/mensaje" id="formMensajeHumano" class="conv-foot">
        <input type="text" name="texto" autocomplete="off" placeholder="Escribe tu respuesta..." />
        <button class="btn btn-ghost" type="button" id="btnAbrirProducto">📦 Producto</button>
        <button class="btn btn-primary" type="submit">Enviar</button>
      </form>
    <% } else { %>
      <p class="conv-foot-sin-control">Tomá el control del chat para poder escribirle directo al cliente.</p>
    <% } %>
  </div>

  <% if (cliente) { %>
  <aside class="dash-card conv-cliente-card">
    <div class="dash-card-head"><h3>Cliente</h3></div>
    <ul class="dash-list">
      <li><span>Interés</span><span><%= cliente.categoriaInteres || '-' %></span></li>
      <li><span>Presupuesto</span><span><%= cliente.presupuesto || '-' %></span></li>
      <li>
        <span>Dirección de entrega</span>
        <span>
          <% if (direccionLink) { %>
            <a href="<%= direccionLink %>" target="_blank" rel="noopener" class="conv-direccion-link">📍 Ver ubicación</a>
          <% } else { %>
            <%= cliente.direccionEntrega || '-' %>
          <% } %>
        </span>
      </li>
      <li><span>Estado</span><span class="badge badge-done" style="font-size:.8rem"><%= cliente.estadoLead.replace(/_/g,' ').toLowerCase() %></span></li>
    </ul>
  </aside>
  <% } %>
</div>

<% if (conversacion.modo === 'HUMANO') { %>
<div class="prod-overlay" id="prodOverlay" hidden>
  <div class="prod-card">
    <button type="button" class="prod-cerrar" id="prodCerrar" aria-label="Cerrar">✕</button>
    <h3>Enviar producto</h3>
    <input type="text" class="prod-buscar" id="prodBuscar" placeholder="Buscar por nombre..." autocomplete="off" />
    <div class="prod-lista" id="prodLista"></div>
  </div>
</div>

<form method="POST" action="/panel/conversaciones/<%= conversacion.id %>/producto" id="formEnviarProducto" style="display:none">
  <input type="hidden" name="productoId" id="prodIdSeleccionado" />
</form>
<% } %>

<script src="/socket.io/socket.io.js"></script>
<script>
  (function () {
    var CONV_ID = <%- conversacion.id %>;
    var body = document.getElementById('chatMensajes');
    var status = document.getElementById('chatStatus');
    var total = <%- conversacion.mensajes.length %>;

    // Al abrir la conversacion se ve el ULTIMO mensaje, no el primero: sin
    // esto, en una charla larga el dueño entraba y veia el inicio de la
    // charla en vez de lo mas reciente que dijo el cliente.
    body.scrollTop = body.scrollHeight;

    function fmtFecha(iso) {
      var d = new Date(iso);
      return d.toLocaleString('es-BO', { dateStyle: 'short', timeStyle: 'short' });
    }

    function claseDe(m) {
      if (m.rol === 'CLIENTE') return 'cliente';
      return m.usuarioNombre ? 'humano' : 'bot';
    }
    function quienDe(m) {
      if (m.rol === 'CLIENTE') return null;
      return m.usuarioNombre ? ('✋ ' + m.usuarioNombre) : '🤖 Agente IA';
    }

    function agregarBurbuja(m) {
      document.getElementById('chatVacio')?.remove();
      var clase = claseDe(m);
      var quien = quienDe(m);
      var wrap = document.createElement('div');
      wrap.className = 'conv-msg ' + clase + (m.mediaTipo === 'imagen' && m.mediaUrl ? ' foto' : '');

      if (m.mediaTipo === 'imagen' && m.mediaUrl) {
        var img = document.createElement('img');
        img.src = m.mediaUrl;
        wrap.appendChild(img);
        if (quien || m.contenido) {
          var caption = document.createElement('div');
          caption.className = 'conv-msg-foto-caption';
          if (quien) {
            var q1 = document.createElement('div');
            q1.className = 'conv-msg-quien';
            q1.textContent = quien;
            caption.appendChild(q1);
          }
          caption.appendChild(document.createTextNode(m.contenido || ''));
          wrap.appendChild(caption);
        }
      } else if (m.mediaTipo === 'audio' && m.mediaUrl) {
        if (quien) {
          var q2 = document.createElement('div');
          q2.className = 'conv-msg-quien';
          q2.textContent = quien;
          wrap.appendChild(q2);
        }
        var audio = document.createElement('audio');
        audio.controls = true;
        audio.src = m.mediaUrl;
        wrap.appendChild(audio);
        if (m.contenido) {
          var notaAudio = document.createElement('div');
          notaAudio.style.cssText = 'margin-top:.4rem;font-size:.82rem';
          notaAudio.textContent = m.contenido;
          wrap.appendChild(notaAudio);
        }
      } else {
        if (quien) {
          var q3 = document.createElement('div');
          q3.className = 'conv-msg-quien';
          q3.textContent = quien;
          wrap.appendChild(q3);
        }
        wrap.appendChild(document.createTextNode(m.contenido));
      }
      body.appendChild(wrap);

      var hora = document.createElement('div');
      hora.className = 'conv-msg-hora ' + clase;
      hora.textContent = fmtFecha(m.createdAt);
      body.appendChild(hora);

      body.scrollTop = body.scrollHeight;
      total++;
      if (status) status.textContent = total + ' mensajes';
    }

    var socket = io();
    socket.on('mensaje:nuevo', function (payload) {
      if (payload.conversacionId === CONV_ID) agregarBurbuja(payload);
    });
    socket.on('conversacion:actualizada', function (payload) {
      // Otra persona del equipo tomo/devolvio el control de este mismo chat
      // mientras lo tenias abierto: recargamos para mostrar el estado real
      // (evita que dos personas escriban a la vez sin saberlo).
      if (payload.conversacionId === CONV_ID) location.reload();
    });

    // ---- Modal de "enviar producto" ----
    var btnAbrir = document.getElementById('btnAbrirProducto');
    var overlay = document.getElementById('prodOverlay');
    if (!btnAbrir || !overlay) return;
    var btnCerrar = document.getElementById('prodCerrar');
    var buscar = document.getElementById('prodBuscar');
    var lista = document.getElementById('prodLista');
    var form = document.getElementById('formEnviarProducto');
    var inputId = document.getElementById('prodIdSeleccionado');
    var debounce = null;

    function abrir() {
      overlay.hidden = false;
      buscar.value = '';
      buscar.focus();
      cargar('');
    }
    function cerrar() { overlay.hidden = true; }

    function cargar(q) {
      lista.innerHTML = '<p class="prod-vacio">Buscando...</p>';
      fetch('/panel/conversaciones/<%= conversacion.id %>/productos-buscar?q=' + encodeURIComponent(q))
        .then(function (r) { return r.json(); })
        .then(function (productos) {
          if (!productos.length) {
            lista.innerHTML = '<p class="prod-vacio">Sin resultados.</p>';
            return;
          }
          lista.innerHTML = '';
          productos.forEach(function (p) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'prod-item';
            var miniatura = p.foto
              ? '<img src="' + p.foto + '" alt="" />'
              : '<div class="prod-item-sin-foto">📦</div>';
            btn.innerHTML = miniatura +
              '<div><div class="prod-item-nombre"></div><div class="prod-item-precio"></div></div>';
            btn.querySelector('.prod-item-nombre').textContent = p.nombre;
            btn.querySelector('.prod-item-precio').textContent = 'Bs ' + Number(p.precio).toFixed(2);
            btn.addEventListener('click', function () {
              inputId.value = p.id;
              form.submit();
            });
            lista.appendChild(btn);
          });
        })
        .catch(function () { lista.innerHTML = '<p class="prod-vacio">No se pudo buscar. Intenta de nuevo.</p>'; });
    }

    btnAbrir.addEventListener('click', abrir);
    btnCerrar.addEventListener('click', cerrar);
    overlay.addEventListener('click', function (e) { if (e.target === overlay) cerrar(); });
    buscar.addEventListener('input', function () {
      clearTimeout(debounce);
      var valor = buscar.value;
      debounce = setTimeout(function () { cargar(valor); }, 300);
    });
  })();
</script>

<%- include('partials/fin') %>
