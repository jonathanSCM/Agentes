<%- include('partials/inicio') %>

<div class="page-head">
  <h2>Configuración del agente</h2>
  <p>Datos de tu agente de ventas y el número de WhatsApp que usará.</p>
</div>

<% if (mensaje) { %><div class="alert-ok"><%= mensaje %></div><% } %>
<% if (error) { %><div class="alert-err"><%= error %></div><% } %>

<nav class="config-nav">
  <a href="#config-agente">Datos del agente</a>
  <a href="#config-ventas">Cómo vende</a>
  <a href="#config-pagos">Pagos y entrega</a>
  <a href="#config-catalogo">Catálogo web y marca</a>
</nav>

<form method="POST" action="/panel/configuracion" enctype="multipart/form-data">

  <section class="dash-card config-seccion" id="config-agente">
    <div class="dash-card-head"><h3>Datos del agente</h3></div>

    <div class="field">
      <label for="nombre">Nombre del agente</label>
      <input id="nombre" name="nombre" type="text" maxlength="60"
             value="<%= agente.nombre || '' %>" placeholder="Ej: Asistente de Tienda Doña Rosa" />
    </div>

    <div class="field">
      <label for="numeroWhatsapp">Número de WhatsApp del agente</label>
      <input id="numeroWhatsapp" name="numeroWhatsapp" type="tel" maxlength="20"
             value="<%= agente.numeroWhatsapp || '' %>" placeholder="59171234567" />
      <p class="muted" style="font-size:.82rem;margin:.4rem 0 0">
        En formato internacional, sin el signo "+" ni espacios. Ej: Bolivia → <b>591</b> + número.
      </p>
    </div>

    <div class="field">
      <label for="estado">Estado del agente</label>
      <select id="estado" name="estado">
        <% [['ACTIVO','Activo (atiende)'],['PAUSADO','Pausado'],['BORRADOR','Borrador']].forEach(function (e) { %>
          <option value="<%= e[0] %>" <%= agente.estado === e[0] ? 'selected' : '' %>><%= e[1] %></option>
        <% }); %>
      </select>
    </div>

    <% if (!agente.numeroWhatsapp) { %>
      <div class="alert-err" style="margin-top:.8rem">
        Aún no has puesto tu número de WhatsApp.
      </div>
    <% } %>
    <p class="muted" style="font-size:.82rem;margin:.8rem 0 0">
      Este número es solo un dato del agente. Para conectarlo de verdad a WhatsApp, andá a la sección
      <a href="/panel/whatsapp">WhatsApp →</a>
    </p>
  </section>

  <section class="dash-card config-seccion" id="config-ventas">
    <div class="dash-card-head"><h3>Cómo vende</h3></div>

    <div class="field">
      <label for="mensajeBienvenida">Mensaje de bienvenida (opcional)</label>
      <input id="mensajeBienvenida" name="mensajeBienvenida" type="text" maxlength="200"
             value="<%= config.mensajeBienvenida || '' %>" placeholder="Ej: Bienvenido a Tienda Doña Rosa, tu tienda de ropa y calzado" />
      <p class="muted" style="font-size:.82rem;margin:.4rem 0 0">
        Si lo dejás vacío, el agente se presenta solo (su nombre, tu tienda y qué vendés) en vez de un saludo genérico — normalmente da mejor resultado dejarlo así.
      </p>
    </div>

    <div class="field">
      <label for="tono">Tono del agente</label>
      <select id="tono" name="tono">
        <% ['cordial y profesional','amigable y cercano','formal','divertido y casual'].forEach(function (t) { %>
          <option value="<%= t %>" <%= config.tono === t ? 'selected' : '' %>><%= t %></option>
        <% }); %>
      </select>
    </div>

    <div class="field">
      <label for="instrucciones">Instrucciones extra (opcional)</label>
      <input id="instrucciones" name="instrucciones" type="text" maxlength="200"
             value="<%= config.instrucciones || '' %>" placeholder="Ej: Ofrece el envío gratis en compras mayores a Bs 200" />
    </div>

    <div class="field">
      <label><input type="checkbox" name="derivarAHumano" value="1" <%= config.derivarAHumano ? 'checked' : '' %> /> Permitir que derive a una persona cuando sea necesario</label>
    </div>

    <div class="field">
      <label for="preguntasIniciales">Qué pregunta el agente antes de mostrar nada</label>
      <p class="muted" style="font-size:.82rem;margin:0 0 .5rem">
        Datos que el agente pide <strong>al principio</strong>, antes incluso de mostrar las categorías: son filtros que aplican a todo tu catálogo.
        Los pregunta de a uno y en este orden, ofreciéndole al cliente las opciones reales que existen.
        Separalos por coma. Dejalo vacío para que arranque mostrando el menú.
      </p>
      <input id="preguntasIniciales" name="preguntasIniciales" type="text" maxlength="120"
             value="<%= (config.preguntasIniciales || []).join(', ') %>" placeholder="Genero" />
      <p class="muted" style="font-size:.8rem;margin:.35rem 0 0">
        Sugerencia: <code>Genero</code> solo. Agregar <code>Talla</code> acá hace que la pregunte antes de saber si buscás calzado (42) o ropa (M),
        que suele confundir — conviene dejar la talla configurada dentro de cada categoría.
      </p>
    </div>
  </section>

  <section class="dash-card config-seccion" id="config-pagos">
    <div class="dash-card-head"><h3>Pagos y entrega</h3></div>

    <div class="field">
      <label for="moneda">Moneda de tu catálogo</label>
      <p class="muted" style="font-size:.82rem;margin:0 0 .5rem">Todos los precios que tenés cargados están en esta moneda. El agente la usa para escribir cualquier precio y nunca la convierte a otra.</p>
      <select id="moneda" name="moneda">
        <% monedas.forEach(function (m) { %>
          <option value="<%= m %>" <%= (empresa && empresa.moneda) === m ? 'selected' : '' %>><%= m %></option>
        <% }); %>
      </select>
    </div>

    <div class="field">
      <label for="direccionTienda">Dirección de tu local (para retiro en tienda)</label>
      <p class="muted" style="font-size:.82rem;margin:0 0 .5rem">Si la dejás vacía, el agente solo ofrece entrega a domicilio: nunca inventa una dirección. Si la cargás, se la manda tal cual al cliente que elija pasar a retirar.</p>
      <input id="direccionTienda" name="direccionTienda" type="text" maxlength="200"
             value="<%= config.direccionTienda || '' %>" placeholder="Ej: Av. Ballivián 1234, entre 2do y 3er anillo" />
    </div>

    <div class="field">
      <label>Ubicación del local en el mapa (opcional)</label>
      <p class="muted" style="font-size:.82rem;margin:0 0 .6rem">Tocá el mapa para marcar dónde queda tu local, o usá tu ubicación actual. Esto es lo que ve el cliente cuando elige retirar en tienda.</p>
      <div style="display:flex;gap:.5rem;margin-bottom:.6rem;flex-wrap:wrap">
        <button type="button" class="btn btn-ghost" id="btnUbicacionActual" style="padding:.5rem 1rem;font-size:.85rem">📍 Usar mi ubicación</button>
        <span class="muted" id="ubicacionTexto" style="font-size:.82rem;align-self:center">
          <%= (config.tiendaLat != null && config.tiendaLng != null) ? `Marcada en ${Number(config.tiendaLat).toFixed(5)}, ${Number(config.tiendaLng).toFixed(5)}` : 'Todavía no marcaste ninguna ubicación.' %>
        </span>
      </div>
      <div id="mapaTienda" style="height:280px;border-radius:12px;overflow:hidden;border:1px solid var(--border)"></div>
      <div class="field-row" style="margin-top:.6rem">
        <div class="field">
          <label for="tiendaLat">Latitud</label>
          <input id="tiendaLat" name="tiendaLat" type="number" step="any" readonly
                 value="<%= config.tiendaLat != null ? config.tiendaLat : '' %>" placeholder="Tocá el mapa" />
        </div>
        <div class="field">
          <label for="tiendaLng">Longitud</label>
          <input id="tiendaLng" name="tiendaLng" type="number" step="any" readonly
                 value="<%= config.tiendaLng != null ? config.tiendaLng : '' %>" placeholder="Tocá el mapa" />
        </div>
      </div>
    </div>

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
    (function () {
      var latInicial = <%- config.tiendaLat != null ? config.tiendaLat : 'null' %>;
      var lngInicial = <%- config.tiendaLng != null ? config.tiendaLng : 'null' %>;
      var centro = (latInicial != null && lngInicial != null) ? [latInicial, lngInicial] : [-16.5, -64.5];
      var zoomInicial = (latInicial != null && lngInicial != null) ? 15 : 5;

      var mapa = L.map('mapaTienda').setView(centro, zoomInicial);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap',
        maxZoom: 19,
      }).addTo(mapa);

      var inputLat = document.getElementById('tiendaLat');
      var inputLng = document.getElementById('tiendaLng');
      var texto = document.getElementById('ubicacionTexto');
      var marcador = (latInicial != null && lngInicial != null) ? L.marker(centro, { draggable: true }).addTo(mapa) : null;

      function fijarUbicacion(lat, lng) {
        lat = Number(lat.toFixed(6));
        lng = Number(lng.toFixed(6));
        if (marcador) {
          marcador.setLatLng([lat, lng]);
        } else {
          marcador = L.marker([lat, lng], { draggable: true }).addTo(mapa);
          marcador.on('dragend', function () {
            var p = marcador.getLatLng();
            fijarUbicacion(p.lat, p.lng);
          });
        }
        inputLat.value = lat;
        inputLng.value = lng;
        texto.textContent = 'Marcada en ' + lat + ', ' + lng;
      }

      if (marcador) {
        marcador.on('dragend', function () {
          var p = marcador.getLatLng();
          fijarUbicacion(p.lat, p.lng);
        });
      }

      mapa.on('click', function (e) {
        fijarUbicacion(e.latlng.lat, e.latlng.lng);
        mapa.setView(e.latlng, Math.max(mapa.getZoom(), 15));
      });

      document.getElementById('btnUbicacionActual').addEventListener('click', function () {
        if (!navigator.geolocation) {
          texto.textContent = 'Tu navegador no permite compartir la ubicación.';
          return;
        }
        texto.textContent = 'Buscando tu ubicación...';
        navigator.geolocation.getCurrentPosition(
          function (pos) {
            var latlng = [pos.coords.latitude, pos.coords.longitude];
            fijarUbicacion(latlng[0], latlng[1]);
            mapa.setView(latlng, 16);
          },
          function () {
            texto.textContent = 'No pudimos acceder a tu ubicación. Tocá el mapa para marcarla a mano.';
          }
        );
      });
    })();
    </script>

    <div class="field">
      <label>Formas de pago que acepta esta tienda</label>
      <p class="muted" style="font-size:.82rem;margin:0 0 .5rem">El agente SOLO le ofrece al cliente las formas de pago que marques acá.</p>
      <label style="display:block;margin-bottom:.3rem"><input type="checkbox" name="aceptaEfectivo" value="1" <%= config.aceptaEfectivo !== false ? 'checked' : '' %> /> Efectivo</label>
      <label style="display:block;margin-bottom:.3rem"><input type="checkbox" name="aceptaTarjeta" value="1" <%= config.aceptaTarjeta ? 'checked' : '' %> /> Tarjeta</label>
      <label style="display:block;margin-bottom:.3rem"><input type="checkbox" id="aceptaQr" name="aceptaQr" value="1" <%= config.aceptaQr ? 'checked' : '' %> /> QR</label>
    </div>

    <div class="field" id="campo-qr" style="<%= config.aceptaQr ? '' : 'display:none' %>">
      <label for="qr">Imagen del QR de cobro</label>
      <p class="muted" style="font-size:.82rem;margin:0 0 .5rem">La misma imagen de QR que ya usás hoy para cobrar (banco, billetera, etc.). El bot la manda tal cual cuando el cliente elige pagar por QR.</p>
      <% if (config.qrCobroUrl) { %>
        <div style="margin-bottom:8px;">
          <img src="<%= config.qrCobroUrl %>" style="width:120px;height:120px;object-fit:contain;border-radius:8px;background:#fff;padding:6px" />
        </div>
        <label style="margin-bottom:.5rem;display:block"><input type="checkbox" name="quitarQr" value="1" /> Quitar el QR actual</label>
      <% } %>
      <input id="qr" name="qr" type="file" accept="image/*" />
    </div>
  </section>

  <section class="dash-card config-seccion" id="config-catalogo">
    <div class="dash-card-head"><h3>Catálogo web y marca</h3></div>
    <p class="muted" style="font-size:.82rem;margin:0 0 1rem">Así se ve la página pública que el agente comparte cuando un cliente quiere ver fotos y precios con más detalle (<a href="/catalogo/<%= empresa.slug %>" target="_blank" rel="noopener">vista previa</a>).</p>

    <div style="margin-bottom:.8rem">
      <label for="logo" style="display:block;margin-bottom:.3rem">Logo de la tienda</label>
      <% if (config.logoUrl) { %>
        <div style="margin-bottom:8px;">
          <img src="<%= config.logoUrl %>" style="width:56px;height:56px;object-fit:cover;border-radius:8px;background:#fff;padding:4px" />
        </div>
        <label style="margin-bottom:.5rem;display:block"><input type="checkbox" name="quitarLogo" value="1" /> Quitar el logo actual</label>
      <% } %>
      <input id="logo" name="logo" type="file" accept="image/*" />
    </div>

    <div class="field-row">
      <div class="field">
        <label for="colorPrimario">Color principal</label>
        <input id="colorPrimario" name="colorPrimario" type="color" value="<%= config.colorPrimario || '#22c58b' %>" style="height:42px;padding:4px" />
      </div>
      <div class="field">
        <label for="colorSecundario">Color secundario</label>
        <input id="colorSecundario" name="colorSecundario" type="color" value="<%= config.colorSecundario || '#22c58b' %>" style="height:42px;padding:4px" />
      </div>
    </div>

    <div style="margin-top:1rem">
      <label style="display:block;margin-bottom:.5rem">Estilo del catálogo</label>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:.6rem">
        <%
          var plantillas = [
            { valor: 'clasica', nombre: 'Clásica', desc: 'Grid con buscador' },
            { valor: 'banner', nombre: 'Banner', desc: 'Portada grande' },
            { valor: 'grid-denso', nombre: 'Denso', desc: 'Mosaico compacto' },
            { valor: 'revista', nombre: 'Revista', desc: 'Editorial, con aire' },
          ];
          var plantillaActual = config.plantillaCatalogo || 'clasica';
        %>
        <% plantillas.forEach(function (p) { %>
          <label style="border:2px solid <%= plantillaActual === p.valor ? 'var(--primary-2)' : 'var(--border)' %>;border-radius:10px;padding:.7rem;cursor:pointer;display:block">
            <input type="radio" name="plantillaCatalogo" value="<%= p.valor %>" <%= plantillaActual === p.valor ? 'checked' : '' %> style="margin-right:.4rem" />
            <strong style="font-size:.88rem"><%= p.nombre %></strong>
            <div class="muted" style="font-size:.76rem;margin-top:.15rem"><%= p.desc %></div>
          </label>
        <% }); %>
      </div>
    </div>
  </section>

  <div class="form-actions">
    <button class="btn btn-primary" type="submit">Guardar configuración</button>
  </div>
</form>

<script>
(function () {
  var chk = document.getElementById('aceptaQr');
  var campo = document.getElementById('campo-qr');
  if (chk && campo) {
    chk.addEventListener('change', function () {
      campo.style.display = chk.checked ? '' : 'none';
    });
  }
})();
</script>

<%- include('partials/fin') %>
