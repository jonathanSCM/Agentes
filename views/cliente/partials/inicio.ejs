<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../../partials/head') %>
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin">
<div class="admin-shell">

  <aside class="sidebar" id="sidebar">
    <a href="/panel" class="sidebar-brand">
      <img src="/img/logo-icon.png" alt="" class="brand-mark-icon" width="30" height="30" />
      <span class="sidebar-brand-stack">
        <span class="sidebar-brand-text"><%= site.name %></span>
        <strong class="sidebar-empresa"><%= empresaNombre %></strong>
      </span>
    </a>

    <nav class="sidebar-nav" aria-label="Menu de mi negocio">
      <span class="sidebar-section">Operación</span>
      <a href="/panel" class="<%= activo === 'inicio' ? 'is-active' : '' %>">
        <span class="si"><svg viewBox="0 0 24 24"><path d="M3 11.5 12 4l9 7.5M5 10v9h5v-5h4v5h5v-9"/></svg></span> Inicio
      </a>
      <a href="/panel/conversaciones" class="<%= activo === 'conversaciones' ? 'is-active' : '' %>">
        <span class="si"><svg viewBox="0 0 24 24"><path d="M4 4h16v11H8l-4 4V4Z"/></svg></span> Conversaciones
      </a>
      <a href="/panel/pedidos" class="<%= activo === 'pedidos' ? 'is-active' : '' %>">
        <span class="si"><svg viewBox="0 0 24 24"><path d="M4 5h16l-1.5 9h-13L4 5Z"/><path d="M4 5 3 2H1"/><circle cx="9" cy="19" r="1.4"/><circle cx="17" cy="19" r="1.4"/></svg></span> Pedidos
      </a>
      <a href="/panel/productos" class="<%= activo === 'productos' ? 'is-active' : '' %>">
        <span class="si"><svg viewBox="0 0 24 24"><path d="M3 8 12 4l9 4-9 4-9-4Z"/><path d="M3 8v8l9 4 9-4V8M12 12v8"/></svg></span> Productos
      </a>
      <a href="/panel/clientes" class="<%= activo === 'clientes' ? 'is-active' : '' %>">
        <span class="si"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2"/><path d="M2.5 19c.6-3.4 3.2-5.5 6.5-5.5s5.9 2.1 6.5 5.5"/><circle cx="17.5" cy="9" r="2.4"/><path d="M16 13.7c2.5.3 4.3 2.1 4.8 4.8"/></svg></span> Clientes
      </a>
      <a href="/panel/inventario" class="<%= activo === 'inventario' ? 'is-active' : '' %>">
        <span class="si"><svg viewBox="0 0 24 24"><path d="M4 19V10M10 19V5M16 19v-7M20 19V3"/></svg></span> Inventario
      </a>
      <a href="/panel/agente" class="<%= activo === 'agente' ? 'is-active' : '' %>">
        <span class="si"><svg viewBox="0 0 24 24"><rect x="4" y="7" width="16" height="12" rx="3"/><path d="M12 7V3M9 12h.01M15 12h.01"/></svg></span> Agente IA
      </a>
      <a href="/panel/whatsapp" class="<%= activo === 'whatsapp' ? 'is-active' : '' %>">
        <span class="si"><svg viewBox="0 0 24 24"><path d="M6.3 17.7 3 21l3.4-1a8.9 8.9 0 1 0-3.3-3.4Z"/><path d="M8.5 8.7c.2-.5.5-.5.8-.5h.6c.2 0 .4 0 .6.4.2.5.7 1.7.7 1.8.1.2.1.3 0 .5-.4.6-.9.9-.6 1.4.7 1.2 1.4 1.7 2.5 2.2.2.1.3.1.5-.1.2-.2.7-.8.9-1.1.2-.2.3-.2.6-.1.2.1 1.5.7 1.8.9.2.1.3.1.4.3 0 .2 0 1-.4 1.5-.4.5-1.3.9-2 .9-.6 0-2-.2-3.8-1.6-1.8-1.5-2.9-3.4-3-3.6-.2-.2-.9-1.2-.9-2.3 0-1.1.5-1.6.7-1.8Z"/></svg></span> WhatsApp
      </a>
      <a href="/panel/reportes" class="<%= activo === 'reportes' ? 'is-active' : '' %>">
        <span class="si"><svg viewBox="0 0 24 24"><path d="M4 19h16M6 16V9m6 7V5m6 11v-4"/></svg></span> Reportes
      </a>
      <a href="/panel/configuracion" class="<%= activo === 'configuracion' ? 'is-active' : '' %>">
        <span class="si"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 13.5a7.4 7.4 0 0 0 0-3l1.8-1.4-2-3.4-2.1.6a7.4 7.4 0 0 0-2.6-1.5L14 2.5h-4l-.5 2.3a7.4 7.4 0 0 0-2.6 1.5l-2.1-.6-2 3.4L4.6 10.5a7.4 7.4 0 0 0 0 3L2.8 15l2 3.4 2.1-.6c.8.7 1.6 1.2 2.6 1.5l.5 2.3h4l.5-2.3a7.4 7.4 0 0 0 2.6-1.5l2.1.6 2-3.4-1.8-1.5Z"/></svg></span> Configuración
      </a>

      <span class="sidebar-section">Plan y facturación</span>
      <a href="/panel/consumo" class="<%= activo === 'consumo' ? 'is-active' : '' %>">
        <span class="si"><svg viewBox="0 0 24 24"><path d="M3 10a2 2 0 0 1 0-4h18v4a2 2 0 0 0 0 4v4H3v-4a2 2 0 0 0 0-4Z"/><path d="M10 6v12" stroke-dasharray="2 2"/></svg></span> Mi consumo
      </a>
      <a href="/panel/paquetes" class="<%= activo === 'paquetes' ? 'is-active' : '' %>">
        <span class="si"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></span> Comprar paquete
      </a>
      <a href="/panel/compras" class="<%= activo === 'compras' ? 'is-active' : '' %>">
        <span class="si"><svg viewBox="0 0 24 24"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3Z"/><path d="M9 8h6M9 12h6"/></svg></span> Mis compras
      </a>
    </nav>

    <div class="sidebar-foot">
      <a href="/" target="_blank" rel="noopener">Ver sitio ↗</a>
      <form method="POST" action="/panel/salir"><button type="submit">Cerrar sesión</button></form>
    </div>
  </aside>

  <div class="sidebar-overlay" id="sidebarOverlay" hidden></div>

  <div class="admin-body">
    <header class="admin-topbar">
      <button class="sidebar-toggle" id="sidebarToggle" aria-label="Abrir menú">
        <span></span><span></span><span></span>
      </button>
      <h1 class="topbar-title"><%= tituloPagina %></h1>

      <div class="notif" id="notifWrap">
        <button class="notif-bell" id="notifBell" aria-label="Notificaciones">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 10a6 6 0 1 1 12 0c0 4 1.5 5.5 1.5 5.5H4.5S6 14 6 10Z"/><path d="M10 19a2 2 0 0 0 4 0"/></svg>
          <% if (typeof notifCount !== 'undefined' && notifCount > 0) { %>
            <span class="notif-dot"><%= notifCount %></span>
          <% } %>
        </button>
        <div class="notif-panel" id="notifPanel" hidden>
          <div class="notif-head">
            <strong>Notificaciones</strong>
            <% if (typeof notificaciones !== 'undefined' && notificaciones.length) { %>
              <form method="POST" action="/panel/notificaciones/leer-todas" class="inline-form">
                <button type="submit" class="notif-leer">Marcar todas leídas</button>
              </form>
            <% } %>
          </div>
          <div class="notif-list">
            <% if (typeof notificaciones === 'undefined' || notificaciones.length === 0) { %>
              <div class="notif-empty">No tienes notificaciones</div>
            <% } else { %>
              <% notificaciones.forEach(function (n) { %>
                <div class="notif-item <%= n.leida ? '' : 'is-unread' %>">
                  <div class="notif-item-top">
                    <strong><%= n.titulo %></strong>
                    <span class="notif-time"><%= new Date(n.createdAt).toLocaleDateString('es-BO') %></span>
                  </div>
                  <p><%= n.mensaje %></p>
                  <% if (n.conBotones) { %>
                    <div class="notif-actions">
                      <a class="btn btn-primary" href="/panel/paquetes">Comprar conversaciones</a>
                      <a class="btn btn-ghost" href="<%= site.whatsappUrl %>?text=<%= encodeURIComponent('Hola Proshop, quiero mejorar mi plan (' + empresaNombre + ')') %>" target="_blank" rel="noopener">Mejorar plan</a>
                    </div>
                  <% } %>
                  <% if (!n.leida) { %>
                    <form method="POST" action="/panel/notificaciones/<%= n.id %>/leida" class="inline-form">
                      <button type="submit" class="notif-marcar">Marcar como leída</button>
                    </form>
                  <% } %>
                </div>
              <% }); %>
            <% } %>
          </div>
        </div>
      </div>

      <span class="topbar-user">Hola, <strong><%= usuarioNombre %></strong></span>
    </header>

    <main class="admin-main">
