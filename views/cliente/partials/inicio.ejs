<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../../partials/head') %>
  <link rel="stylesheet" href="/css/admin.css" />
  <link rel="stylesheet" href="/css/panel-shell.css" />
  <link rel="stylesheet" href="/css/pulido.css" />
  <% (typeof hojas !== 'undefined' ? hojas : []).forEach(function (h) { %><link rel="stylesheet" href="<%= h %>" /><% }); %>
</head>
<body class="admin">
<div class="admin-shell">

  <aside class="sidebar" id="sidebar">
    <div class="lateral-cab">
      <a href="/panel" class="sidebar-brand">
        <img src="/img/logo-icon.png" alt="" class="brand-mark-icon" width="30" height="30" />
        <span class="sidebar-brand-text"><%= site.name %></span>
      </a>
      <button type="button" class="lateral-colapsar" id="lateralColapsar" aria-label="Ocultar el menú (solo iconos)" title="Ocultar el menú (solo iconos)">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M9 4v16"/></svg>
      </button>
    </div>

    <% var puedeVerPlan = menuUsuario.rol === 'Dueño'; %>
    <<%= puedeVerPlan ? 'a href="/panel/plan"' : 'div' %> class="marca-negocio" title="<%= empresaNombre %><%= puedeVerPlan ? ' · cambiar de plan' : '' %>">
      <strong><%= empresaNombre %></strong>
      <small><%= menuPlan.nombre %><%= menuPlan.vence ? ' · vence ' + menuPlan.vence : '' %></small>
    </<%= puedeVerPlan ? 'a' : 'div' %>>

    <nav class="sidebar-nav" id="sidebarNav" aria-label="Menu de mi negocio">
      <%
        // Cada grupo es una SECCION (Agente, Punto de venta, Panel comercial...). Se abre solo la del modulo en que estas;
        // en Inicio (o en una pantalla que no esta en el menu) se abre la primera. Tocar otra seccion la abre y cierra la anterior.
        var haySeccionActiva = menu.some(function (g) { return g.titulo && g.items.some(function (it) { return it.clave === activo; }); });
        var primeraSeccion = (menu.filter(function (g) { return g.titulo; })[0] || {}).clave;
        var linkMenu = function (it) { %>
            <a href="<%= it.href %>" title="<%= it.etiqueta %><%= it.bloqueado ? ' (no está en tu plan)' : '' %>"
               class="<%= activo === it.clave ? 'is-active' : '' %> <%= it.bloqueado ? 'is-bloqueado' : '' %>" <%- activo === it.clave ? 'aria-current="page"' : '' %>>
              <span class="si"><svg viewBox="0 0 24 24"><%- it.icono %></svg></span>
              <span class="nav-texto"><%= it.etiqueta %></span>
              <% if (it.bloqueado) { %>
                <span class="nav-candado" aria-label="No está en tu plan"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></span>
              <% } else if (it.badge) { %>
                <span class="nav-badge"><%= it.badge %></span>
              <% } %>
            </a>
        <% }; %>
      <% menu.forEach(function (grupo) { %>
        <% if (!grupo.titulo) { %>
          <div class="nav-suelto"><% grupo.items.forEach(linkMenu); %></div>
        <% } else {
             var tieneActivo = grupo.items.some(function (it) { return it.clave === activo; });
             var abierto = tieneActivo || (!haySeccionActiva && grupo.clave === primeraSeccion);
             var avisos = grupo.items.reduce(function (n, it) { return n + (it.bloqueado ? 0 : (it.badge || 0)); }, 0);
             var todoBloqueado = grupo.items.length > 0 && grupo.items.every(function (it) { return it.bloqueado; });
        %>
          <div class="nav-grupo <%= abierto ? 'is-abierto' : '' %> <%= tieneActivo ? 'tiene-activo' : '' %>" data-grupo="<%= grupo.clave %>">
            <button type="button" class="nav-grupo-cab" aria-expanded="<%= abierto ? 'true' : 'false' %>" aria-controls="nav-<%= grupo.clave %>" title="<%= grupo.titulo %>">
              <span class="si"><svg viewBox="0 0 24 24"><%- grupo.icono || '' %></svg></span>
              <span class="nav-texto"><%= grupo.titulo %></span>
              <% if (avisos) { %><span class="nav-badge nav-badge-grupo"><%= avisos %></span><% } %>
              <% if (todoBloqueado) { %><span class="nav-candado" aria-label="No está en tu plan"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></span><% } %>
              <span class="nav-flecha" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg></span>
            </button>
            <div class="nav-grupo-items" id="nav-<%= grupo.clave %>"><% grupo.items.forEach(linkMenu); %></div>
          </div>
        <% } %>
      <% }); %>
    </nav>


    <div class="usuario">
      <span class="usuario-avatar" aria-hidden="true"><%= menuUsuario.iniciales %></span>
      <div class="usuario-datos">
        <strong><%= usuarioNombre %></strong>
        <small><%= menuUsuario.rol %></small>
      </div>
      <form method="POST" action="/panel/salir" class="usuario-salir">
        <button type="submit" class="btn-icono" aria-label="Cerrar sesión" title="Cerrar sesión">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h4M16 8l4 4-4 4M20 12H9"/></svg>
        </button>
      </form>
    </div>
    <a class="sidebar-sitio" href="/" target="_blank" rel="noopener">Ver sitio ↗</a>
  </aside>

  <div class="sidebar-overlay" id="sidebarOverlay" hidden></div>

  <div class="admin-body">
    <header class="admin-topbar">
      <button class="sidebar-toggle" id="sidebarToggle" aria-label="Abrir menú">
        <span></span><span></span><span></span>
      </button>
      <h1 class="topbar-title"><%= tituloPagina %></h1>

      <button class="tour-ayuda" id="tourAyudaBtn" type="button" aria-label="Ver recorrido del panel" title="Ver recorrido del panel">?</button>

      <div class="notif" id="notifWrap">
        <button class="notif-bell" id="notifBell" aria-label="Notificaciones">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 10a6 6 0 1 1 12 0c0 4 1.5 5.5 1.5 5.5H4.5S6 14 6 10Z"/><path d="M10 19a2 2 0 0 0 4 0"/></svg>
          <% if (typeof notifCount !== 'undefined' && notifCount > 0) { %>
            <span class="notif-dot"><%= notifCount %></span>
          <% } %>
        </button>
        <div class="notif-panel" id="notifPanel" hidden>
          <div class="notif-head">
            <strong>Notificaciones</strong>
            <% if (typeof notificaciones !== 'undefined' && notificaciones.length) { %>
              <form method="POST" action="/panel/notificaciones/leer-todas" class="inline-form">
                <button type="submit" class="notif-leer">Marcar todas leídas</button>
              </form>
            <% } %>
          </div>
          <div class="notif-list">
            <% if (typeof notificaciones === 'undefined' || notificaciones.length === 0) { %>
              <div class="notif-empty">No tienes notificaciones</div>
            <% } else { %>
              <% notificaciones.forEach(function (n) { %>
                <div class="notif-item <%= n.leida ? '' : 'is-unread' %>">
                  <div class="notif-item-top">
                    <strong><%= n.titulo %></strong>
                    <span class="notif-time"><%= new Date(n.createdAt).toLocaleDateString('es-BO') %></span>
                  </div>
                  <p><%= n.mensaje %></p>
                  <% if (n.conBotones) { %>
                    <div class="notif-actions">
                      <a class="btn btn-primary" href="/panel/paquetes">Comprar conversaciones</a>
                      <a class="btn btn-ghost" href="<%= site.whatsappUrl %>?text=<%= encodeURIComponent('Hola Proshop, quiero mejorar mi plan (' + empresaNombre + ')') %>" target="_blank" rel="noopener">Mejorar plan</a>
                    </div>
                  <% } %>
                  <% if (!n.leida) { %>
                    <form method="POST" action="/panel/notificaciones/<%= n.id %>/leida" class="inline-form">
                      <button type="submit" class="notif-marcar">Marcar como leída</button>
                    </form>
                  <% } %>
                </div>
              <% }); %>
            <% } %>
          </div>
        </div>
      </div>

      <span class="topbar-user">Hola, <strong><%= usuarioNombre %></strong></span>
    </header>

    <main class="admin-main">
