<%- include('partials/inicio') %>
<%
  var esEdicion = Boolean(producto);
  // Al volver de un error de validacion, "borrador" trae lo que el usuario ya habia escrito.
  var b = producto || (typeof borrador !== 'undefined' && borrador) || {};
  var yaTieneVariantes = Boolean(producto && producto.variantes && producto.variantes.length);
  var categorias = typeof categoriasExistentes !== 'undefined' ? categoriasExistentes : [];
  var categoriaIdActual = b.categoriaId ? Number(b.categoriaId) : (b.categoria && !isNaN(Number(b.categoria)) ? Number(b.categoria) : null);
  var hayCategorias = categorias.length > 0;
  var atributosProducto = esEdicion && producto.atributos ? producto.atributos : {};
  if (!esEdicion && b.atributoClave) {
    var _k = [].concat(b.atributoClave), _v = [].concat(b.atributoValor || []);
    atributosProducto = {};
    _k.forEach(function (k, i) { if (k && _v[i]) atributosProducto[k] = _v[i]; });
  }
  var entradasAtributos = Object.entries(atributosProducto);
  if (!entradasAtributos.length) entradasAtributos = [['', '']];
  var tieneCaracteristicas = Array.isArray(b.caracteristicas) ? b.caracteristicas.length > 0 : Boolean(b.caracteristicas);
  var tieneDetalles = Boolean(b.descripcion || b.sku || tieneCaracteristicas || Object.keys(atributosProducto).length);
%>

<div class="page-head">
  <h2><%= esEdicion ? 'Editar producto' : 'Agregar producto' %></h2>
  <p>Lo justo para que tu agente lo ofrezca. Lo demás es opcional.</p>
</div>

<% if (error) { %><div class="alert-err" role="alert"><%= error %></div><% } %>
<% if (typeof mensaje !== 'undefined' && mensaje) { %><div class="alert-ok"><%= mensaje %></div><% } %>

<form id="form-producto" method="POST" action="<%= esEdicion ? '/panel/productos/' + producto.id : '/panel/productos' %>" class="pf" enctype="multipart/form-data" novalidate>

  <!-- 1. Lo básico -->
  <section class="pf-card">
    <h3 class="pf-titulo"><span class="pf-num">1</span> ¿Qué vendés?</h3>

    <div class="field">
      <label for="nombre">Nombre del producto *</label>
      <input id="nombre" name="nombre" type="text" required maxlength="120"
             value="<%= b.nombre || '' %>" placeholder="Ej: Zapatilla Runner Pro" autocomplete="off" />
    </div>

    <div class="field">
      <label for="categoriaId">¿En qué categoría va?</label>
      <% if (hayCategorias) { %>
        <select id="categoriaId" name="categoriaId">
          <option value="">Sin categoría por ahora</option>
          <% categorias.forEach(function (c) { %>
            <% if (c.hijas && c.hijas.length) { %>
              <optgroup label="<%= c.nombre %>">
                <% c.hijas.forEach(function (h) { %>
                  <option value="<%= h.id %>" <%= categoriaIdActual === h.id ? 'selected' : '' %>><%= h.nombre %></option>
                <% }); %>
              </optgroup>
            <% } else { %>
              <option value="<%= c.id %>" <%= categoriaIdActual === c.id ? 'selected' : '' %>><%= c.nombre %></option>
            <% } %>
          <% }); %>
        </select>
        <button type="button" class="pf-link" id="btn-categoria-nueva">¿No está? Crear una categoría nueva</button>
      <% } else { %>
        <p class="muted pf-ayuda">Todavía no tenés categorías (por ejemplo: Calzado, Camisetas, Accesorios). Escribí la primera y la creamos junto con el producto.</p>
      <% } %>
      <div id="categoria-nueva-wrap" <%= hayCategorias && !b.categoriaNueva ? 'hidden' : '' %>>
        <input id="categoriaNueva" name="categoriaNueva" type="text" maxlength="120"
               value="<%= b.categoriaNueva || '' %>" placeholder="Ej: Calzado" autocomplete="off" />
      </div>
      <p class="pf-ayuda pf-aviso" id="hint-atributos-categoria" role="status"></p>
    </div>

    <div class="field-row">
      <div class="field">
        <label for="precio">Precio (<%= moneda %>) *</label>
        <input id="precio" name="precio" type="number" min="0" step="0.01" required inputmode="decimal"
               value="<%= esEdicion ? Number(producto.precio).toFixed(2) : (b.precio || '') %>" placeholder="0.00" />
      </div>
      <div class="field" id="campo-stock">
        <label for="stock">¿Cuántas unidades tenés?</label>
        <input id="stock" name="stock" type="number" min="0" inputmode="numeric"
               value="<%= b.stock !== undefined && b.stock !== null ? b.stock : '0' %>" placeholder="0"
               <%= yaTieneVariantes ? 'disabled' : '' %> />
        <% if (yaTieneVariantes) { %><p class="pf-ayuda">El stock se maneja en cada variante, más abajo.</p><% } %>
      </div>
    </div>

    <div class="field">
      <label for="fotos">Fotos</label>
      <input id="fotos" name="fotos" type="file" accept="image/*" multiple />
      <p class="pf-ayuda">La primera es la que ve el cliente en el catálogo. Podés elegir varias a la vez.</p>
      <div class="pf-fotos" id="fotos-previa">
        <% if (esEdicion && producto.fotos && producto.fotos.length) { producto.fotos.forEach(function (f) { %>
          <img src="<%= f %>" alt="Foto actual" />
        <% }); } %>
      </div>
      <% if (esEdicion && producto.fotos && producto.fotos.length) { %>
        <label class="pf-check"><input type="checkbox" name="quitarFotos" value="1" /> Quitar las fotos actuales al guardar</label>
      <% } %>
      <input type="hidden" name="fotosExistentes" value='<%- esEdicion && producto.fotos ? JSON.stringify(producto.fotos) : "[]" %>' />
    </div>
  </section>

  <% if (!esEdicion) { %>
  <!-- 2. Opciones (solo al crear: al editar las variantes se administran abajo) -->
  <section class="pf-card">
    <h3 class="pf-titulo"><span class="pf-num">2</span> ¿Viene en varias opciones?</h3>
    <p class="pf-ayuda">Por ejemplo, un calzado en distintas tallas y colores. Si es un solo producto, elegí “No”.</p>
    <div class="pf-eleccion" role="radiogroup" aria-label="¿Viene en varias opciones?">
      <label class="pf-opcion">
        <input type="radio" name="variantes_modo" value="no" checked />
        <span><strong>No, es uno solo</strong><small>Sin tallas ni colores</small></span>
      </label>
      <label class="pf-opcion">
        <input type="radio" name="variantes_modo" value="si" />
        <span><strong>Sí, tiene opciones</strong><small>Tallas, colores, sabores…</small></span>
      </label>
    </div>
    <div id="bloque-variantes" hidden>
      <%- include('partials/constructor-variantes', { sugeridas: null }) %>
    </div>
  </section>
  <% } %>

  <!-- Más detalles -->
  <details class="pf-mas" id="pf-mas" <%= tieneDetalles ? 'open' : '' %>>
    <summary><span class="pf-num"><%= esEdicion ? '2' : '3' %></span> Más detalles <em>(opcional)</em></summary>
    <div class="pf-mas-cuerpo">
      <div class="field">
        <label for="descripcion">Descripción corta</label>
        <input id="descripcion" name="descripcion" type="text" maxlength="200"
               value="<%= b.descripcion || '' %>" placeholder="Ej: Liviana, para correr todos los días" />
      </div>
      <div class="field">
        <label for="sku">Código interno (SKU)</label>
        <input id="sku" name="sku" type="text" maxlength="60"
               value="<%= b.sku || '' %>" placeholder="Ej: ZAP-RUN-001" />
      </div>
      <div class="field">
        <label for="caracteristicas">Características (separadas por coma)</label>
        <input id="caracteristicas" name="caracteristicas" type="text" maxlength="300"
               value="<%= Array.isArray(b.caracteristicas) ? b.caracteristicas.join(', ') : (b.caracteristicas || '') %>" placeholder="Ej: Impermeable, Suela antideslizante" />
      </div>

      <div class="field">
        <label>Datos extra del producto</label>
        <p class="pf-ayuda">Marca, material, voltaje… lo que le sirva a tu tipo de producto.</p>
        <div id="atributos-lista">
          <% entradasAtributos.forEach(function (par) { %>
            <div class="atributo-row pf-fila">
              <input list="atributos-sugeridos" name="atributoClave[]" placeholder="Ej: Marca" maxlength="60" value="<%= par[0] %>" aria-label="Nombre del dato" />
              <input name="atributoValor[]" placeholder="Ej: Nike" maxlength="120" value="<%= par[1] %>" aria-label="Valor" />
              <button type="button" class="btn btn-ghost btn-quitar-atributo" aria-label="Quitar este dato">×</button>
            </div>
          <% }); %>
        </div>
        <datalist id="atributos-sugeridos">
          <option value="Marca"></option><option value="Material"></option><option value="Color"></option>
          <option value="Modelo"></option><option value="Voltaje"></option><option value="Capacidad"></option>
          <option value="Peso"></option><option value="Sabor"></option><option value="Potencia"></option><option value="Garantía"></option>
        </datalist>
        <button type="button" id="btn-agregar-atributo" class="btn btn-ghost">+ Agregar otro dato</button>
        <template id="tpl-atributo-row">
          <div class="atributo-row pf-fila">
            <input list="atributos-sugeridos" name="atributoClave[]" placeholder="Ej: Marca" maxlength="60" aria-label="Nombre del dato" />
            <input name="atributoValor[]" placeholder="Ej: Nike" maxlength="120" aria-label="Valor" />
            <button type="button" class="btn btn-ghost btn-quitar-atributo" aria-label="Quitar este dato">×</button>
          </div>
        </template>
      </div>

      <label class="pf-check"><input type="checkbox" name="activo" value="1" <%= esEdicion ? (producto.activo ? 'checked' : '') : 'checked' %> /> Mostrar este producto a los clientes</label>
    </div>
  </details>

  <div class="form-actions pf-acciones">
    <a class="btn btn-ghost" href="/panel/productos">Cancelar</a>
    <button class="btn btn-primary" type="submit"><%= esEdicion ? 'Guardar cambios' : 'Guardar producto' %></button>
  </div>
</form>

<% if (esEdicion) { %>
  <section class="pf-card pf-variantes">
    <h3 class="pf-titulo">Opciones de este producto</h3>
    <p class="pf-ayuda">Cada combinación (por ejemplo talla 42 en negro) tiene su propio stock y, si querés, su propio precio y fotos.</p>

    <% if (typeof errorVariante !== 'undefined' && errorVariante) { %><div class="alert-err" role="alert"><%= errorVariante %></div><% } %>
    <datalist id="atributos-variante-sugeridos">
      <option value="Talla"></option><option value="Color"></option><option value="Modelo"></option>
      <option value="Sabor"></option><option value="Presentación"></option><option value="Tamaño"></option>
    </datalist>
    <template id="tpl-atributo-variante-mini">
      <div class="atributo-row-mini">
        <input list="atributos-variante-sugeridos" name="atributoClave[]" placeholder="Talla" maxlength="60" class="mini-in mini-in-k" />
        <input name="atributoValor[]" placeholder="42" maxlength="120" class="mini-in mini-in-v" />
        <button type="button" class="btn-quitar-atributo-mini mini-x" aria-label="Quitar">×</button>
      </div>
    </template>

    <% if (producto.variantes.length) { %>
      <div class="table-wrap">
        <table class="leads-table">
          <thead><tr><th>Opciones</th><th>Fotos</th><th class="num">Precio propio</th><th class="num">Stock</th><th>Acciones</th></tr></thead>
          <tbody>
            <% producto.variantes.forEach(function (v) { %>
              <%
                var formId = 'editar-variante-' + v.id;
                var entradasVariante = Object.entries(v.atributos || {});
                if (!entradasVariante.length) entradasVariante = [['', '']];
                var tieneColorYFotos = Boolean(v.atributos && v.atributos.Color) && v.fotos && v.fotos.length;
              %>
              <tr>
                <td>
                  <div class="atributos-variante" data-form="<%= formId %>">
                    <% entradasVariante.forEach(function (par) { %>
                      <div class="atributo-row-mini">
                        <input form="<%= formId %>" list="atributos-variante-sugeridos" name="atributoClave[]" value="<%= par[0] %>" placeholder="Talla" maxlength="60" class="mini-in mini-in-k" />
                        <input form="<%= formId %>" name="atributoValor[]" value="<%= par[1] %>" placeholder="42" maxlength="120" class="mini-in mini-in-v" />
                        <button type="button" class="btn-quitar-atributo-mini mini-x" aria-label="Quitar">×</button>
                      </div>
                    <% }); %>
                    <button type="button" class="btn btn-ghost btn-chico btn-agregar-atributo-variante">+ opción</button>
                  </div>
                </td>
                <td class="vt-fotos">
                  <% if (v.fotos && v.fotos.length) { %>
                    <div class="vt-miniaturas">
                      <% v.fotos.forEach(function (f) { %>
                        <img src="<%= f %>" alt="" />
                      <% }); %>
                    </div>
                    <label class="vt-quitar"><input form="<%= formId %>" type="checkbox" name="quitarFotos" value="1" /> Quitar</label>
                  <% } %>
                  <input form="<%= formId %>" type="file" name="fotos" accept="image/*" multiple class="vt-archivo" />
                  <% if (tieneColorYFotos) { %>
                    <form method="POST" action="/panel/productos/<%= producto.id %>/variantes/<%= v.id %>/copiar-fotos" class="inline-form vt-copiar">
                      <button class="btn btn-ghost btn-chico" type="submit">Copiar a mismo color</button>
                    </form>
                  <% } %>
                </td>
                <td class="num"><input form="<%= formId %>" type="number" name="precio" min="0" step="0.01" value="<%= v.precio ? Number(v.precio).toFixed(2) : '' %>" placeholder="Igual al producto" class="mini-in mini-in-precio" /></td>
                <td class="num"><input form="<%= formId %>" type="number" name="stock" min="0" value="<%= v.stock %>" class="mini-in mini-in-stock" /></td>
                <td class="actions-cell">
                  <button form="<%= formId %>" class="btn btn-ghost btn-chico" type="submit">Guardar</button>
                  <form method="POST" action="/panel/productos/<%= producto.id %>/variantes/<%= v.id %>/eliminar" class="inline-form"
                        onsubmit="return confirm('¿Eliminar esta opción?');">
                    <button class="btn btn-ghost btn-chico" type="submit">Eliminar</button>
                  </form>
                </td>
              </tr>
              <form id="<%= formId %>" method="POST" action="/panel/productos/<%= producto.id %>/variantes/<%= v.id %>" enctype="multipart/form-data"></form>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>

    <form id="form-agregar-variantes" method="POST" action="/panel/productos/<%= producto.id %>/variantes" class="pf-agregar">
      <h4 class="pf-subtitulo"><%= producto.variantes.length ? 'Agregar más opciones' : 'Agregar tallas, colores u otras opciones' %></h4>
      <%- include('partials/constructor-variantes', { sugeridas: null }) %>
      <div class="form-actions pf-acciones">
        <button class="btn btn-primary" type="submit">Guardar estas opciones</button>
      </div>
    </form>
  </section>
<% } %>

<script>
(function () {
  // ---- Categoria nueva sin salir de la pantalla ----
  var btnCatNueva = document.getElementById('btn-categoria-nueva');
  var wrapCatNueva = document.getElementById('categoria-nueva-wrap');
  var selectCategoria = document.getElementById('categoriaId');
  var inputCatNueva = document.getElementById('categoriaNueva');
  if (btnCatNueva && wrapCatNueva) {
    btnCatNueva.addEventListener('click', function () {
      wrapCatNueva.hidden = false;
      btnCatNueva.hidden = true;
      if (selectCategoria) selectCategoria.value = '';
      inputCatNueva.focus();
    });
  }
  if (selectCategoria && inputCatNueva) {
    // Elegir un grupo existente descarta lo que se haya escrito como nuevo
    selectCategoria.addEventListener('change', function () { if (selectCategoria.value) inputCatNueva.value = ''; });
  }

  // ---- Vista previa de las fotos elegidas ----
  var inputFotos = document.getElementById('fotos');
  var previa = document.getElementById('fotos-previa');
  if (inputFotos && previa) {
    inputFotos.addEventListener('change', function () {
      previa.querySelectorAll('img[data-nueva]').forEach(function (i) { i.remove(); });
      Array.prototype.slice.call(inputFotos.files || []).forEach(function (f) {
        var img = document.createElement('img');
        img.setAttribute('data-nueva', '1');
        img.alt = 'Foto nueva';
        img.src = URL.createObjectURL(f);
        previa.appendChild(img);
      });
    });
  }

  // ---- Datos extra del producto: agregar/quitar filas ----
  var listaProducto = document.getElementById('atributos-lista');
  var tplProducto = document.getElementById('tpl-atributo-row');
  var btnAgregarProducto = document.getElementById('btn-agregar-atributo');
  if (listaProducto && tplProducto && btnAgregarProducto) {
    btnAgregarProducto.addEventListener('click', function () {
      listaProducto.appendChild(tplProducto.content.cloneNode(true));
    });
  }

  // Quitar fila / agregar opcion a una variante existente (delegado: hay una fila por variante)
  document.addEventListener('click', function (ev) {
    var btnQuitar = ev.target.closest('.btn-quitar-atributo');
    if (btnQuitar) {
      var fila = btnQuitar.closest('.atributo-row');
      if (fila) fila.remove();
      return;
    }
    var btnQuitarMini = ev.target.closest('.btn-quitar-atributo-mini');
    if (btnQuitarMini) {
      var filaMini = btnQuitarMini.closest('.atributo-row-mini');
      if (filaMini) filaMini.remove();
      return;
    }
    var btnAgregarVariante = ev.target.closest('.btn-agregar-atributo-variante');
    if (btnAgregarVariante) {
      var contenedor = btnAgregarVariante.closest('.atributos-variante');
      var tplMini = document.getElementById('tpl-atributo-variante-mini');
      if (contenedor && tplMini) {
        var formId = contenedor.getAttribute('data-form');
        var clon = tplMini.content.cloneNode(true);
        if (formId) clon.querySelectorAll('input').forEach(function (inp) { inp.setAttribute('form', formId); });
        contenedor.insertBefore(clon, btnAgregarVariante);
      }
    }
  });

  // ---- Que datos pide el grupo elegido (los valida el servidor al guardar) ----
  window.__categoriasAtributos = <%- JSON.stringify(categorias.reduce(function (acc, c) {
    var obligatorios = function (cat) {
      return cat.atributos.filter(function (a) { return a.nivel === 'OBLIGATORIO' && !a.esDeVariante; }).map(function (a) { return a.nombre; });
    };
    acc[c.id] = obligatorios(c);
    (c.hijas || []).forEach(function (h) { acc[h.id] = obligatorios(h); });
    return acc;
  }, {})) %>;
  // Nombres REALES de atributo de cada categoria, para sugerir la ortografia
  // exacta que espera el motor (bug real: "talla" en minuscula rompio un filtro).
  window.__categoriasAtributosNombres = <%- JSON.stringify(categorias.reduce(function (acc, c) {
    var separar = function (cat) {
      return {
        producto: cat.atributos.filter(function (a) { return !a.esDeVariante; }).map(function (a) { return a.nombre; }),
        variante: cat.atributos.filter(function (a) { return a.esDeVariante; }).map(function (a) { return a.nombre; }),
      };
    };
    acc[c.id] = separar(c);
    (c.hijas || []).forEach(function (h) { acc[h.id] = separar(h); });
    return acc;
  }, {})) %>;

  var hintAtributos = document.getElementById('hint-atributos-categoria');
  var detalles = document.getElementById('pf-mas');
  function actualizarHintCategoria() {
    if (!selectCategoria || !hintAtributos) return;
    var obligatorios = (window.__categoriasAtributos || {})[selectCategoria.value] || [];
    hintAtributos.textContent = obligatorios.length
      ? 'Esta categoría pide completar en “Más detalles”: ' + obligatorios.join(', ') + '.'
      : '';
    if (obligatorios.length && detalles) detalles.open = true;
  }
  var GENERICOS_PRODUCTO = ['Marca', 'Material', 'Color', 'Modelo', 'Voltaje', 'Capacidad', 'Peso', 'Sabor', 'Potencia', 'Garantía'];
  var GENERICOS_VARIANTE = ['Talla', 'Color', 'Modelo', 'Sabor', 'Presentación', 'Tamaño'];
  function actualizarDatalist(id, nombresPropios, genericos) {
    var dl = document.getElementById(id);
    if (!dl) return;
    var vistos = {};
    var opciones = [];
    (nombresPropios || []).concat(genericos).forEach(function (n) {
      var clave = n.toLowerCase();
      if (vistos[clave]) return;
      vistos[clave] = true;
      opciones.push(n);
    });
    dl.innerHTML = opciones.map(function (n) { return '<option value="' + n.replace(/"/g, '&quot;') + '"></option>'; }).join('');
  }
  function actualizarDatalistsCategoria() {
    var nombres = (window.__categoriasAtributosNombres || {})[selectCategoria && selectCategoria.value] || { producto: [], variante: [] };
    actualizarDatalist('atributos-sugeridos', nombres.producto, GENERICOS_PRODUCTO);
    actualizarDatalist('atributos-variante-sugeridos', nombres.variante, GENERICOS_VARIANTE);
  }
  if (selectCategoria) {
    selectCategoria.addEventListener('change', actualizarHintCategoria);
    selectCategoria.addEventListener('change', actualizarDatalistsCategoria);
    actualizarHintCategoria();
    actualizarDatalistsCategoria();
  }

  // ---- Alta: "¿Viene en varias opciones?" ----
  var form = document.getElementById('form-producto');
  var bloque = document.getElementById('bloque-variantes');
  var campoStock = document.getElementById('campo-stock');
  var stockInput = document.getElementById('stock');
  if (form && bloque) {
    var radios = form.querySelectorAll('input[name="variantes_modo"]');
    var constructor = bloque.querySelector('[data-vb]');
    function conOpciones() {
      var r = form.querySelector('input[name="variantes_modo"]:checked');
      return r && r.value === 'si';
    }
    function aplicarModo() {
      var si = conOpciones();
      bloque.hidden = !si;
      if (campoStock) campoStock.hidden = si;
      if (stockInput) stockInput.disabled = si;
      // Sin opciones, el campo oculto no debe viajar con restos de un intento anterior
      var json = constructor && constructor.querySelector('[data-vb-json]');
      if (json) json.disabled = !si;
    }
    Array.prototype.forEach.call(radios, function (r) { r.addEventListener('change', aplicarModo); });
    aplicarModo();

    form.addEventListener('submit', function (ev) {
      if (conOpciones() && constructor && constructor.vbCantidad && constructor.vbCantidad() === 0) {
        ev.preventDefault();
        constructor.vbMostrarError('Elegí al menos una opción (ej: Talla) y escribí sus valores, o marcá “No, es uno solo”.');
        constructor.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  }

  // ---- Edicion: agregar opciones a un producto existente ----
  var formAgregar = document.getElementById('form-agregar-variantes');
  if (formAgregar) {
    formAgregar.addEventListener('submit', function (ev) {
      var c = formAgregar.querySelector('[data-vb]');
      if (c && c.vbCantidad && c.vbCantidad() === 0) {
        ev.preventDefault();
        c.vbMostrarError('Elegí una opción (ej: Talla) y escribí sus valores para armar las combinaciones.');
      }
    });
  }
})();
</script>

