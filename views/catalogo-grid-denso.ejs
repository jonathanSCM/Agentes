<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<meta property="og:type" content="website" />
<meta property="og:title" content="<%= ogTitle %>" />
<meta property="og:description" content="<%= ogDescripcion %>" />
<% if (ogImagen) { %><meta property="og:image" content="<%= ogImagen %>" /><% } %>
<meta property="og:url" content="<%= ogUrl %>" />
<meta name="twitter:card" content="<%= ogImagen ? 'summary_large_image' : 'summary' %>" />
<link rel="icon" type="image/png" href="/img/logo-icon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{--fondo:#f4f5f7;--panel:#ffffff;--tinta:#14161c;--tenue:#6b7280;--acento:<%= (config && config.colorPrimario) || '#e11d48' %>;--acento-2:<%= (config && config.colorSecundario) || '#14161c' %>;--borde:#e5e7eb;}
  *{margin:0;padding:0;box-sizing:border-box;}
  body{background:var(--fondo);color:var(--tinta);font-family:'Inter',system-ui,sans-serif;min-height:100vh;}
  header{position:sticky;top:0;z-index:8;background:var(--acento-2);color:#fff;padding:12px 18px;}
  .header-inner{max-width:1300px;margin:0 auto;display:flex;align-items:center;gap:.6rem;}
  header img{width:26px;height:26px;border-radius:50%;object-fit:cover;}
  header strong{font-size:.95rem;letter-spacing:.02em;text-transform:uppercase;}
  header .tag{margin-left:auto;font-size:.72rem;background:var(--acento);color:#fff;padding:3px 10px;border-radius:999px;font-weight:700;}

  main{max-width:1300px;margin:0 auto;padding:16px 14px 60px;}

  .banner-filtro{background:var(--panel);border:1px solid var(--borde);border-radius:8px;padding:9px 12px;margin-bottom:12px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:.8rem;}
  .banner-filtro span{color:var(--tenue);}

  .categoria-seccion{margin-top:22px;}
  .categoria-titulo{display:flex;align-items:baseline;gap:8px;margin-bottom:8px;border-bottom:2px solid var(--acento-2);padding-bottom:5px;}
  .categoria-titulo h2{font-size:.85rem;font-weight:800;text-transform:uppercase;letter-spacing:.03em;}
  .categoria-titulo span{color:var(--tenue);font-size:.72rem;}

  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px;}
  .card{background:var(--panel);border:1px solid var(--borde);border-radius:6px;overflow:hidden;display:flex;flex-direction:column;transition:box-shadow .12s,border-color .12s;}
  .card:hover{border-color:var(--acento);box-shadow:0 4px 14px -6px rgba(0,0,0,.18);}
  .card img{width:100%;aspect-ratio:1/1;object-fit:cover;background:#eceef1;}
  .card .ph{width:100%;aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;color:var(--tenue);font-size:.72rem;background:#eceef1;}
  .card-body{padding:7px 8px 8px;display:flex;flex-direction:column;gap:2px;flex:1;}
  .card-body h3{font-size:.76rem;font-weight:600;line-height:1.25;max-height:2.5em;overflow:hidden;}
  .precio{color:var(--acento);font-weight:800;font-size:.86rem;margin-top:auto;}
  .stock{font-size:.62rem;font-weight:700;text-transform:uppercase;color:#16a34a;}
  .stock.bajo{color:#d97706;}
  .stock.agotado{color:#dc2626;}

  .vacio{min-height:40vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:var(--tenue);text-align:center;}
  .vacio h2{font-size:1.6rem;}
  .card-link{text-decoration:none;color:inherit;display:contents;}

  .cta{position:fixed;right:16px;bottom:16px;background:#25d366;color:#fff;width:50px;height:50px;border-radius:50%;display:grid;place-items:center;text-decoration:none;box-shadow:0 8px 20px -6px rgba(0,0,0,.4);z-index:9;}
</style>
</head>
<body>
  <header>
    <div class="header-inner">
      <% if (config && config.logoUrl) { %><img src="<%= config.logoUrl %>" alt="" /><% } %>
      <strong><%= empresa.marca || empresa.nombre %></strong>
      <span class="tag">Catálogo</span>
    </div>
  </header>

  <main>
    <% if (hayFiltro) { %>
      <div class="banner-filtro">
        <span>Mostrando solo: <%= [filtro.categoria, filtro.color, filtro.talla, filtro.marca].filter(Boolean).join(' · ') %></span>
      </div>
    <% } %>

    <% if (productos.length === 0) { %>
      <div class="vacio"><h2>😕</h2><p>Todavía no hay productos cargados.</p></div>
    <% } else { %>
      <div id="secciones">
        <% categorias.forEach(function (c) { %>
          <section class="categoria-seccion" data-categoria="<%= c.nombre %>">
            <div class="categoria-titulo">
              <h2><%= c.nombre %></h2>
              <span><%= c.productos.length %></span>
            </div>
            <div class="grid">
              <% c.productos.forEach(function (p) { %>
                <%
                  var marca = p.atributos && p.atributos.Marca ? p.atributos.Marca : '';
                  var textoBusqueda = [p.nombre, c.nombre, marca].join(' ').toLowerCase();
                %>
                <a class="card-link" href="/catalogo/<%= empresa.slug %>/producto/<%= p.id %><%= tokenSesion ? '?s=' + encodeURIComponent(tokenSesion) : '' %>">
                  <div class="card" data-buscar="<%= textoBusqueda %>">
                    <% if (p.fotos && p.fotos.length) { %>
                      <img src="<%= p.fotos[0] %>" alt="<%= p.nombre %>" loading="lazy" />
                    <% } else { %>
                      <div class="ph">Sin foto</div>
                    <% } %>
                    <div class="card-body">
                      <h3><%= p.nombre %></h3>
                      <span class="precio"><%= simboloCatalogo %> <%= Number(p.precio).toFixed(2) %></span>
                      <span class="stock <%= p.stockMostrado === 0 ? 'agotado' : (p.stockMostrado <= 5 ? 'bajo' : '') %>">
                        <%= p.stockMostrado === 0 ? 'Agotado' : (p.stockMostrado <= 5 ? 'Pocas u.' : 'Disponible') %>
                      </span>
                    </div>
                  </div>
                </a>
              <% }); %>
            </div>
          </section>
        <% }); %>
      </div>
    <% } %>
  </main>

  <% if (numeroWhatsapp) { %>
    <a class="cta" href="https://wa.me/<%= numeroWhatsapp %>" target="_blank" rel="noopener" aria-label="Escribir por WhatsApp">
      <svg viewBox="0 0 32 32" width="24" height="24" fill="currentColor"><path d="M16 3C9.4 3 4 8.4 4 15c0 2.1.6 4.2 1.6 6L4 29l8.2-1.6c1.8.9 3.7 1.4 5.8 1.4 6.6 0 12-5.4 12-12S22.6 3 16 3zm0 21.8c-1.8 0-3.5-.5-5-1.4l-.4-.2-4.9 1 1-4.8-.3-.4A9.7 9.7 0 0 1 6.2 15c0-5.4 4.4-9.8 9.8-9.8s9.8 4.4 9.8 9.8-4.4 9.8-9.8 9.8zm5.4-7.3c-.3-.1-1.8-.9-2-1s-.5-.1-.7.1c-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-1.8-.9-3-1.6-4.2-3.6-.3-.5.3-.5.9-1.6.1-.2 0-.4 0-.5s-.7-1.7-1-2.3c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.3 5.2 4.6 2 .8 2.7.9 3.7.8.6-.1 1.8-.7 2-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.2-.6-.4z"/></svg>
    </a>
  <% } %>
</body>
</html>
