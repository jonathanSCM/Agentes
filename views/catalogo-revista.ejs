<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<meta property="og:type" content="website" />
<meta property="og:title" content="<%= ogTitle %>" />
<meta property="og:description" content="<%= ogDescripcion %>" />
<% if (ogImagen) { %><meta property="og:image" content="<%= ogImagen %>" /><% } %>
<meta property="og:url" content="<%= ogUrl %>" />
<meta name="twitter:card" content="<%= ogImagen ? 'summary_large_image' : 'summary' %>" />
<link rel="icon" type="image/png" href="/img/logo-icon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{--fondo:#faf8f4;--panel:#ffffff;--tinta:#211f1c;--tenue:#8a8375;--acento:<%= (config && config.colorPrimario) || '#8a4b32' %>;--acento-2:<%= (config && config.colorSecundario) || '#211f1c' %>;--borde:#e8e2d6;}
  *{margin:0;padding:0;box-sizing:border-box;}
  body{background:var(--fondo);color:var(--tinta);font-family:'Inter',system-ui,sans-serif;min-height:100vh;}
  main{max-width:1040px;margin:0 auto;padding:0 24px 90px;}

  header{text-align:center;padding:54px 20px 30px;border-bottom:1px solid var(--borde);margin-bottom:8px;}
  header .brand{display:inline-flex;align-items:center;gap:.6rem;margin-bottom:18px;}
  header img{width:34px;height:34px;border-radius:50%;object-fit:cover;}
  header .brand strong{font-family:'Fraunces',serif;font-size:1.1rem;letter-spacing:.03em;text-transform:uppercase;}
  .banner-filtro{background:var(--panel);border:1px solid var(--borde);padding:12px 18px;margin:18px 0;display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:.85rem;}
  .banner-filtro span{color:var(--tenue);}

  .categoria-seccion{margin-top:56px;}
  .categoria-titulo{text-align:center;margin-bottom:26px;}
  .categoria-titulo h2{font-family:'Fraunces',serif;font-size:1.7rem;font-weight:600;}
  .categoria-titulo span{color:var(--tenue);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase;}

  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:38px 28px;}
  .card{display:flex;flex-direction:column;}
  .card img{width:100%;aspect-ratio:4/5;object-fit:cover;background:#efeae0;}
  .card .ph{width:100%;aspect-ratio:4/5;display:flex;align-items:center;justify-content:center;color:var(--tenue);font-size:.85rem;background:#efeae0;}
  .card-body{padding:16px 2px 0;display:flex;flex-direction:column;gap:5px;}
  .card-body h3{font-family:'Fraunces',serif;font-size:1.05rem;font-weight:600;line-height:1.3;}
  .marca{font-size:.76rem;color:var(--tenue);text-transform:uppercase;letter-spacing:.04em;}
  .precio{color:var(--acento);font-weight:600;font-size:1.02rem;margin-top:4px;font-family:'Fraunces',serif;}
  .stock{font-size:.72rem;color:var(--tenue);letter-spacing:.02em;}
  .stock.bajo{color:#a6631a;}
  .stock.agotado{color:#a83a3a;}

  .vacio{min-height:40vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;color:var(--tenue);text-align:center;}
  .vacio h2{font-size:1.8rem;}
  .card-link{text-decoration:none;color:inherit;display:contents;}

  .cta{position:fixed;right:20px;bottom:20px;background:#25d366;color:#fff;width:54px;height:54px;border-radius:50%;display:grid;place-items:center;text-decoration:none;box-shadow:0 10px 24px -8px rgba(0,0,0,.3);z-index:6;}
</style>
</head>
<body>
  <header>
    <div class="brand">
      <% if (config && config.logoUrl) { %><img src="<%= config.logoUrl %>" alt="" /><% } %>
      <strong><%= empresa.marca || empresa.nombre %></strong>
    </div>
  </header>

  <main>
    <%
      // Mismos parametros de sesion + filtro activo para que el detalle del
      // producto sepa a que vista tiene que volver ("Volver al catalogo").
      var paramsProducto = [];
      if (tokenSesion) paramsProducto.push('s=' + encodeURIComponent(tokenSesion));
      if (hayFiltro) {
        ['categoria', 'color', 'talla', 'marca'].forEach(function (k) {
          if (filtro[k]) paramsProducto.push(k + '=' + encodeURIComponent(filtro[k]));
        });
      }
      var qProducto = paramsProducto.length ? '?' + paramsProducto.join('&') : '';
    %>
    <% if (hayFiltro) { %>
      <div class="banner-filtro">
        <span>Mostrando solo lo que pediste: <%= [filtro.categoria, filtro.color, filtro.talla, filtro.marca].filter(Boolean).join(' · ') %></span>
      </div>
    <% } %>

    <% if (productos.length === 0) { %>
      <div class="vacio"><h2>😕</h2><p>Todavía no hay productos cargados.</p></div>
    <% } else { %>
      <div id="secciones">
        <% categorias.forEach(function (c) { %>
          <section class="categoria-seccion" data-categoria="<%= c.nombre %>">
            <div class="categoria-titulo">
              <h2><%= c.nombre %></h2>
              <span><%= c.productos.length %> pieza<%= c.productos.length === 1 ? '' : 's' %></span>
            </div>
            <div class="grid">
              <% c.productos.forEach(function (p) { %>
                <%
                  var marca = p.atributos && p.atributos.Marca ? p.atributos.Marca : '';
                  var textoBusqueda = [p.nombre, c.nombre, marca].join(' ').toLowerCase();
                %>
                <a class="card-link" href="/catalogo/<%= empresa.slug %>/producto/<%= p.id %><%= qProducto %>">
                  <div class="card" data-buscar="<%= textoBusqueda %>">
                    <% if (p.fotos && p.fotos.length) { %>
                      <img src="<%= p.fotos[0] %>" alt="<%= p.nombre %>" loading="lazy" />
                    <% } else { %>
                      <div class="ph">Sin foto</div>
                    <% } %>
                    <div class="card-body">
                      <% if (marca) { %><span class="marca"><%= marca %></span><% } %>
                      <h3><%= p.nombre %></h3>
                      <span class="precio"><%= simboloCatalogo %> <%= Number(p.precio).toFixed(2) %></span>
                      <span class="stock <%= p.stockMostrado === 0 ? 'agotado' : (p.stockMostrado <= 5 ? 'bajo' : '') %>">
                        <%= p.stockMostrado === 0 ? 'Agotado' : (p.stockMostrado <= 5 ? 'Últimas unidades' : 'Disponible') %>
                      </span>
                    </div>
                  </div>
                </a>
              <% }); %>
            </div>
          </section>
        <% }); %>
      </div>
    <% } %>
  </main>

  <% if (numeroWhatsapp) { %>
    <a class="cta" href="https://wa.me/<%= numeroWhatsapp %>" target="_blank" rel="noopener" aria-label="Escribir por WhatsApp">
      <svg viewBox="0 0 32 32" width="26" height="26" fill="currentColor"><path d="M16 3C9.4 3 4 8.4 4 15c0 2.1.6 4.2 1.6 6L4 29l8.2-1.6c1.8.9 3.7 1.4 5.8 1.4 6.6 0 12-5.4 12-12S22.6 3 16 3zm0 21.8c-1.8 0-3.5-.5-5-1.4l-.4-.2-4.9 1 1-4.8-.3-.4A9.7 9.7 0 0 1 6.2 15c0-5.4 4.4-9.8 9.8-9.8s9.8 4.4 9.8 9.8-4.4 9.8-9.8 9.8zm5.4-7.3c-.3-.1-1.8-.9-2-1s-.5-.1-.7.1c-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-1.8-.9-3-1.6-4.2-3.6-.3-.5.3-.5.9-1.6.1-.2 0-.4 0-.5s-.7-1.7-1-2.3c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.3 5.2 4.6 2 .8 2.7.9 3.7.8.6-.1 1.8-.7 2-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.2-.6-.4z"/></svg>
    </a>
  <% } %>
</body>
</html>
