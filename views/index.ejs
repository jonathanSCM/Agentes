<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/landing.css" />
</head>
<body>
  <%- include('partials/header') %>

  <main>
    <!-- ================= HERO ================= -->
    <section class="lp-hero">
      <div class="container lp-hero-grid">
        <div class="reveal">
          <span class="lp-pill"><i></i> Vende y agenda por WhatsApp con IA</span>
          <h1>Tu negocio atendido <em>las 24 horas</em>, sin perder una sola venta</h1>
          <p class="lp-lead">Un agente entrenado con tu catálogo y tus horarios responde por WhatsApp, arma pedidos, agenda citas y cobra en tu punto de venta. Tú ves todo en un solo panel.</p>
          <div class="lp-cta">
            <a class="btn btn-primary btn-lg" href="/registro">Crear mi cuenta</a>
            <a class="btn btn-ghost btn-lg" href="<%= site.whatsappUrl %>" target="_blank" rel="noopener">Pedir una demo</a>
          </div>
          <div class="lp-conf"><span>Conservas tu número</span><span>Sin contratos largos</span><span>Atiende aunque la IA falle</span></div>
        </div>

        <div class="lp-stage reveal" data-d="1">
          <div class="lp-panel">
            <div class="lp-panel-bar"><i></i><i></i><i></i><span>panel · hoy</span></div>
            <div class="lp-kpis">
              <div class="lp-kpi"><b data-count="38">0</b><span>Clientes atendidos</span></div>
              <div class="lp-kpi"><b data-count="12">0</b><span>Pedidos y citas</span></div>
              <div class="lp-kpi"><b data-count="2840" data-pref="Bs ">0</b><span>Vendido hoy</span></div>
            </div>
            <div class="lp-chat" id="lpChat" aria-label="Ejemplo de conversación con el agente">
              <div class="lp-msg in">Hola, ¿tienen zapatillas para correr talla 42?</div>
              <div class="lp-msg out">¡Hola! 👋 Sí. Tengo estas disponibles:<br>• Runner Pro — Bs 450<br>• AirLite — Bs 380</div>
              <div class="lp-msg in">La AirLite. ¿Hacen envíos?</div>
              <div class="lp-msg out">Claro. Agregué la AirLite a tu pedido. ¿Lo confirmo con envío a domicilio?</div>
              <span class="lp-typing" aria-hidden="true"><i></i><i></i><i></i></span>
            </div>
          </div>
          <div class="lp-toast lp-toast-1"><span class="ic ok"><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg></span><div><b>Pedido registrado</b><small>AirLite · Bs 380</small></div></div>
          <div class="lp-toast lp-toast-2"><span class="ic"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 11h18"/></svg></span><div><b>Cita agendada</b><small>Mañana 10:30 · Corte</small></div></div>
        </div>
      </div>

      <div class="lp-marquee" aria-hidden="true">
        <div class="lp-marquee-track">
          <% var tira = ['Agente de IA en WhatsApp', 'Catálogo digital', 'Carrito conversacional', 'Agenda de citas', 'Punto de venta', 'Recibos e impresora térmica', 'Recordatorios automáticos', 'Reportes de ventas', 'Inteligencia de negocio', 'Catálogo web con tu marca', 'Derivación a una persona', 'Funciona aunque la IA falle']; %>
          <% tira.concat(tira).forEach(function (t) { %><span><%= t %></span><% }); %>
        </div>
      </div>
    </section>

    <!-- ================= CIFRAS ================= -->
    <section class="lp-section">
      <div class="container">
        <div class="lp-nums reveal">
          <div class="lp-num"><b data-count="24" data-suf="/7">0</b><span>atención sin descanso</span></div>
          <div class="lp-num"><b>Segundos</b><span>para responder un mensaje</span></div>
          <div class="lp-num"><b data-count="1">0</b><span>panel para vender, agendar y cobrar</span></div>
          <div class="lp-num"><b data-count="0" data-pref="Bs ">0</b><span>para empezar a probar</span></div>
        </div>
      </div>
    </section>

    <!-- ================= MODULOS ================= -->
    <section id="modulos" class="lp-section alt">
      <div class="container">
        <header class="section-head reveal">
          <span class="eyebrow">Todo en uno</span>
          <h2>Lo que Proshop hace por tu negocio</h2>
          <p>Elige lo que necesitas. Cada módulo funciona solo y mejora cuando se combinan.</p>
        </header>

        <div class="lp-tabs reveal" role="tablist" aria-label="Módulos">
          <button class="lp-tab" role="tab" id="t-ventas" aria-controls="p-ventas" aria-selected="true">Ventas por WhatsApp</button>
          <button class="lp-tab" role="tab" id="t-citas" aria-controls="p-citas" aria-selected="false" tabindex="-1">Agenda de citas</button>
          <button class="lp-tab" role="tab" id="t-pos" aria-controls="p-pos" aria-selected="false" tabindex="-1">Punto de venta</button>
          <button class="lp-tab" role="tab" id="t-bi" aria-controls="p-bi" aria-selected="false" tabindex="-1">Inteligencia de negocio</button>
          <button class="lp-tab" role="tab" id="t-web" aria-controls="p-web" aria-selected="false" tabindex="-1">Catálogo web</button>
        </div>

        <div class="reveal" data-d="1">
          <!-- Ventas -->
          <div class="lp-pane on" id="p-ventas" role="tabpanel" aria-labelledby="t-ventas">
            <div>
              <h3>Un vendedor que conoce tu catálogo</h3>
              <p>El agente responde con tus productos, precios y stock reales. No inventa: lo que no sabe, lo deriva a tu equipo.</p>
              <ul class="lp-list">
                <li>Catálogo con categorías, variantes, fotos y disponibilidad</li>
                <li>Carrito dentro del chat y pedido registrado automáticamente</li>
                <li>Cobro con QR y comprobante de pago</li>
                <li>Avisos de pedido confirmado y entregado</li>
                <li>Pasa la conversación a una persona cuando hace falta</li>
              </ul>
              <a class="btn btn-primary" href="/registro">Probar el agente</a>
            </div>
            <div class="lp-shot">
              <div class="lp-shot-h">Pedidos de hoy <small>3 nuevos</small></div>
              <div class="lp-row"><div><b>Ana Rojas</b><small>AirLite 42 · envío a domicilio</small></div><span class="lp-tag">Nuevo</span></div>
              <div class="lp-row"><div><b>Luis Mamani</b><small>Runner Pro 41 · recojo en tienda</small></div><span class="lp-tag warn">Por cobrar</span></div>
              <div class="lp-row"><div><b>Carla Vega</b><small>Mochila urbana · QR pagado</small></div><span class="lp-tag ok">Pagado</span></div>
              <div class="lp-row"><div><b>Pedro Salas</b><small>AirLite 40 · entregado</small></div><span class="lp-tag ok">Entregado</span></div>
            </div>
          </div>

          <!-- Citas -->
          <div class="lp-pane" id="p-citas" role="tabpanel" aria-labelledby="t-citas">
            <div>
              <h3>Agenda que se llena sola</h3>
              <p>Para salones, consultorios, talleres y cualquier negocio con turnos. El cliente elige servicio, profesional y horario por WhatsApp o desde tu página.</p>
              <ul class="lp-list">
                <li>Servicios, profesionales y horarios por persona</li>
                <li>Sin dobles reservas: nadie se pisa con otro</li>
                <li>Recordatorios un día y dos horas antes, con botones para confirmar o cambiar</li>
                <li>Página pública de reservas con tu marca</li>
                <li>Cada profesional ve y marca su propia agenda</li>
              </ul>
              <a class="btn btn-primary" href="/registro">Armar mi agenda</a>
            </div>
            <div class="lp-shot">
              <div class="lp-shot-h">Corte de pelo · jueves 12 <small>con Marta</small></div>
              <div class="lp-slots">
                <div class="lp-slot off">09:00</div><div class="lp-slot">09:30</div><div class="lp-slot off">10:00</div><div class="lp-slot sel">10:30</div>
                <div class="lp-slot">11:00</div><div class="lp-slot">11:30</div><div class="lp-slot off">12:00</div><div class="lp-slot">15:00</div>
              </div>
              <div class="lp-row" style="margin-top:1rem"><div><b>Recordatorio enviado</b><small>"Mañana tienes turno a las 10:30"</small></div><span class="lp-tag ok">Confirmó</span></div>
              <div class="lp-row"><div><b>Nadie más puede tomar ese horario</b><small>Marta ya está ocupada de 10:30 a 11:15</small></div><span class="lp-tag">Protegido</span></div>
            </div>
          </div>

          <!-- POS -->
          <div class="lp-pane" id="p-pos" role="tabpanel" aria-labelledby="t-pos">
            <div>
              <h3>Caja y mostrador en el mismo sistema</h3>
              <p>Cobra lo que vendes en el local y lo que llega por WhatsApp, con el mismo stock y los mismos clientes.</p>
              <ul class="lp-list">
                <li>Ventas con varios métodos de pago y vuelto</li>
                <li>Apertura y cierre de caja</li>
                <li>Lector de códigos de barras e impresora térmica</li>
                <li>Recibos para el cliente y cobro de pedidos del chat</li>
                <li>Stock que se descuenta solo</li>
              </ul>
              <a class="btn btn-primary" href="/registro">Abrir mi caja</a>
            </div>
            <div class="lp-shot lp-ticket">
              <div class="lp-shot-h">Venta #0142 <small>Efectivo</small></div>
              <div class="lp-row"><span>2 × Polera básica</span><b>Bs 120</b></div>
              <div class="lp-row"><span>1 × Gorra negra</span><b>Bs 60</b></div>
              <div class="lp-row"><span>1 × AirLite 42</span><b>Bs 380</b></div>
              <div class="lp-total"><span>Total</span><span>Bs 560</span></div>
              <div class="lp-row" style="margin-top:.8rem"><span>Recibido Bs 600</span><span class="lp-tag ok">Vuelto Bs 40</span></div>
            </div>
          </div>

          <!-- BI -->
          <div class="lp-pane" id="p-bi" role="tabpanel" aria-labelledby="t-bi">
            <div>
              <h3>Entiende a tus clientes y decide con datos</h3>
              <p>Proshop te dice quién dejó de comprar, qué se vende más y qué opinan tus clientes, con lo que ya está pasando en tu negocio.</p>
              <ul class="lp-list">
                <li>Clientes en riesgo con un mensaje sugerido para recuperarlos</li>
                <li>Pide comentarios solo después de cada servicio o entrega</li>
                <li>Buscador de comentarios: encuentra qué dicen de "talla", "demora" o "precio"</li>
                <li>Ventas, ticket promedio y productos más vendidos</li>
              </ul>
              <a class="btn btn-primary" href="/registro">Ver mis datos</a>
            </div>
            <div class="lp-shot">
              <div class="lp-shot-h">Ventas de los últimos 8 meses <small>Bs</small></div>
              <div class="lp-bars" aria-hidden="true"><i style="--h:35%"></i><i style="--h:48%"></i><i style="--h:42%"></i><i style="--h:60%"></i><i style="--h:55%"></i><i style="--h:72%"></i><i style="--h:80%"></i><i style="--h:94%"></i></div>
              <div class="lp-row" style="margin-top:.9rem"><div><b>Lucía Paz</b><small>No compra hace 45 días</small></div><span class="lp-tag bad">En riesgo</span></div>
              <div class="lp-row"><div><b>"Llegó rápido y quedó perfecto"</b><small>Respuesta a tu pedido de comentario</small></div><span class="lp-tag ok">Comentario</span></div>
            </div>
          </div>

          <!-- Web -->
          <div class="lp-pane" id="p-web" role="tabpanel" aria-labelledby="t-web">
            <div>
              <h3>Tu catálogo también en la web</h3>
              <p>Un enlace con tu marca para compartir en redes, con carrito y pedido directo a tu WhatsApp.</p>
              <ul class="lp-list">
                <li>4 diseños para elegir</li>
                <li>Carrito web que se continúa en el chat</li>
                <li>Marca blanca: tu nombre y tus colores</li>
                <li>Aviso automático si el cliente deja el carrito a medias</li>
              </ul>
              <a class="btn btn-primary" href="/registro">Publicar mi catálogo</a>
            </div>
            <div class="lp-shot">
              <div class="lp-shot-h">tutienda.proshop.lat <small>Catálogo</small></div>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:.6rem">
                <% [['AirLite', 'Bs 380'], ['Runner Pro', 'Bs 450'], ['Mochila urbana', 'Bs 210'], ['Gorra negra', 'Bs 60']].forEach(function (p, i) { %>
                  <div class="lp-row" style="flex-direction:column;align-items:flex-start;margin:0"><div style="width:100%;height:70px;border-radius:6px;background:var(--chip-tint)"></div><b><%= p[0] %></b><span class="lp-tag <%= i === 1 ? 'ok' : '' %>"><%= p[1] %></span></div>
                <% }); %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= Y ADEMAS ================= -->
    <section id="beneficios" class="lp-section">
      <div class="container">
        <header class="section-head reveal">
          <span class="eyebrow">Y además</span>
          <h2>Detalles que hacen la diferencia</h2>
          <p>Pensado para negocios reales, con clientes reales y días ocupados.</p>
        </header>
        <div class="lp-grid">
          <% var feats = [
            ['Sigue atendiendo si la IA falla', 'Menús y respuestas por código: tus clientes nunca se quedan sin respuesta.', 'M4 12h4l3-8 4 16 3-8h4'],
            ['Conversaciones en vivo', 'Mira los chats, responde tú cuando quieras y vuelve a dejar al agente a cargo.', 'M4 4h16v11H8l-4 4V4Z'],
            ['Todo tu equipo, con roles', 'Dueño, administrador, cajero y profesional: cada uno ve solo lo suyo.', 'M9 8a3 3 0 1 0 0 .01M2.5 19c.6-3.4 3.2-5.5 6.5-5.5s5.9 2.1 6.5 5.5'],
            ['Notificaciones', 'Te avisamos cuando entra un pedido, se acaba el stock o un cliente pide una persona.', 'M6 10a6 6 0 1 1 12 0c0 4 1.5 5.5 1.5 5.5H4.5S6 14 6 10ZM10 19a2 2 0 0 0 4 0'],
            ['Multi-moneda', 'Precios en tu moneda y conversiones claras para cobrar sin errores.', 'M12 3v18M16 7.5c0-1.4-1.8-2.5-4-2.5s-4 1.1-4 2.5 1.8 2.5 4 2.5 4 1.1 4 2.5-1.8 2.5-4 2.5-4-1.1-4-2.5'],
            ['Marca blanca', 'Tu nombre y tu identidad en el catálogo, la reserva y los mensajes.', 'M12 3l2.6 5.4 5.9.9-4.3 4.1 1 5.9L12 16.5 6.8 19.3l1-5.9L3.5 9.3l5.9-.9L12 3Z'],
            ['Créditos y paquetes', 'Paga por lo que usas y amplía cuando crezcas. Mientras más grande el paquete, menos cuesta cada conversación.', 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18ZM12 8v8M9 12h6'],
            ['Mensajes editables', 'Cambia los textos que ve el cliente desde el panel, a tu manera de hablar.', 'M4 20h4L19 9l-4-4L4 16v4ZM13 7l4 4'],
            ['Tus datos, bajo tu control', 'Información separada por negocio y un historial de los cambios importantes.', 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3Z']
          ]; %>
          <% feats.forEach(function (f, i) { %>
            <article class="lp-feat reveal" data-d="<%= (i % 3) + 1 %>">
              <div class="ic"><svg viewBox="0 0 24 24"><path d="<%= f[2] %>"/></svg></div>
              <h3><%= f[0] %></h3>
              <p><%= f[1] %></p>
            </article>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- ================= RUBROS ================= -->
    <section class="lp-section alt">
      <div class="container">
        <header class="section-head reveal">
          <span class="eyebrow">Para quién es</span>
          <h2>Se adapta a tu tipo de negocio</h2>
          <p>Vende productos, agenda servicios o las dos cosas. El agente habla con las palabras de tu rubro.</p>
        </header>
        <div class="lp-rubros reveal">
          <% ['Tiendas de ropa y calzado', 'Salones y barberías', 'Consultorios y clínicas', 'Restaurantes y delivery', 'Ferreterías', 'Talleres mecánicos', 'Spas y centros de estética', 'Distribuidoras', 'Farmacias', 'Tiendas de tecnología', 'Estudios y gimnasios', 'Emprendedores'].forEach(function (r) { %><span class="lp-rubro"><%= r %></span><% }); %>
        </div>
      </div>
    </section>

    <!-- ================= COMO FUNCIONA ================= -->
    <section id="como-funciona" class="lp-section">
      <div class="container">
        <header class="section-head reveal">
          <span class="eyebrow">Así empezamos</span>
          <h2>Funcionando en cuatro pasos</h2>
          <p>Nos encargamos de la parte técnica para que tú te dediques a vender.</p>
        </header>
        <div class="lp-steps">
          <div class="lp-step reveal"><h3>Conectamos tu WhatsApp</h3><p>Usas tu número actual, sin cambiar cómo te escriben.</p></div>
          <div class="lp-step reveal" data-d="1"><h3>Cargamos tu negocio</h3><p>Productos, precios, servicios, horarios y profesionales.</p></div>
          <div class="lp-step reveal" data-d="2"><h3>El agente atiende</h3><p>Responde, vende, agenda y registra todo por ti.</p></div>
          <div class="lp-step reveal" data-d="3"><h3>Tú decides</h3><p>Controlas pedidos, citas y resultados desde un solo panel.</p></div>
        </div>
      </div>
    </section>

    <!-- ================= PLANES ================= -->
    <section id="planes" class="section">
      <div class="container">
        <header class="section-head reveal">
          <span class="eyebrow">Planes</span>
          <h2>Elige la solución para tu negocio</h2>
          <p>Empieza con el plan que mejor se adapta a tu empresa. Crece cuando lo necesites.</p>
        </header>

        <div class="planes-categorias reveal">
          <div class="categoria-card">
            <span class="categoria-eyebrow">Plan personal</span>
            <h3>Para emprendedores, vendedores y negocios chicos</h3>
            <p>Empezá a vender por WhatsApp con un agente de IA, sin pagar de más por funciones que todavía no necesitás.</p>
            <ul class="categoria-checklist">
              <% destacadasPersonal.forEach(function (nombre) { %>
                <li><%= nombre %></li>
              <% }); %>
            </ul>
            <span class="categoria-label">Ideal para</span>
            <div class="categoria-tags">
              <span>Emprendedores</span><span>Tiendas chicas</span><span>Freelancers</span><span>Un solo local</span>
            </div>
            <a class="btn btn-primary btn-block categoria-btn" href="/planes/personal">Ver planes personales →</a>
          </div>

          <div class="categoria-card categoria-card-empresa">
            <span class="categoria-badge">Para equipos</span>
            <span class="categoria-eyebrow">Plan empresarial</span>
            <h3>Para empresas y equipos comerciales</h3>
            <p>Business Intelligence, marca blanca y catálogos grandes para negocios que ya venden en volumen.</p>
            <ul class="categoria-checklist">
              <% destacadasEmpresarial.forEach(function (nombre) { %>
                <li><%= nombre %></li>
              <% }); %>
            </ul>
            <span class="categoria-label">Ideal para</span>
            <div class="categoria-tags">
              <span>Cadenas de tiendas</span><span>Franquicias</span><span>Equipos comerciales</span><span>Empresas B2B</span>
            </div>
            <a class="btn btn-primary btn-block categoria-btn" href="/planes/empresarial">Ver planes empresariales →</a>
          </div>
        </div>

        <!-- Calculadora: cuantas ventas necesita el agente para pagarse solo -->
        <div class="calc-roi reveal">
          <div class="calc-roi-copy">
            <h3>Calcula cuántas ventas necesita el agente para pagarse solo</h3>
            <p>Ingresa tus datos y descubre cuántas ventas adicionales necesitas al mes para cubrir el costo del plan.</p>
          </div>
          <div class="calc-roi-form">
            <div class="calc-step">
              <span class="calc-step-num">1</span>
              <div class="calc-step-body">
                <label for="calcTicket">¿Cuánto paga normalmente un cliente?</label>
                <span class="calc-step-hint">Ticket promedio</span>
                <div class="input-prefijo"><span id="calcSimboloTicket">Bs</span><input id="calcTicket" type="number" min="0" step="0.01" placeholder="Ej: 300" /></div>
              </div>
            </div>
            <div class="calc-step">
              <span class="calc-step-num">2</span>
              <div class="calc-step-body">
                <label for="calcGanancia">¿Cuánto ganás realmente por cada venta?</label>
                <span class="calc-step-hint">Ganancia o margen por venta, no el precio total</span>
                <div class="input-prefijo"><span id="calcSimboloGanancia">Bs</span><input id="calcGanancia" type="number" min="0" step="0.01" placeholder="Ej: 90" /></div>
              </div>
            </div>
            <div class="calc-step">
              <span class="calc-step-num">3</span>
              <div class="calc-step-body">
                <label for="calcPlan">¿Cuánto cuesta el plan mensual?</label>
                <span class="calc-step-hint">Elegí uno de tus planes, o escribí otro monto vos mismo</span>
                <select id="calcPlan">
                  <option value="" data-simbolo="Bs">Elegí un plan...</option>
                  <% planes.forEach(function (p) { %>
                    <option value="<%= p.precio.mensualidad %>" data-simbolo="<%= simboloMoneda(p.precio.moneda) %>"><%= p.nombre %> — <%= simboloMoneda(p.precio.moneda) %> <%= p.precio.mensualidad.toLocaleString('es-BO') %>/mes</option>
                  <% }); %>
                  <option value="manual">Otro monto...</option>
                </select>
                <div class="input-prefijo" id="calcCostoWrap" style="display:none;margin-top:.6rem">
                  <span id="calcSimboloCosto">Bs</span><input id="calcCosto" type="number" min="0" step="0.01" placeholder="Ej: 490" />
                </div>
              </div>
            </div>

            <button type="button" id="btnCalcularRoi" class="btn btn-primary btn-lg btn-block">Calcular ahora</button>
            <div id="calcRoiError" class="calc-roi-error" style="display:none"></div>

            <div id="calcRoiResultado" class="calc-roi-resultado" style="display:none">
              <span class="calc-roi-tag">Resultado</span>
              <div class="calc-roi-numero">
                <span id="calcRoiNumero">6</span>
                <span id="calcRoiUnidad">ventas adicionales / mes</span>
              </div>
              <p id="calcRoiTitulo"></p>
              <p>Pensá en todos los clientes que hoy se pierden porque nadie respondió a tiempo, el mensaje quedó olvidado o no se hizo seguimiento. ¿El agente puede ayudarte a recuperar esas ventas?</p>
              <p>Si la respuesta es sí, el plan puede pagarse solo y empezar a generar más ganancias para tu negocio.</p>
              <a class="btn btn-primary btn-block" href="#contacto">Quiero recuperar más ventas</a>
              <p class="calc-roi-nota">Este resultado es aproximado y se calcula dividiendo el costo mensual del plan entre la ganancia obtenida por cada venta.</p>
            </div>
          </div>
        </div>

        <!-- Paquetes adicionales -->
        <div class="packs reveal">
          <h3>¿Tu empresa necesita mayor capacidad?</h3>
          <p class="muted-text">Puedes ampliar tu capacidad en cualquier momento. Mientras mayor sea el paquete, menor será el costo por conversación.</p>

          <% if (paquetes.length) { %>
            <%
              var costoBase = Math.max.apply(null, paquetes.map(function (p) { return p.precio.costoUnitario; }));
              var indiceInicial = Math.floor((paquetes.length - 1) / 2);
            %>
            <div class="slider-card" id="sliderPaqueteLanding">
              <input type="range" id="rangoPaqueteLanding" class="slider-rango" min="0" max="<%= paquetes.length - 1 %>" step="1" value="<%= indiceInicial %>" />

              <div class="slider-marcas">
                <% paquetes.forEach(function (q) { %>
                  <span><%= q.cantidad.toLocaleString('es-BO') %></span>
                <% }); %>
              </div>

              <div class="slider-resultado">
                <div>
                  <div class="slider-cantidad">
                    <span id="slCantidadLanding"></span>
                    <span class="slider-cantidad-lbl">conversaciones</span>
                  </div>
                  <div class="slider-detalle">
                    <span id="slUnitarioLanding"></span>
                    <span class="badge-ahorro" id="slAhorroLanding" style="display:none"></span>
                  </div>
                </div>
                <div class="slider-compra">
                  <div class="slider-precio" id="slPrecioLanding"></div>
                  <a class="btn btn-primary" href="#contacto">Empezar ahora</a>
                </div>
              </div>
            </div>

            <script>
              (function () {
                var paquetes = <%- JSON.stringify(paquetes.map(function (p) {
                  return { cantidad: p.cantidad, precio: p.precio.precio, unitario: p.precio.costoUnitario, simbolo: simboloMoneda(p.precio.moneda) };
                })) %>;
                var costoBase = <%- costoBase %>;

                var rango = document.getElementById('rangoPaqueteLanding');
                var elCantidad = document.getElementById('slCantidadLanding');
                var elUnitario = document.getElementById('slUnitarioLanding');
                var elAhorro = document.getElementById('slAhorroLanding');
                var elPrecio = document.getElementById('slPrecioLanding');
                var fmt = function (n) { return Number(n).toLocaleString('es-BO'); };

                function pintar() {
                  var idx = Number(rango.value);
                  var p = paquetes[idx];
                  elCantidad.textContent = fmt(p.cantidad);
                  elUnitario.textContent = p.simbolo + ' ' + p.unitario.toFixed(4) + ' por conversación';
                  elPrecio.textContent = p.simbolo + ' ' + p.precio.toFixed(2);

                  var pct = paquetes.length > 1 ? (idx / (paquetes.length - 1)) * 100 : 0;
                  rango.style.setProperty('--pct', pct + '%');

                  var ahorro = costoBase > 0 ? Math.round((1 - p.unitario / costoBase) * 100) : 0;
                  if (ahorro > 0) {
                    elAhorro.style.display = '';
                    elAhorro.textContent = 'Ahorras ' + ahorro + '% por conversación';
                  } else {
                    elAhorro.style.display = 'none';
                  }
                }

                rango.addEventListener('input', pintar);
                pintar();
              })();
            </script>
          <% } %>
        </div>
      </div>
    </section>

    <script>
      (function () {
        var selectPlan = document.getElementById('calcPlan');
        var costoWrap = document.getElementById('calcCostoWrap');
        var campoCosto = document.getElementById('calcCosto');
        var simboloCosto = document.getElementById('calcSimboloCosto');
        var btnCalcular = document.getElementById('btnCalcularRoi');
        var resultado = document.getElementById('calcRoiResultado');
        var numeroResultado = document.getElementById('calcRoiNumero');
        var unidadResultado = document.getElementById('calcRoiUnidad');
        var tituloResultado = document.getElementById('calcRoiTitulo');
        var elError = document.getElementById('calcRoiError');
        if (!btnCalcular) return;

        // Elegir un plan de la lista autocompleta el costo y esconde el
        // campo manual (no hace falta tocarlo). "Otro monto..." lo muestra
        // vacio para que lo escriban ellos. Asi queda UN solo dato de costo
        // a la vista por vez, no dos campos que confunden.
        var simboloTicket = document.getElementById('calcSimboloTicket');
        var simboloGanancia = document.getElementById('calcSimboloGanancia');
        selectPlan.addEventListener('change', function () {
          var opcion = selectPlan.options[selectPlan.selectedIndex];
          var simbolo = opcion.getAttribute('data-simbolo') || 'Bs';
          simboloCosto.textContent = simbolo;
          simboloTicket.textContent = simbolo;
          simboloGanancia.textContent = simbolo;
          if (selectPlan.value === 'manual') {
            campoCosto.value = '';
            costoWrap.style.display = 'flex';
            campoCosto.focus();
          } else if (selectPlan.value) {
            campoCosto.value = Number(selectPlan.value).toFixed(2);
            costoWrap.style.display = 'none';
          } else {
            costoWrap.style.display = 'none';
          }
        });

        btnCalcular.addEventListener('click', function () {
          var ganancia = Number(document.getElementById('calcGanancia').value);
          var costoPlan = Number(campoCosto.value);
          resultado.style.display = 'none';
          elError.style.display = 'none';

          if (!ganancia || ganancia <= 0) {
            elError.textContent = 'Completá cuánto ganás por cada venta para poder calcular.';
            elError.style.display = 'block';
            return;
          }
          if (!costoPlan || costoPlan <= 0) {
            elError.textContent = 'Elegí un plan o escribí el costo mensual para poder calcular.';
            elError.style.display = 'block';
            return;
          }

          var ventasNecesarias = Math.ceil(costoPlan / ganancia);
          var ventasPorSemana = Math.max(1, Math.round(ventasNecesarias / 4.33));
          var textoSemana = ventasPorSemana === 1 ? 'una venta por semana' : ventasPorSemana + ' ventas por semana';

          numeroResultado.textContent = ventasNecesarias;
          unidadResultado.textContent = ventasNecesarias === 1 ? 'venta adicional / mes' : 'ventas adicionales / mes';
          tituloResultado.textContent = 'Con eso, el agente paga su mensualidad solo con ayudarte a recuperar ' + textoSemana + '.';
          resultado.style.display = 'block';
          resultado.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        });
      })();
    </script>


    <!-- ================= PREGUNTAS ================= -->
    <section id="preguntas" class="lp-section alt">
      <div class="container">
        <header class="section-head reveal">
          <span class="eyebrow">Preguntas frecuentes</span>
          <h2>Lo que más nos preguntan</h2>
        </header>
        <div class="lp-faq reveal">
          <details><summary>¿Tengo que cambiar mi número de WhatsApp?</summary><p>No. Conectamos el número que ya usas con WhatsApp Business y tus clientes te siguen escribiendo igual.</p></details>
          <details><summary>¿Qué pasa si la inteligencia artificial falla?</summary><p>Tus clientes siguen atendidos: el sistema responde con menús y reglas de tu negocio, sin depender de la IA.</p></details>
          <details><summary>¿El agente puede inventar precios o stock?</summary><p>No. Precios, stock, horarios y disponibilidad salen de tu información cargada, no de lo que "recuerda" la IA. Lo que no sabe, lo pasa a tu equipo.</p></details>
          <details><summary>¿Puedo vender productos y agendar citas a la vez?</summary><p>Sí. Elige el modo de tu negocio y puedes sumar el punto de venta, el catálogo web y los reportes según tu plan.</p></details>
          <details><summary>¿Cuánto cuesta empezar?</summary><p>Puedes empezar a probar sin costo. Los planes y los paquetes de conversaciones están más arriba, con una calculadora para ver cuántas ventas necesitas para pagarlos.</p></details>
          <details><summary>¿Mis clientes reciben mensajes que yo no autoricé?</summary><p>No. Los recordatorios y los pedidos de comentarios los activas tú, por negocio, y respetan horarios de descanso.</p></details>
        </div>
      </div>
    </section>

    <section class="lp-section">
      <div class="container">
        <div class="lp-final reveal">
          <h2>Tu próximo cliente puede estar escribiéndote ahora</h2>
          <p>Crea tu cuenta, carga tu negocio y deja que el agente empiece a atender.</p>
          <div class="lp-cta" style="justify-content:center;margin:0">
            <a class="btn btn-primary btn-lg" href="/registro">Crear mi cuenta</a>
            <a class="btn btn-ghost btn-lg" href="<%= site.whatsappUrl %>" target="_blank" rel="noopener">Hablar por WhatsApp</a>
          </div>
        </div>
      </div>
    </section>


    <!-- ================= CONTACTO ================= -->
    <section id="contacto" class="section section-alt">
      <div class="container contact-grid">
        <div class="contact-copy reveal">
          <span class="eyebrow">Contacto</span>
          <h2>Conversemos sobre tu empresa</h2>
          <p>Analizamos tu negocio y te mostramos cómo el agente puede adaptarse a tu empresa.</p>
          <p class="contact-promise">Primero entendemos tu negocio. Después adaptamos el agente a tu operación.</p>

          <ul class="contact-list">
            <li><span class="ci">💬</span> <a href="https://wa.me/<%= site.whatsapp %>" target="_blank" rel="noopener"><%= site.phone %></a></li>
            <li><span class="ci">✉️</span> <a href="mailto:<%= site.email %>"><%= site.email %></a></li>
            <li><span class="ci">📍</span> <%= site.location %></li>
          </ul>
        </div>

        <form class="contact-form reveal" id="contactForm" novalidate>
          <div class="field">
            <label for="nombre">Nombre *</label>
            <input id="nombre" name="nombre" type="text" required placeholder="Tu nombre" />
          </div>
          <div class="field-row">
            <div class="field">
              <label for="email">Email *</label>
              <input id="email" name="email" type="email" required placeholder="tu@correo.com" />
            </div>
            <div class="field">
              <label for="telefono">WhatsApp</label>
              <input id="telefono" name="telefono" type="tel" placeholder="+591 ..." />
            </div>
          </div>
          <div class="field">
            <label for="servicio">¿Qué necesitas mejorar?</label>
            <select id="servicio" name="servicio">
              <option value="">Selecciona una opción</option>
              <% planes.forEach(function (p) { %>
                <option>Plan <%= p.nombre %></option>
              <% }); %>
              <option>Aún no lo sé</option>
            </select>
          </div>
          <div class="field">
            <label for="mensaje">Mensaje *</label>
            <textarea id="mensaje" name="mensaje" rows="4" required placeholder="Cuéntanos cómo atiendes hoy a tus clientes y qué te gustaría mejorar."></textarea>
          </div>
          <button type="submit" class="btn btn-primary btn-lg btn-block">Obtén diagnóstico gratis</button>
          <p class="form-note" id="formNote" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
  <script src="/js/landing.js" defer></script>
</body>
</html>
