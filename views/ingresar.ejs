<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin-login">
  <main class="login-wrap">
    <form class="login-card" method="POST" action="/ingresar">
      <div class="login-brand">
        <img src="/img/logo-icon.png" alt="" class="brand-mark-icon" width="38" height="38" />
        <div>
          <strong>Ingresar</strong>
          <span>Panel de tu negocio</span>
        </div>
      </div>

      <% if (error) { %><p class="login-error"><%= error %></p><% } %>
      <% if (aviso) { %><p class="alert-ok"><%= aviso %></p><% } %>

      <div class="field">
        <label for="email">Correo</label>
        <input id="email" name="email" type="email" required autocomplete="email" autofocus />
      </div>
      <div class="field">
        <label for="password">Contraseña</label>
        <input id="password" name="password" type="password" required autocomplete="current-password" />
      </div>

      <label class="login-remember">
        <input type="checkbox" name="recordar" value="1" checked /> Recordarme en este dispositivo
      </label>

      <button type="submit" class="btn btn-primary btn-lg btn-block">Ingresar</button>
      <p class="login-back">¿No tienes cuenta? <a href="/registro" style="color:var(--primary-2)">Crear una</a></p>
      <a class="login-back" href="/">← Volver al sitio</a>
    </form>
  </main>
</body>
</html>
